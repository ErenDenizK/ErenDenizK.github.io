---
/* Every page: head (link-preview research §3), the bar, the page, the footer, one script.
   Pages are complete without JavaScript (ADR-0002); the script only enhances. */
import '../styles/global.css';
import '../../tools/icons/out/icons.css';
import '../styles/log.css';
import '../styles/transitions.css';
import '../styles/rail.css';
/* the embassy's styles are global: the sheet shows a project's article over Work and Home (ADR-0007) */
import '../../docs/family-kit/light.css';
import '../styles/embassy.css';
import '../../tools/illustrations/out/illustrations.css';
import Bar from '../components/Bar.astro';
import Icon from '../components/Icon.astro';
import interLatin from '../fonts/inter-latin.woff2?url';
import newsLatin from '../fonts/newsreader-latin.woff2?url';
import newsTr from '../fonts/newsreader-tr.woff2?url';
import { getSite, url, abs } from '../lib/site';
import { ogPath } from '../lib/files.mjs';

interface Props {
  title?: string;            // page title without the site name; omitted on Home
  description?: string;
  tab: 'home' | 'work' | 'record' | 'about' | null;
  og?: string;               // card id in tools/og/out
  ogAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  jsonld?: object[];
  pageClass?: string;
  noindex?: boolean;
  accent?: string;           // the page's light (a project's colour); otherwise the tab's token
  rail?: boolean;            // the contents ladder (ADR-0011): the page marks its sections with data-rail-sec
}
const site = await getSite();
const { title, description = site.description, tab, og = 'home', ogAlt, type = 'website', published, modified, jsonld = [], pageClass = '', noindex = false, accent, rail = false } = Astro.props;
/* The page accent (brief §7, after v0): the dot in the mark and the light in the active tab take it.
   Work starts neutral and follows the project section in view (scripts/accent.ts). */
const tabAccent = { home: 'var(--edk)', work: 'var(--accent-neutral)', record: 'var(--log)', about: 'var(--about)' } as const;
const pageAccent = accent ?? (tab ? tabAccent[tab] : 'var(--accent-neutral)');
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogFile = ogPath(og) ?? ogPath('home');
const ogImage = ogFile ? abs(ogFile) : null;
const github = site.links.github;
const linkedin = typeof site.links.linkedin === 'string' ? site.links.linkedin : null;
const person = {
  '@type': 'Person', '@id': abs('#me'), name: site.name, alternateName: site.mark, url: abs(),
  affiliation: { '@type': 'CollegeOrUniversity', name: site.kicker.school },
  sameAs: [github, linkedin].filter(Boolean),
};
const graph = [
  { '@type': 'WebSite', '@id': abs('#site'), url: abs(), name: site.name, alternateName: site.mark },
  ...(tab === 'home' || tab === 'about' ? [{ '@type': 'ProfilePage', url: canonical, isPartOf: { '@id': abs('#site') }, mainEntity: person }] : [{ ...person }]),
  ...jsonld,
];
---
<!doctype html>
<html lang="en" data-base={url()} data-rail={rail ? '' : undefined} style={`--accent: ${pageAccent}`}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#0a0a0b">
  <meta name="color-scheme" content="dark">
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={newsLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={newsTr} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href={url('favicon.ico')} sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')}>
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')}>
  <link rel="manifest" href={url('manifest.webmanifest')}>
  <link rel="alternate" type="application/atom+xml" title={`${site.log.title} · ${site.name}`} href={url('record/feed.xml')}>
  <link rel="sitemap" href={url('sitemap-index.xml')}>
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={title ?? site.name}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  {ogImage && <meta property="og:image:width" content="1200">}
  {ogImage && <meta property="og:image:height" content="630">}
  {ogImage && <meta property="og:image:alt" content={ogAlt ?? `${title ?? site.name}. ${site.name}.`}>}
  {published && <meta property="article:published_time" content={published.toISOString()}>}
  {modified && <meta property="article:modified_time" content={modified.toISOString()}>}
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  <script is:inline>
    /* Before first paint: mark JS, and name the cross-document view transition (ADR-0007).
       Types: tab order gives the slide direction; a project or entry page is "deeper". */
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      /* the contents ladder replaces the native scrollbar only where it will be drawn (ADR-0011): a page
         that has one, a fine pointer, no forced colours. Set now, so the page never shifts sideways. */
      if (d.hasAttribute('data-rail') && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(forced-colors: active)').matches) d.classList.add('rail-on');
      /* arriving through the droplet (scripts/media.ts): hide the poster from the first paint */
      try {
        var at = +sessionStorage.getItem('edk-droplet');
        if (at && Date.now() - at < 4000 && !matchMedia('(prefers-reduced-motion: reduce)').matches && !/[?&]still/.test(location.search)) d.dataset.arrive = '1';
      } catch (e) {}
      var base = d.dataset.base || '/';
      function where(path) {
        var p = String(path || '').replace(/^https?:\/\/[^/]+/, '');
        if (p.indexOf(base) === 0) p = p.slice(base.length);
        var m = p.split(/[?#]/)[0].split('/').filter(Boolean);
        var tabs = ['', 'work', 'record', 'about'];
        var t = tabs.indexOf(m[0] || '');
        return { tab: t < 0 ? -1 : t, depth: m.length > 1 ? 1 : 0 };
      }
      addEventListener('pageswap', function () { try { sessionStorage.setItem('vt-from', location.pathname); } catch (e) {} });
      /* the accent changes smoothly across pages: the last page's light is where this one's starts */
      try {
        var acc = JSON.parse(sessionStorage.getItem('edk-accent') || 'null');
        if (acc && Date.now() - acc.t < 4000 && acc.c) { d.style.setProperty('--accent-from', acc.c); d.classList.add('accent-arrive'); }
        sessionStorage.removeItem('edk-accent');
      } catch (e) {}
      function keepAccent() { try { sessionStorage.setItem('edk-accent', JSON.stringify({ c: getComputedStyle(d).getPropertyValue('--accent').trim(), t: Date.now() })); } catch (e) {} }
      addEventListener('pageswap', keepAccent);
      addEventListener('pagehide', keepAccent);
      /* While a cross-document view transition plays (up to 720 ms after the page is drawn, longer on a
         slow phone), its overlay takes every press and the browser reports the root as the target, so a
         tab or the mark clicked as the page arrives would do nothing. The press ends the transition and
         the click goes to what is under it. Same-document transitions (the sheet) are not touched:
         sheet.ts reads a press on the root there as one on the backdrop. */
      var live = null, cut = -1e9;
      addEventListener('pointerdown', function (e) {
        if (!live || e.target !== d) return;
        try { live.skipTransition(); } catch (x) {}
        live = null; cut = performance.now();
      }, true);
      addEventListener('click', function (e) {
        if (e.target !== d || !e.isTrusted || performance.now() - cut > 2000) return;
        cut = -1e9;
        var t = document.elementFromPoint(e.clientX, e.clientY);
        if (!t || t === d) return;
        e.stopImmediatePropagation(); e.preventDefault();
        t.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, composed: true, view: window, detail: e.detail, button: e.button, buttons: e.buttons,
          clientX: e.clientX, clientY: e.clientY, screenX: e.screenX, screenY: e.screenY, ctrlKey: e.ctrlKey, shiftKey: e.shiftKey, altKey: e.altKey, metaKey: e.metaKey }));
      }, true);
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var vt = live = e.viewTransition;
        vt.finished.finally(function () { if (live === vt) live = null; });
        var from = null;
        try { from = navigation.activation && navigation.activation.from && navigation.activation.from.url; } catch (x) {}
        if (!from) try { from = sessionStorage.getItem('vt-from'); } catch (x) {}
        if (!from) return;
        var a = where(from), b = where(location.pathname), t;
        if (b.depth > a.depth) t = 'deeper';
        else if (b.depth < a.depth) t = 'shallower';
        else t = b.tab >= a.tab ? 'to-right' : 'to-left';
        try { e.viewTransition.types.add(t); } catch (x) { d.dataset.vt = t; e.viewTransition.finished.finally(function () { delete d.dataset.vt; }); }
      });
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="grain" aria-hidden="true"></div>
  <div id="app">
    <Bar current={tab} github={github} mark={site.mark} />
    <main id="main" class:list={['page', pageClass]} tabindex="-1">
      <slot />
    </main>
  </div>
  <template id="tpl-close"><Icon name="close" size={20} /></template>
  <slot name="after" />
  <script>import '../scripts/site';</script>
</body>
</html>
