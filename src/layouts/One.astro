---
/* The document of the two-page site (design spec §7.3): fonts, tokens, the bar, the field, the grain,
   the rail, the page, one script. It shares nothing with layouts/Base.astro except the content and the
   rail. The page is complete without JavaScript; the script only adds motion and the interactive parts.
   Before first paint the head script sets html.js and one of html.motion (motion is welcome) or
   html.still (reduced motion or ?still), and the lab switches (spec §9) as data attributes. */
import '../one/tokens.css';
import '../one/base.css';
import '../one/field.css';
import '../styles/rail.css';
import '../one/rail.css';
import '../../tools/icons/out/icons.css';
import Bar from '../one/Bar.astro';
import Field from '../one/Field.astro';
import interLatin from '../fonts/inter-latin.woff2?url';
import newsLatin from '../fonts/newsreader-latin.woff2?url';
import newsTr from '../fonts/newsreader-tr.woff2?url';
import { TEMPOS, tempoCSS } from '../../docs/family-kit/springs.js';
import { getSite, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** where Home lives (the lab page now, "/" later) */
  home: string;
  tab: 'home' | 'record';
  noindex?: boolean;
}
const site = await getSite();
const { title, description, home, tab, noindex = false } = Astro.props;
/* the family kit's springs as CSS linear() curves, printed at build time (spec §2.7) */
const springs = tempoCSS(TEMPOS.portfolio);
---
<!doctype html>
<html lang="en" data-base={url()} style="--accent: #6f8cff">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#121214">
  <meta name="color-scheme" content="dark">
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={newsLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={newsTr} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href={url('favicon.ico')} sizes="16x16 32x32 48x48">
  <style is:inline set:html={springs}></style>
  <script is:inline>
    (function () {
      var d = document.documentElement, q = location.search;
      d.classList.add('js');
      /* the rail replaces the native scrollbar (ADR-0013): set now, so the page never shifts sideways */
      if (!matchMedia('(forced-colors: active)').matches) d.classList.add(matchMedia('(hover: hover) and (pointer: fine)').matches ? 'rail-on' : 'rail-touch');
      var still = matchMedia('(prefers-reduced-motion: reduce)').matches || /[?&]still\b/.test(q);
      d.classList.add(still ? 'still' : 'motion');
      d.classList.toggle('fine', matchMedia('(hover: hover) and (pointer: fine)').matches);
      /* lab switches (spec §9): Work's form, the postcard caption, the open tempo */
      var pick = function (k, ok, def) { var m = new RegExp('[?&]' + k + '=([a-z0-9]+)').exec(q); return m && ok.indexOf(m[1]) >= 0 ? m[1] : def; };
      d.dataset.work = pick('work', ['deck', 'drift'], 'deck');
      d.dataset.cap = pick('cap', ['line', 'large'], 'large');
      d.dataset.open = pick('open', ['900', '1400'], '900');
      d.dataset.card = pick('card', ['end', 'lanes'], 'end');
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Field />
  {/* L1 and L2: the 2.5D plates scroll with the page, above the field and under the grain */}
  <div class="plates" aria-hidden="true"><slot name="plates" /></div>
  <div class="grain" aria-hidden="true"></div>
  <Bar home={home} tab={tab} mark={site.mark} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <slot name="after" />
  <script>import '../one/scripts/shell';</script>
</body>
</html>
