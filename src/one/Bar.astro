---
/* The bar of the two-page site (design spec §3.1): the mark with a dot in the current aura's first
   pigment, the tab pill with Home and Record (the lens look), and Istanbul's time. No GitHub link: the
   links live in Contact, their one place (spec §3.5). The quiet band under the bar appears once the page
   has moved (scripts/shell.ts sets html.moved). The time is written before first paint; scripts/clock.ts
   keeps it on the minute. */
import { url } from '../lib/site';
interface Props { home: string; tab: 'home' | 'record'; mark: string }
const { home, tab, mark } = Astro.props;
const tabs = [['home', 'Home', home], ['record', 'Record', url('record/')]] as const;
---
<header class="bar" id="bar">
  <a class="mark" href={home} aria-label={`${mark}, home`}>{mark}<i class="dot" aria-hidden="true"></i></a>
  <nav class="tabs" aria-label="Primary">
    {tabs.map(([key, label, href]) => (
      <a href={href} data-tab={key} aria-current={tab === key ? 'page' : undefined}>
        {tab === key && <span class="ind" aria-hidden="true"></span>}<span class="tl-t">{label}</span>
      </a>
    ))}
  </nav>
  <p class="clock" data-clock><span class="vh">Local time in </span><span class="place">Istanbul </span><time></time></p>
  <script is:inline>(function(){try{var t=document.currentScript.previousElementSibling.querySelector('time'),s=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZone:'Europe/Istanbul'}).format(new Date());t.textContent=s;t.dateTime=s;}catch(e){}})();</script>
</header>

<style>
  .bar {
    position: fixed; z-index: var(--z-bar); top: 0; left: 0; right: 0; height: var(--bar-h);
    padding: 0 var(--gut); padding-top: env(safe-area-inset-top);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    view-transition-name: bar;
  }
  /* the quiet band: the ground fading down from the top edge, once the page has moved */
  .bar::before {
    content: ""; position: absolute; inset: 0 0 -28px; z-index: -1; pointer-events: none;
    background: linear-gradient(var(--ground) 0%, rgb(18 18 20 / 0.86) 46%, rgb(18 18 20 / 0));
    opacity: 0; transition: opacity var(--t-ui) var(--ease-ui);
  }
  :global(html.moved) .bar::before, :global(html:not(.js)) .bar::before { opacity: 1; }

  .mark {
    justify-self: start; display: inline-flex; align-items: baseline; gap: 3px; min-height: 44px; align-items: center;
    font: 500 24px / 1 var(--f-serif); letter-spacing: -0.01em; color: var(--ink);
  }
  .mark .dot {
    width: 6px; height: 6px; border-radius: 50%; align-self: flex-end; margin-bottom: 14px;
    background: var(--a1); box-shadow: 0 0 10px var(--a1);
    view-transition-name: mark-dot;
  }

  .tabs {
    display: flex; gap: 2px; padding: 4px; border-radius: var(--r-pill);
    background: rgb(30 30 34 / 0.62); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07), 0 12px 40px -16px rgb(0 0 0 / 0.7);
  }
  .tabs a {
    position: relative; isolation: isolate; min-height: 40px; padding: 0 20px; display: inline-flex; align-items: center;
    border-radius: var(--r-pill); font: 500 15px / 1 var(--f-sans); color: var(--ink-3);
    transition: color 150ms var(--ease-ui), background-color 150ms var(--ease-ui);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a:focus-visible { outline-offset: -2px; border-radius: var(--r-pill); }
  .tabs a[aria-current="page"] { color: var(--ink); }
  /* the active bed: 8 % light with the current aura glowing up from under it */
  .tabs .ind {
    position: absolute; z-index: -1; inset: 0; border-radius: inherit; overflow: hidden;
    background:
      radial-gradient(60% 120% at 50% 140%, color-mix(in oklab, var(--a1) 34%, transparent), transparent 72%),
      rgb(255 255 255 / 0.08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    view-transition-name: tab-ind;
  }

  .clock { justify-self: end; font: 500 13px / 1 var(--f-sans); letter-spacing: 0.01em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .clock time { color: var(--ink-2); }

  @media (max-width: 699.98px) {
    .tabs a { padding: 0 16px; }
    .clock .place { display: none; }
  }
  @media (max-width: 359.98px) { .tabs a { padding: 0 12px; } .mark { font-size: 21px; } }
</style>
