---
/* Path (design spec §3.4 item 3): the year as one line of five stops, the "now" stop lit in the sunset
   gold, the next one dashed. Desktop: one horizontal line across the wide column; phone: a vertical line
   on the axis, each stop's text centred under its dot. The one place for "skipped the prep year".
   Content: the timeline of the "next" chapter in content/site.json. */
import { getSite } from '../../lib/site';
const site = await getSite();
const stops = site.about.chapters.find((c) => c.id === 'next')?.timeline ?? [];
---
{stops.length > 0 && (
  <section class="strip path" id="path" data-rail-sec="Path">
    <h2 class="label strip-label" data-arrive>Path</h2>
    <ol class="line" data-arrive-group style={`--n: ${stops.length}`}>
      {stops.map((s) => (
        <li class:list={['stop', s.state]} data-arrive aria-current={s.state === 'now' ? 'step' : undefined}>
          <span class="dot" aria-hidden="true"></span>
          <span class="when label">{s.when}</span>
          <span class="what small">{s.what}</span>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .path { text-align: center; }
  .line {
    position: relative; margin: var(--s-7) auto 0; width: min(var(--w-wide), 100%);
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--s-4);
  }
  /* the line: solid through the past, lit at now, dashed into next */
  .line::before {
    content: ""; position: absolute; left: calc(50% / var(--n)); right: calc(50% / var(--n)); top: 7px; height: 1px;
    /* solid through the past and to now (the fourth of five stops), dashed from now into next */
    background: linear-gradient(90deg, var(--line-3), var(--line-3)) 0 0 / 75% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--line-3) 0 4px, transparent 4px 9px) 100% 0 / 25% 1px no-repeat;
  }
  .stop { position: relative; display: grid; justify-items: center; align-content: start; gap: var(--s-2); padding: 0 var(--s-1); }
  .dot { width: 15px; height: 15px; border-radius: 50%; background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--line-3); margin-bottom: var(--s-3); }
  .past .dot { background: var(--ink-4); box-shadow: none; }
  .now .dot { background: var(--person-1); box-shadow: 0 0 18px 2px color-mix(in srgb, var(--person-1) 70%, transparent); }
  .next .dot { background: var(--ground); box-shadow: inset 0 0 0 1px var(--ink-4); }
  .now .when { color: var(--person-1); }
  .what { color: var(--ink-2); max-width: 15em; text-wrap: balance; }
  .now .what { color: var(--ink); }

  /* phone: the stops stand one under the other on the axis; a short line joins each stop's text to the
     next dot, so the line never runs through a sentence */
  @media (max-width: 699.98px) {
    .line { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); max-width: 320px; }
    .line::before { display: none; }
    .stop { gap: var(--s-1); }
    .dot { margin-bottom: var(--s-2); }
    .stop:not(:last-child)::after {
      content: ""; position: absolute; left: 50%; top: calc(100% + 8px); height: calc(var(--s-7) - 16px); width: 1px; background: var(--line-3);
    }
    .now:not(:last-child)::after { background: repeating-linear-gradient(180deg, var(--line-3) 0 4px, transparent 4px 9px); }
  }
</style>
