---
/* Path (spec v2 §3.5.4): the year as one line of five stops, continuing How I work's drawing. A line
   falls out of the chapter above into the first stop, then runs through the year: solid through the
   past, lit at now, dashed into next. It draws with the scroll (a pure function of the scene's --sp,
   scene.css), and each stop's words rise as the line reaches its dot. Behind it, "the machine": the
   processor floor plan of the line-art set at 8 %, at 0.85x (Who I am: "whatever sits closest to the
   machine"). Desktop: the line runs across the wide column; phone: it stands on the left, like the
   lanes above it. The one place for "skipped the prep year". Content: the "next" chapter's timeline. */
import { getSite } from '../../lib/site';
import machine from './art/circuit.svg?url';
const site = await getSite();
const stops = site.about.chapters.find((c) => c.id === 'next')?.timeline ?? [];
const nowAt = Math.max(0, stops.findIndex((s) => s.state === 'now'));
---
{stops.length > 0 && (
  <section class="path" id="path" data-rail-sec="Path" data-scene style={`--n: ${stops.length}; --now: ${nowAt}`}>
    <img class="machine" src={machine} alt="" width="1600" height="600" loading="lazy" decoding="async" />
    <div class="path-in">
      <h2 class="path-t" data-lines style="--a: 0.12; --w: 0.14">Path</h2>
      <ol class="line">
        {stops.map((s, i) => (
          <li class:list={['stop', s.state]} style={`--i: ${i}`} aria-current={s.state === 'now' ? 'step' : undefined}>
            <span class="dot" aria-hidden="true"></span>
            <span class="when">{s.when}</span>
            <span class="what">{s.what}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .path { position: relative; padding: 0 var(--gut); }
  .machine {
    position: absolute; left: 50%; top: 50%; width: 1600px; max-width: none; height: auto; margin: -300px 0 0 -800px;
    opacity: 0.06; pointer-events: none;
    -webkit-mask: radial-gradient(50% 50% at 50% 50%, #000 40%, transparent 100%); mask: radial-gradient(50% 50% at 50% 50%, #000 40%, transparent 100%);
  }
  :global(html.motion) .machine { transform: translateY(calc((var(--sp) - 0.5) * 18vh)); }
  .path-in { position: relative; width: min(var(--w-wide), 100%); margin: 0 auto; }
  .path-t { font: 400 var(--fs-h3) / 1.2 var(--f-serif); color: var(--ink); padding-left: calc(50% / var(--n) + 24px); }

  /* the line's window in --sp: it falls into the first stop over [0.16, 0.24], runs to the last over
     [0.24, 0.46]; stop i lights as the run reaches it */
  .line { --x0: calc(50% / var(--n)); position: relative; margin-top: var(--s-6); display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--s-4); }
  .line::before, .line::after { content: ""; position: absolute; pointer-events: none; }
  /* the fall: from out of the chapter above into the first dot */
  .line::before { left: calc(var(--x0) - 0.5px); width: 1px; top: -132px; height: 132px; transform-origin: 50% 0;
    background: linear-gradient(transparent, var(--line-3) 40%, var(--line-3)); }
  /* the run: solid to now, dashed into next */
  .line::after { left: var(--x0); right: var(--x0); top: 7px; height: 1px; transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--line-3), color-mix(in srgb, var(--gold-ink) 60%, transparent)) 0 0 / calc(100% * var(--now) / (var(--n) - 1)) 1px no-repeat,
      repeating-linear-gradient(90deg, var(--line-3) 0 4px, transparent 4px 9px) 100% 0 / calc(100% * (var(--n) - 1 - var(--now)) / (var(--n) - 1)) 1px no-repeat; }
  :global(html.motion) .line::before { transform: scaleY(clamp(0, (var(--sp) - 0.16) / 0.08, 1)); }
  :global(html.motion) .line::after { transform: scaleX(clamp(0, (var(--sp) - 0.24) / 0.22, 1)); }
  .stop { position: relative; display: grid; justify-items: center; align-content: start; gap: var(--s-2); padding: 0 var(--s-1); text-align: center; }
  :global(html.motion) .stop { --k: clamp(0, (var(--sp) - 0.22 - var(--i) * 0.055) / 0.06, 1); }
  .dot { width: 15px; height: 15px; border-radius: 50%; background: var(--ground); box-shadow: inset 0 0 0 1px var(--line-3); margin-bottom: var(--s-3); }
  .past .dot { background: var(--ink-4); box-shadow: none; }
  .now .dot { background: var(--gold-ink); box-shadow: 0 0 18px 2px color-mix(in srgb, var(--gold-ink) 70%, transparent); }
  .next .dot { box-shadow: inset 0 0 0 1px var(--ink-4); }
  :global(html.motion) .dot { transform: scale(calc(0.3 + 0.7 * var(--k))); opacity: var(--k); }
  .when { font: 400 var(--fs-label) / 1.3 var(--f-sans); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .now .when { color: var(--gold-ink); }
  .what { font: 400 var(--fs-body) / 1.4 var(--f-serif); color: var(--ink-2); max-width: 15em; text-wrap: balance; }
  .now .what { color: var(--ink); }
  .next .what { font-style: italic; }
  :global(html.motion) :is(.when, .what) { opacity: calc(0.15 + 0.85 * var(--k)); transform: translateY(calc((1 - var(--k)) * 12px)); }

  /* phone: the line stands on the left, as the lanes do above it; each stop's words beside its dot */
  @media (max-width: 699.98px) {
    .machine { display: none; }
    .path-t { padding-left: 26px; }
    .line { --x0: 7.5px; grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .line::before { top: -72px; height: 72px; left: 7px; }
    .line::after { left: 7px; right: auto; top: 8px; bottom: 8px; width: 1px; height: auto; transform-origin: 50% 0;
      background: linear-gradient(var(--line-3), var(--line-3) 75%, color-mix(in srgb, var(--gold-ink) 60%, transparent)); }
    :global(html.motion) .line::after { transform: scaleY(clamp(0, (var(--sp) - 0.18) / 0.4, 1)); }
    .stop { justify-items: start; text-align: left; padding: 0 0 0 30px; gap: var(--s-1); }
    .dot { position: absolute; left: 0; top: 2px; margin: 0; }
    :global(html.motion) .stop { --k: clamp(0, (var(--sp) - 0.16 - var(--i) * 0.07) / 0.08, 1); }
  }
</style>
