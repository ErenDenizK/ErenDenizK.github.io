---
/* How I work (design spec §3.4 item 2): the two tracks, the one place for what each teaches and for the
   quote. Desktop: two lane cards mirrored about the axis, a thin line between them that meets at "Both
   matter."; phone: the lanes stacked, joined by one vertical line on the axis. Content: the "work"
   chapter of content/site.json. */
import { getSite } from '../../lib/site';
const site = await getSite();
const ch = site.about.chapters.find((c) => c.id === 'work');
const tr = ch?.tracks;
---
{ch && tr && (
  <section class="strip tracks" id="how" data-rail-sec={ch.title}>
    <h2 class="label strip-label" data-arrive>{ch.title}</h2>
    {ch.text[0] && <p class="lead lede" data-arrive>{ch.text[0]}</p>}
    <div class="lanes" data-arrive-group>
      {tr.lanes.map((l, i) => (
        <div class:list={['lane', i ? 'r' : 'l']} data-arrive="img">
          <h3 class="h4 lane-t">{l.label}</h3>
          <ul class="items">{l.items.map((it) => <li>{it}</li>)}</ul>
          <p class="teach"><span class="label">{tr.teaches}</span><span class="gives">{l.gives}</span></p>
        </div>
      ))}
      <div class="join" aria-hidden="true"><span class="ln"></span></div>
      <p class="meet h4" data-arrive>{tr.meet}</p>
    </div>
    {ch.quote && <blockquote class="quote h3 it" data-arrive><p>{ch.quote}</p></blockquote>}
  </section>
)}

<style>
  .tracks { text-align: center; }
  .lead { max-width: 30em; margin: var(--s-4) auto 0; }
  .lanes {
    position: relative; margin: var(--s-7) auto 0; width: min(var(--w-wide), 100%);
    display: grid; grid-template-columns: 400px 400px; justify-content: center; column-gap: 120px; row-gap: var(--s-6);
  }
  .lane {
    position: relative; padding: var(--s-6); border-radius: var(--r-card); text-align: left;
    background: var(--fill-1); box-shadow: var(--e-card);
  }
  .lane.r { text-align: right; }
  .lane-t { color: var(--ink); }
  .lane.l .lane-t { color: color-mix(in srgb, var(--person-1) 70%, var(--ink)); }
  .items { margin-top: var(--s-4); display: grid; gap: var(--s-2); font: 400 var(--fs-body) / 1.5 var(--f-sans); color: var(--ink-2); }
  .teach { margin-top: var(--s-5); padding-top: var(--s-4); box-shadow: inset 0 1px 0 var(--line-1); display: grid; gap: var(--s-1); }
  .gives { font: 500 var(--fs-body) / 1.4 var(--f-sans); color: var(--ink); }
  /* the join: a hairline across the gap at the lanes' middle, and from its centre down to the meeting
     line (an absolutely placed grid item: its box is the lanes' row) */
  .join { position: absolute; grid-row: 1; grid-column: 1 / -1; inset: 0; pointer-events: none; }
  .join .ln { position: absolute; left: calc(50% - 60px); width: 120px; top: 50%; bottom: calc(-1 * var(--s-6)); }
  .join .ln::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--line-3); }
  .join .ln::after { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: linear-gradient(var(--line-3), color-mix(in srgb, var(--person-1) 60%, transparent)); }
  .meet { grid-column: 1 / -1; margin-top: var(--s-6); color: color-mix(in srgb, var(--person-1) 55%, var(--ink)); }
  .quote { max-width: 24em; margin: var(--s-8) auto 0; color: var(--ink); }

  @media (max-width: 999.98px) {
    .lanes { grid-template-columns: minmax(0, 400px); column-gap: 0; row-gap: var(--s-7); }
    .lane, .lane.r { text-align: center; }
    .lane.r { grid-row: 2; }
    .join { grid-row: 1 / span 2; z-index: -1; }
    .join .ln { left: 50%; width: 1px; top: 0; bottom: 0; }
    .join .ln::before { display: none; }
    .join .ln::after { left: 0; background: linear-gradient(var(--line-3) 0, var(--line-3) 85%, color-mix(in srgb, var(--person-1) 60%, transparent)); }
    .lane { background: color-mix(in srgb, var(--paper-2) 92%, transparent); }
    .meet { margin-top: 0; }
  }
</style>
