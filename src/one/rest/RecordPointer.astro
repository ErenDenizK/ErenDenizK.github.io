---
/* Record (design spec §3.4 item 6): the three newest entries as centred rows, each a link to its page,
   then the way to the whole Record. The field turns Record blue under this strip. Hidden while the
   Record is empty. A note has no title (log.md §3.1): its row shows its first sentence. Sample entries
   are tagged, as the Record tags them. */
import { getLog, entryPath, iso, dayMon, kindLabel, url } from '../../lib/site';
import { SETS, auraAttr, auraVars } from '../aura.mjs';
const log = (await getLog()).slice(0, 3);
const plain = (md = '') => md.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`#>]/g, '').replace(/\s+/g, ' ').trim();
const firstSentence = (md = '') => { const t = plain(md); const m = /^(.{20,}?[.!?])(\s|$)/.exec(t); return m ? m[1] : t; };
---
{log.length > 0 && (
  <section class="strip rec" id="record" data-rail-sec="Record" data-rail-accent={SETS.record[0]} data-aura={auraAttr(SETS.record)} style={auraVars(SETS.record)}>
    <h2 class="label strip-label" data-arrive>Record</h2>
    <ul class="rows" data-arrive-group>
      {log.map((e) => (
        <li data-arrive>
          <a class="row" href={url(entryPath(e))}>
            <span class="meta label"><time datetime={iso(e.data.date)}>{dayMon(e.data.date)}</time> · {kindLabel[e.data.kind]}{e.data.sample && ' · Sample'}</span>
            <span class="t">{e.data.title ?? firstSentence(e.body)}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn all" href={url('record/')} data-arrive>All entries</a>
  </section>
)}

<style>
  .rec { text-align: center; }
  .rows { margin: var(--s-6) auto 0; width: min(var(--w-text), 100%); display: grid; }
  .row {
    display: grid; gap: var(--s-1); justify-items: center; padding: var(--s-4) var(--s-4); border-radius: var(--r-card);
    transition: background-color 150ms var(--ease-ui);
  }
  .row:hover { background: var(--fill-1); }
  .t { font: 500 var(--fs-body) / 1.45 var(--f-sans); color: var(--ink); text-wrap: balance; max-width: 34em; }
  .row:hover .t { text-decoration: underline; text-decoration-color: var(--ink-4); text-underline-offset: 0.22em; }
  .all { margin-top: var(--s-5); }
</style>
