      linear-gradient(170deg, color-mix(in srgb, var(--deep) 55%, #1b1915), color-mix(in srgb, var(--deep) 40%, #0f0e0c) 80%); }
  .pc-big .big-back > :not(.idc-turn, .idc-glare) { position: absolute; }
  /* laid paper: chain lines every 6u and fine laid lines every 3 px, under the grain */
