    .pc-big .bk-col { grid-template-columns: auto auto minmax(0, 1fr); gap: calc(6 * var(--u)); }
    .pc-big .one-place .bk-col { grid-template-columns: auto minmax(0, 1fr); }
    .pc-big .bk-col dt { font-size: 9px; letter-spacing: 0.12em; }
    .pc-big .bk-col dd { font-size: 13px; margin-top: 5px; }
    .pc-big .bk-col .hex { font-size: 9px; letter-spacing: 0.01em; }
