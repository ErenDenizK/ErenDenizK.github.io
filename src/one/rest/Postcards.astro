  .pc-big .bk-col dd { margin-top: calc(1.2 * var(--u)); font: 400 max(14px, calc(3.3 * var(--u))) / 1.15 var(--f-serif); color: var(--ink); }
  .pc-big .bk-col .bar { display: flex; height: calc(1.4 * var(--u)); margin-top: calc(0.6 * var(--u)); border-radius: 1px; overflow: hidden; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06); }
  .pc-big .bk-col .bar i { flex: var(--s) 0 0; background: var(--c); }
