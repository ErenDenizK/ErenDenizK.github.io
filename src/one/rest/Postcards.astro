---
/* Chapter II, Photos (spec v2 §3.6; review rows P2 to P5). The postcard is designed again from its parts
   (spec v2 §3.6.1), as an artwork card about one photograph and not a post-office form:
   - Front: the photograph at its own aspect, never cropped, with a light keyline, in a mount made of the
     photograph's own light (a blurred copy of itself at 38 % brightness, plus grain), a foil hairline
     (the ID card's foil), one edge line (the place in italic serif, the index in tabular figures), the
     ID card's guilloché low left, and gold crop marks that show only while the card is held.
   - Back (spec v3 §2; review rows T2, P4): an artwork about one photograph. The photograph's own scene
     as an engraved line drawing is the hero (src/one/rest/art/pc-<photo>.svg, tools/illustrations/
     postcards/); the photograph itself is set into the drawing as the stamp, on a cream mount with a
     dashed keyline, and one small ring with the place overlaps it. Then the note in italic serif, the
     "Eren" signature with one ink flourish, and one colophon row (Place, City, its colours as one
     proportional bar and three hex values). Each back takes its ground from the photograph's darkest
     colour and its ink from its tone, on laid paper under the grain. Landscape: the drawing fills the
     left half, the right column holds the stamp, the message, five colour bands and the colophon.
     Every value comes from content/site.json (home.postcards) or tools/photos/live.mjs.
     Motion (§2.5): as the back comes face-on the drawing draws itself on (construction, then lines,
     then hatching), the stamp lands, the ring settles, the flourish draws last; a later turn replays
     only the flourish. Reduced motion: drawn at once.
   Table (desktop): three cards side by side on parallel planes; hover picks one up without passing
   through another (scripts/postcards.ts). Phone: a loose pile, tap to open. A click or a tap grows the
   card into the large view, where the ID card's engine (card3d.ts, tilt) swings it by a drag and turns
   it over. Leaving it (spec v3 §4, row T15): two glass capsules under the card, [Close esc] and
   [Turn it over] (on phones fixed at the bottom, close at the left gutter, turn at the right); a close
   cursor over the dark space; the page shows behind a light blur; a swipe down on touch fills a ring
   round the cross and closes past 96 px. Still twins: without JavaScript the fronts stand with their
   place and note under them. */
import Icon from '../../components/Icon.astro';
import { getSite, url } from '../../lib/site';
import manifest from '../../assets/photos/postcards.json';
import meta from '../../assets/photos/postcards-meta.json';
import grain from '../../assets/photos/grain.png?url';
import city from './art/istanbul.svg?url';

const site = await getSite();
const t = site.about.postcard;
const list = site.home.postcards ?? [];
const photos = site.about.chapters.find((c) => c.id === 'photos');
const lede = photos?.text[0]?.split(/(?<=\.)\s/)[0] ?? '';
const files = import.meta.glob<string>('../../assets/photos/pc-*.{avif,webp}', { eager: true, query: '?url', import: 'default' });
/* the backs' drawings, inlined so the back can draw them on and colour them with its own ink */
/* the drawings are fetched when the large view first opens (postcards.ts), not inlined: inline, the three
   came to about 15 KB of the page's first-paint budget for a face that is seen only after a turn */
const drawings = import.meta.glob<string>('./art/pc-*.svg', { eager: true, query: '?url', import: 'default' });
const file = (stem: string, w: number | 'full', ext: 'avif' | 'webp') => {
  const f = files[`../../assets/photos/pc-${stem}-${w}.${ext}`];
  if (!f) throw new Error(`missing pc-${stem}-${w}.${ext}: run npm run photos`);
  return f;
};
type M = { width: number; height: number; widths: number[]; full: number; tone: string };
type Meta = { palette: { hex: string; share: number }[]; deep: string; crop: string; drawing?: string };
const REST = [-5, 2, -2, 3];
const n = list.length;
const pad = (i: number) => String(i).padStart(2, '0');
const guil = url('lab/one/guil/pc.svg');

/** relative luminance of a hex colour, for the ink on a colour band */
const lum = (h: string) => { const v = [1, 3, 5].map((k) => parseInt(h.slice(k, k + 2), 16) / 255).map((c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)); return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]; };

/** the signature's flourish: one hand stroke under "Eren" (viewBox 200 x 44) */
const FLOURISH = 'M4 26C24 34 52 30 70 20C84 12 70 6 62 14C54 24 90 34 130 24C160 16 182 12 198 16';

const cards = list.map((p, i) => {
  const m = (manifest as Record<string, M>)[p.photo];
  const mm = (meta as Record<string, Meta>)[p.photo];
  if (!m || !mm) throw new Error(`no files or measurements for ${p.photo}: run npm run photos`);
  const set = (ext: 'avif' | 'webp') => m.widths.map((w) => `${file(p.photo, w, ext)} ${w}w`).join(', ');
  const big = (ext: 'avif' | 'webp') => [...m.widths.map((w) => `${file(p.photo, w, ext)} ${w}w`), ...(m.full ? [`${file(p.photo, 'full', ext)} ${m.full}w`] : [])].join(', ');
  const land = m.width > m.height;
  const parts = p.place.split(',').map((s) => s.trim()).filter(Boolean);
  /* the colophon: a missing field is hidden, never filled (content rule) */
  const rules = parts.length > 1 ? [['Place', parts.slice(0, -1).join(', ')], ['City', parts[parts.length - 1]]] : [['City', parts[0]]];
  if (p.date) rules.push(['Date', p.date]);
  const ringUnit = `${p.place.toUpperCase()} · `;
  const ring = ringUnit.repeat(Math.max(1, Math.ceil(22 / ringUnit.length)));
  const svg = mm.drawing ? drawings[`./art/pc-${mm.drawing}.svg`] : undefined;
  return {
    ...p, i, land, w: m.width, h: m.height, rest: REST[i % REST.length], tone: m.tone,
    avif: set('avif'), webp: set('webp'), src: file(p.photo, m.widths[0], 'webp'), small: file(p.photo, m.widths[0], 'webp'),
    /* the large card's shape: the photograph whole inside a 3.2 % mount with a 10 % caption band */
    bratio: 1 / ((0.936 * m.height) / m.width + 0.132),
    bigAvif: big('avif'), bigWebp: big('webp'), idx: `${pad(i + 1)} / ${pad(n)}`,
    palette: mm.palette.map((q) => ({ ...q, light: lum(q.hex) > 0.45 })), rules, ring, micro: `${site.mark} · ${t.credit} · ${p.place}`.toUpperCase(),
    deep: mm.deep, crop: mm.crop, svg, no: pad(i + 1), of: pad(n),
    name: `${t.of} ${p.place}`,
  };
});
---
{cards.length > 0 && (
  <section class="photos" id="photos" data-rail-sec="Photos" data-scene style={`--grain: url("${grain}")`}>
    <img class="city" src={city} alt="" width="1600" height="600" loading="lazy" decoding="async" />
    <h2 class="photos-t h2" data-lines style="--a: 0.06; --w: 0.12">{photos?.title ?? 'Photos'}</h2>
    {lede && <p class="photos-lede" data-rise style="--a: 0.09; --w: 0.12">{lede}</p>}
    <ul class="table" data-pc-table>
      {cards.map((c) => (
        <li class:list={['pc', c.land ? 'land' : 'port']} data-postcard={c.i} style={`--rest: ${c.rest}deg; --ratio: ${c.w} / ${c.h}; --img: url("${c.small}"); --tone: ${c.tone}`}>
          <span class="pc-shadow" aria-hidden="true"></span>
          <button class="pc-open" type="button" aria-label={c.name} aria-haspopup="dialog">
            <span class="pc-card">
              <span class="pc-mount">
                <span class="pc-blur" aria-hidden="true"></span>
                <img class="pc-guil" src={guil} alt="" width="220" height="220" loading="lazy" decoding="async" />
                <picture class="pc-pic">
                  <source type="image/avif" srcset={c.avif} sizes={c.land ? '(min-width: 700px) 412px, 300px' : '(min-width: 700px) 324px, 196px'} />
                  <img src={c.src} srcset={c.webp} sizes={c.land ? '(min-width: 700px) 412px, 300px' : '(min-width: 700px) 324px, 196px'} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" draggable="false" />
                </picture>
                <span class="pc-edge" aria-hidden="true"><i>{c.place}</i><b>{c.idx}</b></span>
              </span>
              <span class="pc-proof" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            </span>
          </button>
          <p class="pc-cap"><span class="place">{c.place}</span>{c.note && <span class="note">{c.note}</span>}</p>
          <template data-big>
            <div class:list={['big', c.land ? 'land' : 'port']} data-card="tilt" style={`--ratio: ${c.bratio.toFixed(4)}; --img: url("${c.small}"); --tone: ${c.tone}; --grain: url("${grain}")`} data-big-card>
              <div class="idc-card" data-card-body>
                <div class="big-face big-front" data-face>
                  <button class="idc-turn" type="button" data-turn aria-label={t.turn}></button>
                  <span class="pc-blur" aria-hidden="true"></span>
                  <picture class="big-pic">
                    <source type="image/avif" srcset={c.bigAvif} sizes={c.land ? 'min(92vw, 920px)' : 'min(60vw, 520px)'} />
                    <img src={c.src} srcset={c.bigWebp} sizes={c.land ? 'min(92vw, 920px)' : 'min(60vw, 520px)'} alt={c.alt} width={c.w} height={c.h} decoding="async" draggable="false" />
                    <span class="big-dev" aria-hidden="true"></span>
                  </picture>
                  <span class="pc-edge"><i>{c.place}</i><b>{c.idx}</b></span>
                  <span class="idc-glare" aria-hidden="true"></span>
                </div>
                <div class:list={['big-face', 'big-back', !c.note && 'no-note', !c.svg && 'no-drawing', c.rules.length < 2 && 'one-place']} data-face style={`--deep: ${c.deep}; --crop: ${c.crop}`}>
                  <button class="idc-turn" type="button" data-turn aria-label={t.back}></button>
                  <span class="bk-paper" aria-hidden="true"></span>
                  <p class="bk-head" aria-hidden="true"><span class="mk">{site.mark}</span><span class="no">{t.credit} <b>{c.no}</b> / {c.of}</span></p>
                  {c.svg && <div class="bk-plate" aria-hidden="true" data-plate={c.svg} />}
                  <span class="bk-stamp" aria-hidden="true"><i></i></span>
                  <svg class="bk-ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                    <defs><path id={`pc-ring-${c.i}`} d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0" /></defs>
                    <circle cx="60" cy="60" r="56" /><circle class="in" cx="60" cy="60" r="31" />
                    <text class="rg"><textPath href={`#pc-ring-${c.i}`} textLength="268" lengthAdjust="spacing">{c.ring}</textPath></text>
                    <text class="mk" x="60" y="67" text-anchor="middle">{site.mark}</text>
                  </svg>
                  <div class="bk-msg">
                    {c.note && <p class="bk-note">{c.note}</p>}
                    <p class="bk-sig">{site.firstName}<svg viewBox="0 0 200 44" aria-hidden="true" focusable="false"><path pathLength="1" d={FLOURISH} /></svg></p>
                  </div>
                  {c.land && <span class="bk-study" aria-hidden="true" style={`--cols: ${c.palette.map((p) => `${Math.max(0.04, p.share).toFixed(3)}fr`).join(' ')}`}>{c.palette.map((p) => <i style={`--c: ${p.hex}`}></i>)}</span>}
                  <dl class="bk-col">
                    {c.rules.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
                    <div class="pal"><dt>Its colours</dt><dd><span class="bar" role="img" aria-label={c.palette.map((p) => p.hex).join(', ')}>{c.palette.map((p) => <i style={`--c: ${p.hex}; --s: ${p.share}`}></i>)}</span><span class="hex" aria-hidden="true">{c.palette.slice(0, 3).map((p) => p.hex.toUpperCase()).join(' · ')}</span></dd></div>
                  </dl>
                  <span class="bk-micro" aria-hidden="true">{`${c.micro} · ${c.micro} · ${c.micro}`}</span>
                  <span class="idc-glare" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </template>
        </li>
      ))}
    </ul>
    <p class="photos-hint"><span class="h-fine">{(t.table ?? t.hint).fine}</span><span class="h-touch">{(t.table ?? t.hint).touch}</span></p>
    <dialog class="pc-big" data-pc-dialog aria-label={t.head}>
      <div class="big-stage" data-big-stage></div>
      {/* the ways out (spec v3 §4.2): the labelled close, folded after its first use, and the turn */}
      <div class="pv-caps" data-pv-caps>
        <div class="pv-glass">
          <button class="pv-x" type="button" data-pv-close aria-label="Close">
            <span class="pv-xi">
              <svg class="pv-ring" viewBox="0 0 44 44" aria-hidden="true" focusable="false"><circle cx="22" cy="22" r="20.5" pathLength="100" /></svg>
              <Icon name="close" size={20} weight="medium" />
            </span>
            <span class="pv-more" aria-hidden="true"><span class="pv-more-in"><span class="pv-lb">Close</span><kbd class="pv-kbd">esc</kbd></span></span>
          </button>
        </div>
        <div class="pv-glass">
          <button class="pv-turn" type="button" data-pv-turn><Icon name="turn" size={16} weight="medium" /><span>{t.turn}</span></button>
        </div>
      </div>
      <span class="pv-cursor" data-pv-cursor aria-hidden="true"><Icon name="close" size={20} weight="medium" /><b>Close</b></span>
    </dialog>
  </section>
)}

<style>
  .photos { position: relative; padding: 0 var(--gut); text-align: center; }
  /* the city the photographs were taken in, engraved, as the table's far horizon (line-art set, 8 %) */
  .city { position: absolute; left: 50%; bottom: -150px; width: 1600px; max-width: none; height: auto; margin-left: -800px; opacity: 0.08; pointer-events: none;
    -webkit-mask: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); mask: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); }
  :global(html.motion) .city { transform: translateY(calc((var(--sp) - 0.5) * 16vh)); }
  .photos-lede { margin: var(--s-4) auto 0; max-width: 30em; font: 400 var(--fs-body) / var(--lh-lede) var(--f-sans); color: var(--ink-2); }

  /* ---------- the table: three cards on parallel planes (rotateZ only), stacked by z-index ---------- */
  .table { position: relative; margin: var(--s-8) auto 0; display: flex; justify-content: center; align-items: center; perspective: 1400px; }
  .pc { position: relative; flex: none; width: 324px; z-index: var(--z, 1); }
  .pc.land { width: 412px; }
  .pc + .pc { margin-left: -34px; }
  .pc-open { display: block; width: 100%; padding: 0; border-radius: 6px; -webkit-tap-highlight-color: transparent; }
  .pc-card { position: relative; display: block; transform: rotate(var(--rest)); transform-origin: 50% 60%; }
  :global(html.js) .pc-card { transform: translate(var(--x, 0px), var(--y, 0px)) translateZ(var(--tz, 0px)) rotate(calc(var(--rest) + var(--r, 0deg))) scale(var(--s, 1)); }
  /* one soft floor shadow per card; it separates as the card rises (scripts/postcards.ts sets --tz) */
  .pc-shadow { position: absolute; left: 8%; right: 8%; top: 14%; bottom: -4%; border-radius: 12px; background: rgb(0 0 0 / 0.55); filter: blur(24px); pointer-events: none;
    transform: translate(calc(var(--x, 0px) * 0.8), calc(var(--tz, 0px) * 0.35)) rotate(var(--rest)) scale(calc(1 + var(--tz, 0px) / 900px)); opacity: calc(0.85 - var(--tz, 0px) / 200px); }

  /* the mount: the photograph's own light, blurred and dimmed, under grain; a foil hairline at the edge */
  .pc-mount, .big-face { position: relative; display: block; overflow: hidden; border-radius: 4px; isolation: isolate;
    background: #12110f; box-shadow: 0 1px 2px rgb(0 0 0 / 0.5), 0 22px 44px -18px rgb(0 0 0 / 0.75); }
  .pc-mount { padding: 12px 12px 40px; }
  .pc-blur { position: absolute; inset: -30px; z-index: -1; background: var(--img) center / cover; filter: blur(22px) brightness(0.38) saturate(1.15); }
  .pc-blur::after { content: ""; position: absolute; inset: 0; background: var(--grain) repeat; background-size: 64px; mix-blend-mode: overlay; }
  .pc-mount::before, .big-face::before { content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; padding: 1px; pointer-events: none;
    background: var(--foil); opacity: 0.45;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .pc-guil { position: absolute; z-index: -1; left: -14%; bottom: -16%; width: 62%; height: auto; max-width: none; opacity: 0.11; pointer-events: none; }
  .pc-pic { position: relative; display: block; border-radius: 2px; overflow: hidden; }
  .pc-pic img { width: 100%; height: auto; aspect-ratio: var(--ratio); }
  /* before its file is decoded the plate is the photograph's own tone, not a grey box (scripts/postcards.ts) */
  :global(html.js) .pc-pic { background: radial-gradient(120% 90% at 40% 30%, color-mix(in srgb, var(--tone) 46%, #1a1814), color-mix(in srgb, var(--tone) 18%, #0f0e0c)); }
  .table[data-pc-fade] .pc-pic img { opacity: 0; transition: opacity 240ms var(--ease-out); }
  .table[data-pc-fade] .pc-pic.is-in img { opacity: 1; }
  .pc-pic::after { content: ""; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgb(255 248 238 / 0.14); pointer-events: none; }
  .pc-edge { position: absolute; left: 14px; right: 14px; bottom: 11px; display: flex; justify-content: space-between; align-items: baseline; text-align: left; }
  .pc-edge i { font: italic 400 var(--fs-body) / 1 var(--f-serif); color: var(--ink); }
  .pc-edge b { font: 500 var(--fs-cap) / 1 var(--f-sans); letter-spacing: 0.06em; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  /* the proof marks: gold crop marks at the corners, shown while the card is held */
  .pc-proof i { position: absolute; width: 14px; height: 14px; border: 0 solid color-mix(in srgb, var(--gold-ink) 80%, transparent); opacity: 0; transition: opacity var(--t-ui) var(--ease-out); pointer-events: none; }
  .pc-proof i:nth-child(1) { left: -10px; top: -10px; border-left-width: 1px; border-top-width: 1px; }
  .pc-proof i:nth-child(2) { right: -10px; top: -10px; border-right-width: 1px; border-top-width: 1px; }
  .pc-proof i:nth-child(3) { left: -10px; bottom: -10px; border-left-width: 1px; border-bottom-width: 1px; }
  .pc-proof i:nth-child(4) { right: -10px; bottom: -10px; border-right-width: 1px; border-bottom-width: 1px; }
  .pc.is-up .pc-proof i { opacity: 1; }
  .pc-open:focus-visible { outline: none; }
  .pc-open:focus-visible .pc-proof i { opacity: 1; }
  .pc-open:active .pc-card { --s: 0.98; }
  .pc.is-out .pc-open { visibility: hidden; }
  .pc-cap { display: none; margin-top: var(--s-3); color: var(--ink-3); font: 400 var(--fs-small) / 1.5 var(--f-sans); }
  .pc-cap .note { display: block; color: var(--ink-2); font-style: italic; }
  :global(html:not(.js)) .pc-cap { display: block; }
  .photos-hint { margin-top: var(--s-7); font: 400 var(--fs-label) / 1.35 var(--f-sans); color: var(--ink-3); }
  .photos-hint span { display: none; }
  :global(html.fine) .photos-hint .h-fine, :global(html:not(.fine)) .photos-hint .h-touch { display: inline; }
  :global(html:not(.js)) .photos-hint { display: none; }
  /* scroll: the cards come up onto the table, the middle one first (a pure function of --sp) */
  :global(html.motion) .pc { --k: clamp(0, (var(--sp) - 0.1 - var(--o, 0) * 0.025) / 0.14, 1); }
  :global(html.motion) .pc:nth-child(1) { --o: 1; } :global(html.motion) .pc:nth-child(3) { --o: 2; }
  :global(html.motion) .pc-open { opacity: var(--k); transform: translateY(calc((1 - var(--k)) * 56px)) rotate(calc((1 - var(--k)) * var(--rest) * 0.8)); }

  /* ---------- phone: a loose pile of two small cards and the landscape card under them ---------- */
  @media (max-width: 699.98px) {
    .photos-t, .photos-lede { text-align: left; margin-left: 0; }
    .city { width: 1100px; margin-left: -550px; bottom: -110px; }
    .table { display: block; height: 590px; margin-top: var(--s-6); }
    .pc { position: absolute; width: calc(50% - 2px); max-width: 196px; }
    .pc + .pc { margin-left: 0; }
    .pc:nth-child(1) { left: 0; top: 0; }
    .pc:nth-child(3) { right: 0; max-width: 186px; top: 44px; }
    .pc.land { width: min(300px, 84%); max-width: none; left: 50%; translate: -50% 0; top: 330px; }
    .pc-mount { padding: 8px 8px 30px; }
    .pc-edge { left: 10px; right: 10px; bottom: 9px; }
    .pc-edge i { font-size: var(--fs-small); }
    .photos-hint { margin-top: var(--s-5); }
    /* the capsules where the project's are: fixed at the bottom, close at the left gutter, turn at the right */
    .pv-caps { position: fixed; left: 16px; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); justify-content: space-between; }
  }

  /* ---------- the large view ---------- */
  .pc-big {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: transparent; color: var(--ink); overflow: hidden;
    display: none; flex-direction: column; align-items: center; justify-content: center; gap: var(--s-4);
  }
  .pc-big[open] { display: flex; }
  /* the page stays in sight behind a light blur, so the view reads as a layer over it (spec v3 §4.1) */
  .pc-big::backdrop { background: rgb(18 18 20 / 0.5); -webkit-backdrop-filter: blur(10px) saturate(0.8); backdrop-filter: blur(10px) saturate(0.8);
    opacity: calc(1 - var(--pull, 0) * 0.005); }
  .big-stage { perspective: 1600px; }
  html:not(.fine) .pc-big { touch-action: none; }

  /* ---------- the ways out (spec v3 §4.2, §5.1): two capsules on the tab bar's glass ---------- */
  .pv-caps { display: flex; align-items: center; gap: var(--glass-gap, 12px); }
  .pv-glass { display: flex; padding: var(--glass-pad, 4px); border-radius: var(--r-pill);
    background: var(--glass-bg, rgb(30 30 34 / 0.62)); -webkit-backdrop-filter: var(--glass-blur, blur(22px) saturate(1.5)); backdrop-filter: var(--glass-blur, blur(22px) saturate(1.5));
    box-shadow: var(--glass-edge, inset 0 0 0 1px rgb(255 255 255 / 0.07), inset 0 1px 0 rgb(255 255 255 / 0.05)), var(--glass-shadow, 0 12px 40px -16px rgb(0 0 0 / 0.7)); }
  .pv-glass button { min-height: var(--glass-item, 40px); display: inline-flex; align-items: center; border-radius: var(--r-pill); padding: 0;
    font: 500 var(--fs-small) / 1 var(--f-sans); color: var(--ink); white-space: nowrap; cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: background-color var(--t-quick) var(--ease-ui), scale var(--t-press) var(--ease-ui); }
