  .pc-big .bk-ring .mk { font: 400 22px / 1 var(--f-serif); letter-spacing: 0; }
  /* the message: the note, then the signature with one flourish */
  .pc-big .bk-msg { left: 8%; right: 14%; top: 60%; }
  .pc-big .bk-note { font: italic 400 max(17px, calc(5.4 * var(--u))) / 1.24 var(--f-serif); color: var(--ink); text-wrap: balance; }
  .pc-big .bk-sig { position: relative; display: inline-block; margin-top: calc(2.6 * var(--u)); font: italic 400 max(18px, calc(6.2 * var(--u))) / 1 var(--f-serif); color: var(--ink-t); }
  .pc-big .bk-sig svg { position: absolute; left: -8%; bottom: -62%; width: 240%; height: 90%; overflow: visible; fill: none; stroke: var(--ink-t); stroke-width: 1.2; stroke-linecap: round; opacity: 0.8; }
  /* the colophon: one rule, three columns (two without a place) */
