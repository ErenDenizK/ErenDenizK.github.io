  .pc-big .is-flipped .big-back { opacity: 1; }
  .pc-big .idc-turn { -webkit-tap-highlight-color: transparent; position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; border-radius: inherit; background: transparent; cursor: pointer; }
  .pc-big .is-held .idc-turn { cursor: grabbing; }
  .pc-big .idc-turn:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .pc-big .big-face[inert] { pointer-events: none; }
  .pc-big .idc-glare { position: absolute; inset: 0; z-index: 3; border-radius: inherit; pointer-events: none; opacity: var(--glare); mix-blend-mode: screen;
    background: radial-gradient(circle at var(--gx) var(--gy), rgba(255, 244, 230, 0.16), rgba(255, 244, 230, 0.04) 32%, transparent 58%); }

  /* front: the photograph in its mount */
  .pc-big .big-front { padding: calc(3.2 * var(--u)) calc(3.2 * var(--u)) calc(10 * var(--u)); }
  .pc-big .big-pic { position: relative; display: block; height: 100%; border-radius: 2px; overflow: hidden; }
  .pc-big .big-pic img { width: 100%; height: 100%; object-fit: cover; }
  .pc-big .big-pic::after { content: ""; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgb(255 248 238 / 0.14); }
  /* the burn-in: the photograph develops from grey to colour as it arrives (opacity only) */
  .pc-big .big-dev { position: absolute; inset: 0; background: #77736d; mix-blend-mode: saturation; opacity: 0; pointer-events: none; }
  html.motion .pc-big .big-dev { animation: pc-develop 600ms var(--ease-out) 160ms backwards; }
  @keyframes pc-develop { from { opacity: 1; } }
  .pc-big .big-front .pc-edge { left: calc(3.6 * var(--u)); right: calc(3.6 * var(--u)); bottom: calc(3.6 * var(--u)); }
  .pc-big .big-front .pc-edge i { font-size: max(15px, calc(4.2 * var(--u))); }
