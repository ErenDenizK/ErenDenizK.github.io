  .pc-big .bk-plate { left: 4%; right: 4%; top: 11.5%; height: 47%; color: var(--ink-t); opacity: 0.66; pointer-events: none;
    -webkit-mask: radial-gradient(70% 66% at 50% 48%, #000 62%, transparent 100%); mask: radial-gradient(70% 66% at 50% 48%, #000 62%, transparent 100%); }
