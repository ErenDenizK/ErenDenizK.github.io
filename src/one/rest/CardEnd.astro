---
/* Chapter IV, the card (spec v2 §3.5.2; review row C3): the ID card hangs at the end of the page as the
   one place of GitHub and LinkedIn (its front carries both links, so the Contact strip is gone). The
   strap runs up out of the view and fades into the bar zone; behind the card a large guilloché rosette
   turns 20 deg over the chapter's scroll (a pure function of the chapter's --p, scene.css). The card's
   room to swing is the whole width of the chapter ([data-card-area], read by card3d.ts).
   Lab switch ?card=lanes moves this chapter between the two lanes of How I work (Rest.astro). */
import IdCard from './IdCard.astro';
import { rosette } from './guilloche';

const big = [
  rosette({ cx: 560, cy: 560, R: 96, r: 25, d: 66, scale: 3.9, pens: 2, spread: 0.04, steps: 2400 }),
];
---
<section class="card-ch" id="card" data-rail-sec="Card" data-scene>
  <svg class="rose" viewBox="0 0 1120 1120" aria-hidden="true" focusable="false">
    {big.map((d) => <path d={d} />)}
  </svg>
  <div class="card-area" data-card-area>
    <IdCard />
  </div>
</section>

<style>
  .card-ch { position: relative; padding: 236px 0 0; display: grid; justify-items: center; }
  .rose {
    position: absolute; left: 50%; top: 50%; width: 1120px; height: 1120px; max-width: none; margin: -560px 0 0 -560px;
    fill: none; stroke: var(--gold-ink); stroke-width: 1; opacity: 0.06; pointer-events: none;
  }
  .rose path { vector-effect: non-scaling-stroke; }
  :global(html.motion) .rose { transform: rotate(calc((var(--p) - 0.5) * 20deg)); }
  /* the card's room: the whole page width, so the rope can swing wide (card3d.ts limits()) */
  .card-area { position: relative; width: 100%; display: flex; justify-content: center; }
  .card-area > :global(.idc) { --w: 300px; --strap: 236px; }

  @media (max-width: 699.98px) {
    .card-ch { padding-top: 210px; }
    .rose { width: 760px; height: 760px; margin: -380px 0 0 -380px; }
    .card-area > :global(.idc) { --w: 280px; --strap: 210px; }
  }
</style>
