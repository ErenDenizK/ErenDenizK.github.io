---
/* Contact (design spec §3.4 item 7): two large pills, the one place for the links. */
import Icon from '../../components/Icon.astro';
import { getSite, isPlaceholder } from '../../lib/site';
const site = await getSite();
const li = isPlaceholder(site.links.linkedin) ? null : site.links.linkedin;
---
<section class="strip contact" id="contact" data-rail-sec="Contact">
  <h2 class="label strip-label" data-arrive>Contact</h2>
  <ul class="pills" data-arrive-group>
    <li data-arrive><a class="pill" href={site.links.github} rel="me"><Icon name="github" size={20} />GitHub<Icon name="arrow-up-right" /></a></li>
    {li && <li data-arrive><a class="pill" href={li} rel="me"><Icon name="linkedin" size={24} />LinkedIn<Icon name="arrow-up-right" /></a></li>}
  </ul>
</section>

<style>
  .contact { text-align: center; }
  .pills { margin-top: var(--s-5); display: flex; gap: var(--s-4); justify-content: center; flex-wrap: wrap; }
  .pill {
    display: inline-flex; align-items: center; gap: var(--s-3); min-height: 60px; padding: 0 var(--s-6) 0 var(--s-5);
    border-radius: var(--r-pill); font: 500 var(--fs-h4) / 1 var(--f-sans); letter-spacing: -0.01em; color: var(--ink);
    background: var(--fill-1); box-shadow: inset 0 0 0 1px var(--line-2), 0 18px 40px -20px rgb(0 0 0 / 0.6);
    transition: background-color 150ms var(--ease-ui), box-shadow 150ms var(--ease-ui), scale var(--t-press) var(--ease-ui);
  }
  .pill:hover { background: var(--fill-2); box-shadow: inset 0 0 0 1px var(--line-3), 0 18px 40px -20px rgb(0 0 0 / 0.6); }
  .pill:active { scale: 0.98; }
  .pill :global(.icon:last-child) { color: var(--ink-3); }
</style>
