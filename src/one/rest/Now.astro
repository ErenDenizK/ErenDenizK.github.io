---
/* Now (design spec §3.4 item 5): the one place for "this month". */
import { getSite } from '../../lib/site';
const site = await getSite();
---
<section class="strip now" id="now" data-rail-sec="Now">
  <h2 class="label strip-label" data-arrive>{site.now.label}</h2>
  <p class="h3 text" data-arrive>{site.now.text}</p>
</section>

<style>
  .now { text-align: center; }
  .text { max-width: 22em; margin: var(--s-4) auto 0; color: var(--ink); }
</style>
