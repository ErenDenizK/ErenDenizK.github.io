---
/* The brief's plate (design spec §1.2, §3.2; spec v2 §3.2): the construction drawing alone, with the red
   signal light on the page axis. The cropped Bostancı photograph that stood here is gone (review row
   P1: "it shows only a little at the bottom"); the photograph now has its own frame, whole and
   vertical, after the brief (Bostanci.astro). L1 of the layers: the drawing scrolls more slowly than the
   text for the first screen (spec §4.3) and draws on arrival. */
---
<div class="plate" data-scrub="0 100">
  <svg class="construct wide" viewBox="0 0 1440 1240" fill="none" stroke="currentColor" stroke-width="1" focusable="false">
    <circle class="dr" cx="720" cy="560" r="430" pathLength="1" transform="rotate(-90 720 560)" />
    <circle class="dot" cx="720" cy="560" r="266" stroke-dasharray="2 6" />
    <path class="dr" d="M0 560H1440" pathLength="1" />
    <path class="dot" d="M720 96V1240" stroke-dasharray="1 7" />
    <path class="dr" d="M720 560 90 1240M720 560 1350 1240" pathLength="1" />
    <path class="dot" d="M290 96 720 560 1150 96" stroke-dasharray="2 8" />
    <path class="dr" d="M470 176V166H970V176" pathLength="1" />
    <path class="dr tick" d="M706 560h-16M734 560h16" pathLength="1" />
  </svg>
  <svg class="construct narrow" viewBox="0 0 780 1100" fill="none" stroke="currentColor" stroke-width="1" focusable="false">
    <circle class="dr" cx="390" cy="600" r="300" pathLength="1" transform="rotate(-90 390 600)" />
    <circle class="dot" cx="390" cy="600" r="186" stroke-dasharray="2 6" />
    <path class="dr" d="M0 600H780" pathLength="1" />
    <path class="dot" d="M390 80V1100" stroke-dasharray="1 7" />
    <path class="dr" d="M390 600 40 1100M390 600 740 1100" pathLength="1" />
  </svg>
  <i class="sig"></i>
</div>

<style>
  .plate { position: absolute; left: 0; right: 0; top: 0; height: 2200px; color: var(--ink); }
  .construct { position: absolute; left: 50%; top: 0; max-width: none; opacity: 0.1; overflow: visible; }
  .construct.wide { width: 1440px; height: 1240px; margin-left: -720px; }
  .construct.narrow { display: none; width: 780px; height: 1100px; margin-left: -390px; }
  /* still twins (no JS, reduced motion): the plate does not drift away, so it ends above the photograph */
  :global(html:not(.motion)) .plate { -webkit-mask: linear-gradient(180deg, #000 600px, transparent 760px); mask: linear-gradient(180deg, #000 600px, transparent 760px); }
  .sig {
    position: absolute; left: 50%; top: 560px; width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%;
    background: var(--signal); box-shadow: 0 0 14px 4px rgb(255 90 90 / 0.5); opacity: 0.8;
  }

  @media (max-width: 699.98px) {
  
  /* ---------- arrival (spec §4.1): the lines draw, the signal comes last ---------- */
  :global(html.motion) .dr { stroke-dasharray: 1; animation: draw var(--t-draw) var(--ease-draw) both; }
  :global(html.motion) .dot { animation: fade 1600ms var(--ease-ui) 600ms backwards; }
  :global(html.motion) .tick { animation-delay: 1400ms; animation-duration: 800ms; }
  :global(html.motion) .sig { animation: fade 300ms var(--ease-ui) 2400ms backwards; }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } }

  /* L1: half speed for the first screen, then with the page (spec §4.3). Scroll-driven where the browser
     has scroll timelines; scripts/scrub.ts drives the same keyframes elsewhere (one style write a frame). */
  @supports (animation-timeline: scroll()) {
    /* the timeline sits in its own rule with a stronger selector: in one rule the CSS minifier folds it
       into the animation shorthand, which browsers reject, and the plate would not move at all */
    :global(html.motion) .plate { animation: plate-drift linear both; }
    :global(html.motion .plates) .plate { animation-timeline: scroll(root); animation-range: 0 100vh; }
  }
  @supports not (animation-timeline: scroll()) {
    :global(html.motion) .plate { animation: plate-drift 1s linear both paused; animation-delay: calc(var(--p, 0) * -1s); }
  }
  /* The plate belongs to the brief: it fades out while Work comes up, so the deck never stands on the
     drawing (the comps show Work on its own light). Opacity and translate run on one scroll range; once
     faded, the plate is hidden, so it costs no compositing for the rest of the page. The arrival
     animations above fill backwards only, for the same reason: a finished animation keeps no layer. */
  @keyframes plate-drift { 0% { translate: 0 0; } 40% { opacity: 1; } 72% { opacity: 0; visibility: visible; } 73%, 100% { opacity: 0; visibility: hidden; } 100% { translate: 0 50vh; } }
  @media (max-width: 699.98px) { @keyframes plate-drift { 0% { translate: 0 0; } 40% { opacity: 1; } 72% { opacity: 0; visibility: visible; } 73%, 100% { opacity: 0; visibility: hidden; } 100% { translate: 0 30vh; } } }
</style>
