---
/* A print (phase3 design-spec.md 3.3.1): a real screen on a mount of the project's own dark paper,
   12 px on three sides and 34 px at the bottom (8 / 26 on phones), with its own grain and a caption
   on the mount. A project without screens gets one print of its glass object on that paper.
   Three nested boxes: .pr takes the deck's pose (scripts/deck.ts), .pr-in the hover lift, .pr-mount
   is the paper (the view transition name "paper" on open). In Work's flight (spec v2 §3.3.1) the hero
   print carries a greyscale twin of its screen over the colour one (`twin`): the flight fades the twin
   out near the centre, so the colour returns by opacity alone and no filter is ever animated. `num`
   replaces the right side of the caption (the project's number, "01 / 03"). */
import Shot from './Shot.astro';
import Obj from './Obj.astro';
import type { Model, Screen } from './data';
interface Props { m: Model; s?: Screen; i: number; n: number; sizes: string; eager?: boolean; cls?: string; twin?: boolean; num?: string }
const { m, s, i, n, sizes, eager = false, cls = '', twin = false, num } = Astro.props;
const left = s ? (s.title ? `${m.title} · ${s.title}` : m.title) : `${m.title} · ${m.kind}`;
---
<figure class:list={['pr', cls]} data-i={i} data-pos={i} data-phone-frame={s?.phone ? '' : undefined}>
  <div class="pr-in">
    <div class="pr-mount">
      <div class:list={['pr-screen', { 'pr-obj': !s }]}>
        {s
          ? <Shot s={s} sizes={sizes} phoneSizes="calc(100vw - 88px)" eager={eager} cls="pr-img" />
          : <Obj o={m.obj} sizes="(max-width: 699.98px) 70vw, 420px" cls="pr-object" />}
        {s && twin && <div class="pr-twin" aria-hidden="true"><Shot s={s} sizes={sizes} phoneSizes="calc(100vw - 88px)" eager={eager} cls="pr-img" alt="" /></div>}
      </div>
      <figcaption class="pr-cap cap"><span>{left}</span>{num ? <span>{num}</span> : n > 1 && <span>{i + 1} / {n}</span>}</figcaption>
      <div class="pr-shade" aria-hidden="true"></div>
    </div>
  </div>
</figure>
