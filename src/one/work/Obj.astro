---
/* A project's glass object (ADR-0006): the pre-rendered poster, drawn additively (plus-lighter) like
   every object on the site. scripts/deck.ts adds the idle loop later, on the project in front only;
   the presentation adds the spin loop where it has one. Decorative: aria-hidden. */
import type { Obj } from './data';
interface Props { o: Obj; sizes: string; cls?: string; loop?: 'idle' | 'spin'; eager?: boolean }
const { o, sizes, cls = '', loop = 'idle', eager = false } = Astro.props;
const p = o.poster;
const videos = loop === 'spin' ? { wide: o.spin, phone: o.spinPhone } : { wide: o.idle, phone: o.idle };
---
<div class:list={['obj', cls]} aria-hidden="true" data-obj={o.name} data-loop={loop}
  data-videos={JSON.stringify(videos)} style={`--light: ${p.light}`}>
  <picture>
    {p.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
    <img class="obj-img" src={p.src} alt="" width={p.w} height={p.h} loading={eager ? undefined : 'lazy'} decoding="async" />
  </picture>
  {/* the line twin (lab switch ?objects=line, objects.css): the file is a mask painted in the project's
      ink, so it is fetched only when the switch shows it */}
  {o.line && <span class="obj-line" style={`--line: url("${o.line}")`}></span>}
</div>
