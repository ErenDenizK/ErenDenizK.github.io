---
/* The steps of a presentation (spec v2 §3.4, O3). The markup is the linear form (the phone, reduced
   motion, no JavaScript): per step the screen, then its number, title and body. scripts/stepper.ts
   holds it in a sticky stage on wide windows and moves from step to step as a pure function of the
   scroll (the next screen slides over the last, the text rolls over in masks, the index rule glides).
   .st-mark elements are the rail's beads, one per step. A step without a caption shows its screen and
   its number only. A clip step plays the signature clip while it is the one shown. */
import Shot from './Shot.astro';
import type { Model } from './data';
interface Props { m: Model }
const { m } = Astro.props;
const two = (k: number) => String(k + 1).padStart(2, '0');
---
<section class="steps" data-steps style={`--n: ${m.steps.length}`}>
  {m.steps.map((s, k) => <i class="st-mark" data-rail-sec={s.title ?? `Step ${two(k)}`} aria-hidden="true"></i>)}
  <div class="st-stick">
    <div class="st-head" aria-hidden="true">
      <ol class="st-idx">
        {m.steps.map((s, k) => <li data-k={k}><span class="st-num">{two(k)}</span>{s.title && <span> {s.title}</span>}</li>)}
      </ol>
      <i class="st-rule"></i>
    </div>
    <ol class="st-list">
      {m.steps.map((s, k) => (
        <li class="st" data-k={k} data-phone-frame={s.phone ? '' : undefined}>
          <div class="st-frame"><figure class="st-shot">
            <Shot s={s} sizes="(max-width: 699.98px) calc(100vw - 32px), 880px" phoneSizes="min(72vw, 300px)" cls="st-img" />
            {s.clip && (
              <video class="st-video" muted playsinline disablepictureinpicture preload="none" aria-hidden="true" tabindex="-1">
                {s.clip.phone?.map((v) => <source data-src={v.src} type={v.type} media="(max-width: 699.98px)" />)}
                {s.clip.wide.map((v) => <source data-src={v.src} type={v.type} media={s.clip?.phone ? '(min-width: 700px)' : undefined} />)}
              </video>
            )}
            <i class="st-dim" aria-hidden="true"></i>
          </figure></div>
          <div class="st-txt">
            <div class="st-ln"><p class="st-n label">{two(k)} / {two(m.steps.length - 1)}</p></div>
            {s.title && <div class="st-ln"><h3 class="st-title">{s.title}</h3></div>}
            {s.body && <div class="st-ln"><p class="st-body">{s.body}</p></div>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
