---
/* A pile of postcards (docs/research/2026-10-about-and-postcards.md §3; ADR-0008 amendment of 2026-10-11):
   the photographs of an About chapter that has two or more. The top card is live: it tilts under a
   moving light, can be dragged or swiped aside to go under the pile, and turns over to its back (note,
   stamp, postmark). Buttons and the arrow keys do the same; the caption beside the pile names the top
   card. Light is colour: the pool behind the pile takes the top photograph's own tone, measured by
   tools/photos/postcards.mjs. Behaviour: scripts/pile.ts. Without JavaScript the cards stand in a row,
   each with its note under it.

   The default slot holds the chapter's heading and words; they stand beside the pile on wide screens. */
import Postcard from './Postcard.astro';
import Icon from './Icon.astro';
import { getSite } from '../lib/site';

export interface PileCard {
  src: string; srcset: string; avif: string; sizes: string; width: number; height: number;
  alt: string; note: string; place: string; date?: string; tone: string;
}
interface Props { cards: PileCard[] }
const { cards } = Astro.props;
const site = await getSite();
const t = site.about.pile;
const n = cards.length;
const pad = (i: number) => String(i).padStart(2, '0');
---
<div class="pile" data-pile data-of={t.of} style={`--tone: ${cards[0].tone}; --pc-ratio: ${cards[0].width} / ${cards[0].height}`}>
  <div class="pile-words">
    <slot />
    <div class="pile-cap" aria-hidden="true">
      <p class="pile-place"><span class="pile-n"><span data-pile-n>01</span> / {pad(n)}</span><span data-pile-place>{cards[0].place}</span></p>
      <p class="pile-note" data-pile-note>{cards[0].note}</p>
    </div>
    <div class="pile-bar">
      <button class="pile-btn" type="button" data-pile-prev aria-label={t.prev}><Icon name="arrow-left" size={20} /></button>
      <button class="pile-btn" type="button" data-pile-next aria-label={t.next}><Icon name="arrow-right" size={20} /></button>
      <button class="pile-turn" type="button" data-pile-turn aria-pressed="false">{t.turn}</button>
    </div>
    <p class="pile-hint"><span class="h-fine">{t.hint.drag}</span><span class="h-touch">{t.hint.tap}</span></p>
    <p class="sr-only" aria-live="polite" data-pile-live></p>
  </div>

  <div class="pile-table">
    <span class="pile-light" aria-hidden="true"></span>
    <div class="pile-stage" data-pile-stage aria-label={t.label} role="group">
      {cards.map((c, i) => (
        <figure class="pile-card" data-pile-card data-tone={c.tone} data-place={c.place} data-note={c.note} style={`--i: ${i}; z-index: ${n - i}`}>
          <Postcard mode="pile" pos={`${i + 1} ${t.of} ${n}`} src={c.src} srcset={c.srcset} avif={c.avif} sizes={c.sizes} width={c.width} height={c.height} alt={c.alt} note={c.note} place={c.place} date={c.date} />
          <figcaption class="pile-fig">{c.note} <span>{c.place}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</div>

<script>
  import { initPiles } from '../scripts/pile';
  initPiles();
</script>

<style>
  @property --tone { syntax: '<color>'; inherits: true; initial-value: #f3b886; }

  /* the words beside the table; the table holds the pile and its light */
  .pile {
    --pw: 360px;
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 72px; align-items: start;
    transition: --tone 900ms var(--ease-out);
  }
  .pile-words { max-width: 30rem; }
  .pile-table { position: relative; width: calc(var(--pw) * 1.36); display: grid; place-items: center; padding: 8px 0 40px; }
  /* light is colour: a soft pool in the top photograph's tone, as if the print lit the desk */
  .pile-light {
    position: absolute; inset: -12% -18%; z-index: -1; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--tone) 24%, transparent), color-mix(in srgb, var(--tone) 7%, transparent) 55%, transparent);
  }
  .pile-stage { position: relative; width: var(--pw); aspect-ratio: var(--pc-ratio); touch-action: pan-y; }
  .pile-card { position: absolute; inset: 0; margin: 0; will-change: transform; }
  .pile-card :global(.pc) { height: 100%; }
  /* cards beneath sit in the top card's shadow */
  .pile-card::after {
    content: ""; position: absolute; inset: 0; border-radius: 1.4cqi; background: #050505; pointer-events: none;
    opacity: calc(min(var(--d, 0), 3) * 0.16); transition: opacity var(--d-4) var(--ease-out);
  }
  .pile-card :global(.pc-face) { box-shadow: inset 0 0 0 1px rgba(255, 245, 232, 0.08), 0 18px 40px -16px rgba(0, 0, 0, 0.85), 0 2px 6px rgba(0, 0, 0, 0.4); }
  :global(.js) .pile-stage { cursor: grab; }
  :global(.js) .pile.is-held .pile-stage { cursor: grabbing; }
  .pile-fig { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* the caption: place and note of the top card, then the controls */
  .pile-cap { margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--rule); }
  .pile-place { display: flex; align-items: baseline; gap: 14px; font: 400 var(--t-ui)/var(--lh-ui) var(--f-ui); color: var(--ink); }
  .pile-n { font: 400 var(--t-meta)/1 var(--f-ui); font-variant-numeric: tabular-nums; color: color-mix(in srgb, var(--tone) 70%, var(--ink-2)); letter-spacing: 0.02em; }
  .pile-note { margin-top: 8px; font: italic 400 22px/1.4 var(--f-read); color: var(--read); text-wrap: pretty; min-height: 2.8em; }
  .pile-bar { margin-top: 24px; display: flex; gap: 8px; align-items: center; }
  .pile-btn, .pile-turn {
    min-height: 44px; border-radius: 22px; border: 1px solid var(--rule-2); background: transparent; color: var(--ink);
    transition: background var(--d-2), border-color var(--d-2), color var(--d-2);
  }
  .pile-btn { width: 44px; display: grid; place-items: center; }
  .pile-turn { padding: 0 18px; font: 400 var(--t-ui)/1 var(--f-ui); margin-left: 6px; }
  .pile-btn:hover, .pile-turn:hover { background: var(--wash); border-color: color-mix(in srgb, var(--tone) 40%, var(--rule-2)); }
  .pile-turn[aria-pressed="true"] { border-color: color-mix(in srgb, var(--tone) 55%, transparent); color: color-mix(in srgb, var(--tone) 50%, var(--ink)); }
  .pile-btn:focus-visible, .pile-turn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pile-hint { margin-top: 14px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); }
  .h-touch { display: none; }
  @media not ((hover: hover) and (pointer: fine)) { .h-fine { display: none; } .h-touch { display: inline; } }
  @media (prefers-reduced-motion: reduce) { .pile-hint { display: none; } }

  /* still (reduced motion or ?still): the turn is a crossfade, as the postcard's own reduced-motion rule */
  .pile.is-still :global(.pc-face) { backface-visibility: visible; transition: opacity 150ms linear; }
  .pile.is-still :global(.pc-back) { transform: none; opacity: 0; }
  .pile.is-still :global(.is-flipped .pc-back) { opacity: 1; }
  .pile.is-still :global(.is-flipped .pc-front) { opacity: 0; }

  @media (max-width: 1240px) {
    .pile { --pw: 320px; column-gap: 48px; }
  }
  @media (max-width: 899.98px) {
    /* phones: the words, then the pile, then its caption and controls under it */
    .pile { --pw: min(68vw, 290px); display: flex; flex-direction: column; align-items: stretch; }
    .pile-words { display: contents; }
    .pile-table { order: 1; width: auto; padding: 40px 0 36px; margin: 0 calc(-1 * var(--gut)); overflow: hidden; }
    .pile-cap { order: 2; margin-top: 0; }
    .pile-bar { order: 3; }
    .pile-hint { order: 4; }
    .pile-note { font-size: 19px; min-height: 0; }
  }

  /* without JavaScript: the photographs in a row, each with its note; no controls */
  :global(html:not(.js)) .pile { display: block; }
  :global(html:not(.js)) .pile-cap, :global(html:not(.js)) .pile-bar, :global(html:not(.js)) .pile-hint, :global(html:not(.js)) .pile-light { display: none; }
  :global(html:not(.js)) .pile-table { width: auto; padding: 40px 0 0; display: block; place-items: normal; }
  :global(html:not(.js)) .pile-stage { width: auto; aspect-ratio: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 32px; }
  :global(html:not(.js)) .pile-card { position: static; }
  :global(html:not(.js)) .pile-card :global(.pc) { height: auto; }
  :global(html:not(.js)) .pile-card::after { display: none; }
  :global(html:not(.js)) .pile-fig { display: block; margin-top: 14px; font: italic 400 17px/1.45 var(--f-read); color: var(--read); }
  :global(html:not(.js)) .pile-fig span { display: block; margin-top: 4px; font: 400 var(--t-meta)/1.3 var(--f-ui); font-style: normal; color: var(--ink-3); }
</style>
