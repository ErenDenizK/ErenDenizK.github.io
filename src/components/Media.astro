---
/* The object stage (ADR-0006, media research §8): the poster paints first and is complete on its own.
   The client (scripts/media.ts) reads data-manifest after load and idle, and only then adds the idle
   loop, the lean grid, the interaction clip and the droplet change, when motion is welcome.
   Structure: .media sizes the slot; .m-shadow (optional, multiply) darkens the real ground under the
   object; .m-stage is one additive group (glow + ground-subtracted media, plus-lighter) and is what
   morphs between pages (ADR-0007). */
import { poster } from '../lib/media';
/* solo: one of several stages on a page (Work); only the one the page focuses moves (scripts/media.ts, focus).
   Two opt-ins for the Home Record strip (spec v3 sections 8.2 and 8.4); every other slot keeps today's
   behaviour: spin "off" keeps phones and tablets on the floating poster (no spin loop); lean "scroll" lets
   the desktop lean follow the slot's place in the window while no pointer is near. */
interface Props { obj: string; slot: string; stage?: boolean; solo?: boolean; class?: string; sizes?: string; priority?: boolean; light?: string; spin?: 'off'; lean?: 'scroll' }
const { obj, slot, stage = false, solo = false, class: cls = '', sizes = '(min-width: 900px) 470px, 60vw', priority = false, light, spin, lean } = Astro.props;
const p = poster(obj);
---
<div class:list={['media', cls, { stage }]} data-slot={slot} data-obj={obj} data-manifest={p.manifest} data-solo={solo ? '' : undefined} data-spin={spin} data-lean={lean} style={`--light: ${light || p.light}`} aria-hidden="true">
  {p.shadow && (
    <picture class="m-shadow-pic">
      {p.shadow.sources.map((s) => <source type={s.type} srcset={s.src} />)}
      <img class="m-shadow" src={p.shadow.src} alt="" decoding="async" loading="lazy" />
    </picture>
  )}
  <div class="m-stage">
    <div class="m-glow"></div>
    <div class="m-layer" data-obj={obj}>
      <picture>
        {p.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
        <img class="m-poster" src={p.src} alt="" width={p.w} height={p.h} decoding="async" fetchpriority={priority ? 'high' : undefined} loading={priority ? undefined : 'lazy'} />
      </picture>
    </div>
    <div class="m-glint"></div>
  </div>
</div>
