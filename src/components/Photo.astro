---
/* One photograph on About, shown as a postcard (components/Postcard.astro). Until 2026-10-15 this slot
   also held three trial presentations behind ?photos=1|2|3 (Darkroom, Proof, Depth;
   docs/research/2026-10-photo-presentation.md). The owner rejected them as gimmicks, and they were
   removed on 2026-10-15 (record: docs/history/removed-2026-10-15.md). The fields that only the trials
   read (stem, index, small, full, tone) stay in the props: the planned postcard v2 enlarged view needs
   the full-size file and the tone. */
import Postcard from './Postcard.astro';

interface Props {
  /** the photo's file stem in content/photos/ */
  stem: string;
  /** which photograph on the page this is, from 0 */
  index: number;
  src: string;
  srcset: string;
  avif: string;
  sizes: string;
  /** the original's pixels (the derivatives are never drawn larger than their own) */
  width: number;
  height: number;
  /** the smallest webp */
  small: string;
  /** the whole photograph at its own width, when it is wider than the largest derivative */
  full?: { avif: string; webp: string; width: number; height: number };
  /** the photo's measured light colour (tools/photos/postcards.mjs) */
  tone: string;
  alt: string;
  note: string;
  place: string;
  date?: Date | string;
  rest?: number;
  hint?: boolean;
}
const p = Astro.props;
---
<div class="photo-slot" data-photo>
  <Postcard src={p.src} srcset={p.srcset} avif={p.avif} sizes={p.sizes} width={p.width} height={p.height} alt={p.alt} note={p.note} place={p.place} date={p.date} rest={p.rest} hint={p.hint} />
</div>
