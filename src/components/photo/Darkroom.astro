---
/* Concept 1, "Darkroom" (docs/research/2026-10-photo-presentation.md §3.1). The photograph is a print
   that develops as it comes into view: black paper under a faint safelight, then the developer washes
   across it from one corner, the highlights come up first, the print is red-monochrome for a moment
   and then takes its colour; a sheen slides off as it dries. A tap turns the enlarger off: the print
   goes deep red under the safelight and its label is written over it in light, letter by letter (the
   place, the note, the frame's pixels and the light measured from the photo).

   scripts/photos/darkroom.ts drives it (WebGL for the developing; the finished print is the <img>
   itself, so it is never softer than the file). Still twins: reduced motion or ?still shows the print
   developed and the label crossfades; without WebGL the print develops with a CSS filter; without
   JavaScript the print stands with its place and note under it. */
import type { PhotoProps } from './types';
import { splitPlace, dims } from './types';
import { getSite } from '../../lib/site';
type Props = PhotoProps;
const p = Astro.props;
const site = await getSite();
const t = site.about.postcard;
const [first, rest] = splitPlace(p.place);
const letters = [...first];
const ratio = `${p.width} / ${p.height}`;
---
<figure class="dk" data-darkroom data-from={p.index % 2 ? 'tr' : 'tl'} style={`--ratio: ${ratio}; --tone: ${p.tone}`}>
  <div class="dk-print">
    <picture class="dk-pic">
      <source type="image/avif" srcset={p.avif} sizes={p.sizes} />
      <img src={p.src} srcset={p.srcset} sizes={p.sizes} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" draggable="false" />
    </picture>
    <canvas class="dk-gl" aria-hidden="true"></canvas>
    <button class="dk-hit" type="button" aria-pressed="false" aria-label={`${t.of} ${p.place}: read its label`}></button>
  </div>
  <figcaption class="dk-plate">
    <span class="dk-place" data-place={first}><span class="vh">{first}</span>{letters.map((ch, i) => <span aria-hidden="true" style={`--i: ${i}`}>{ch}</span>)}</span>
    {rest && <span class="dk-where">{rest}</span>}
    <span class="dk-note">{p.note}</span>
    <span class="dk-meta">
      <span class="dk-row"><span class="dk-k">Frame</span><span class="dk-v">{dims(p.width, p.height)}</span></span>
      <span class="dk-row"><span class="dk-k">Light</span><span class="dk-v"><span class="dk-sw" aria-hidden="true"></span>{p.tone.toUpperCase()}</span></span>
    </span>
  </figcaption>
  <p class="dk-cap" aria-hidden="true"><span class="dk-cap-place">{p.place}</span>{p.hint && <span class="dk-hint">Tap the print for its label</span>}</p>
</figure>

<style>
  .dk { position: relative; margin: 0; width: 100%; max-width: 340px; container-type: inline-size; --red: #c2281c; }
  .dk-print {
    position: relative; aspect-ratio: var(--ratio); border-radius: 2px; overflow: hidden; background: #060505;
    box-shadow: 0 0 0 1px rgba(255, 245, 235, 0.06), 0 30px 60px -28px rgba(0, 0, 0, 0.9), 0 0 0 0 transparent;
    transition: box-shadow 900ms var(--ease-out);
  }
  .dk-pic, .dk-pic img, .dk-gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dk-pic img { object-fit: cover; transition: filter 760ms var(--ease-out), opacity 420ms linear; }
  .dk-gl { opacity: 0; transition: opacity 420ms linear; pointer-events: none; }
  .dk-hit { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .dk-hit:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  /* live: the canvas develops the print; the <img> comes back when it is done */
  :global(html.js) .dk.is-live .dk-pic img { opacity: 0; }
  :global(html.js) .dk.is-live .dk-gl { opacity: 1; }
  :global(html.js) .dk.is-live.is-developed .dk-pic img { opacity: 1; }
  :global(html.js) .dk.is-live.is-developed .dk-gl { opacity: 0; }
  /* without WebGL: the same idea as a filter, from a red-black sheet to the print */
  :global(html.js) .dk.is-css .dk-pic img { filter: brightness(0.04) sepia(1) saturate(4) hue-rotate(-28deg); transition: filter 2600ms cubic-bezier(0.5, 0, 0.3, 1); }
  :global(html.js) .dk.is-css.is-developed .dk-pic img { filter: none; }

  /* the safelight: the print goes deep red and dark, the label is written over it in light */
  .dk.is-safe .dk-pic img { filter: grayscale(1) sepia(1) saturate(7) hue-rotate(-52deg) brightness(0.27) contrast(1.2) !important; transition: filter 760ms var(--ease-out) !important; }
  .dk.is-safe .dk-print { box-shadow: 0 0 0 1px rgba(255, 120, 100, 0.12), 0 30px 60px -28px rgba(0, 0, 0, 0.9), 0 0 90px -10px color-mix(in srgb, var(--red) 34%, transparent); }

  /* the label: under the print without JavaScript, over it (in light) with it */
  .dk-plate { display: grid; gap: 4px; margin-top: 14px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); }
  .dk-place { font: 400 22px/1.1 var(--f-display); color: var(--ink); }
  .dk-place span[style] { display: inline-block; white-space: pre; }
  .dk-where { color: var(--ink-2); }
  .dk-note { font: italic 400 17px/1.4 var(--f-read); color: var(--read); }
  .dk-meta { display: none; }
  .dk-cap { display: none; }

  :global(html.js) .dk-plate {
    position: absolute; z-index: 2; left: 0; right: 0; top: 0; aspect-ratio: var(--ratio); margin: 0; pointer-events: none;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 0; padding: 9cqi 8cqi 8.5cqi;
    color: rgba(255, 214, 200, 0.7); opacity: 0; transition: opacity 500ms linear;
  }
  :global(html.js) .dk.is-safe .dk-plate { opacity: 1; transition-delay: 160ms; }
  :global(html.js) .dk-place {
    font: 400 15cqi/0.95 var(--f-display); letter-spacing: -0.02em; color: #ffe9e0;
    text-shadow: 0 0 0.12em rgba(255, 150, 120, 0.9), 0 0 0.5em rgba(255, 70, 40, 0.55);
  }
  :global(html.js) .dk.is-safe .dk-place span[style] { animation: dk-lit 1100ms var(--ease-out) both; animation-delay: calc(240ms + var(--i) * 70ms); }
  @keyframes dk-lit {
    0% { opacity: 0; filter: blur(6px); }
    30% { opacity: 1; filter: blur(0); text-shadow: 0 0 0.2em #fff, 0 0 0.8em rgba(255, 90, 60, 0.9); }
    100% { opacity: 1; filter: blur(0); }
  }
  :global(html.js) .dk-where { margin-top: 2.6cqi; font: 500 max(11px, 3.6cqi)/1.2 var(--f-ui); letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255, 200, 185, 0.78); }
  :global(html.js) .dk-note { margin-top: 5.5cqi; font: italic 400 max(14px, 5.2cqi)/1.38 var(--f-read); color: rgba(255, 228, 218, 0.92); text-wrap: pretty; max-width: 22em; }
  :global(html.js) .dk-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqi; margin-top: 6cqi; padding-top: 3.4cqi; border-top: 1px solid rgba(255, 150, 130, 0.28); }
  :global(html.js) .dk-row { display: grid; gap: 0.8cqi; }
  :global(html.js) .dk-k { font: 500 max(10px, 2.9cqi)/1.2 var(--f-ui); letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 170, 150, 0.62); }
  :global(html.js) .dk-v { display: flex; align-items: center; gap: 1.6cqi; font: 400 max(12px, 3.8cqi)/1.2 var(--f-ui); color: rgba(255, 228, 218, 0.9); font-variant-numeric: tabular-nums; }
  .dk-sw { width: 2.8cqi; height: 2.8cqi; min-width: 8px; min-height: 8px; border-radius: 50%; background: var(--tone); box-shadow: 0 0 8px var(--tone); }

  /* under the print: the place, and on the first one how to use it */
  :global(html.js) .dk-cap { display: grid; gap: 4px; margin-top: 16px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); }
  .dk-cap-place { color: var(--ink-2); }

  @media (prefers-reduced-motion: reduce) {
    .dk-pic img, .dk-print { transition: opacity 180ms linear !important; }
    .dk.is-safe .dk-place span[style] { animation: none !important; }
  }
  .dk.is-still .dk-pic img, .dk.is-still .dk-print { transition-duration: 180ms !important; }
  .dk.is-still.is-safe .dk-place span[style] { animation: none; }
  </style>
