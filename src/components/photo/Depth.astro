---
/* Concept 3, "Depth" (docs/research/2026-10-photo-presentation.md §3.3): the photograph as a window. A
   depth map painted for each photo (tools/photos/depth.py) lets the near things move against the far
   ones: with a mouse you look around by moving over it; on a phone, by dragging sideways across it, and
   the page's own scrolling shifts the view up and down as you pass, as walking past a window does. A
   tap pulls focus to what is under the finger, as a lens does: that plane stays sharp and the others
   soften; a second tap on the same plane opens the whole picture sharp again. The photo lights the
   wall around it with its own colour, and a museum label stands under it.

   scripts/photos/depth.ts drives it (one small WebGL shader; the context exists only while the photo
   is near the window). Still twins: reduced motion or ?still shows the photograph still and sharp with
   its label; without WebGL the whole photo moves a little behind its glass and focus is not offered;
   without JavaScript the photograph stands with its label. */
import type { PhotoProps } from './types';
import { dims } from './types';
import { getSite } from '../../lib/site';
type Props = PhotoProps;
const p = Astro.props;
const site = await getSite();
const ratio = `${p.width} / ${p.height}`;
---
<figure class="dp" data-depth data-map={p.depth} style={`--ratio: ${ratio}; --tone: ${p.tone}`}>
  <div class="dp-win">
    <span class="dp-glow" aria-hidden="true" style={`background-image: url("${p.small}")`}></span>
    <div class="dp-pic">
      <picture class="dp-img">
        <source type="image/avif" srcset={p.avif} sizes={p.sizes} />
        <img src={p.src} srcset={p.srcset} sizes={p.sizes} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" draggable="false" />
      </picture>
      <canvas class="dp-gl" aria-hidden="true"></canvas>
      <span class="dp-glass" aria-hidden="true"></span>
      <span class="dp-ring" aria-hidden="true"></span>
      {p.depth && <button class="dp-hit" type="button" aria-label={`${p.place}: pull focus (near, far, all)`}></button>}
    </div>
  </div>
  <figcaption class="dp-label">
    <span class="dp-title">{p.note}</span>
    <span class="dp-place">{p.place}</span>
    <span class="dp-tech">Photograph by {site.name}<br />{dims(p.width, p.height)}</span>
    {p.hint && <span class="dp-hint" aria-hidden="true"><span class="h-fine">Move over it to look around; click to pull focus</span><span class="h-touch">Drag across it to look around; tap to pull focus</span></span>}
  </figcaption>
</figure>

<style>
  .dp { position: relative; margin: 0; width: 100%; max-width: 340px; --near: 0; --lx: 0; --ly: 0; }
  .dp-win { position: relative; }
  /* the photo's own light on the wall around it; brighter as it nears the middle of the window */
  .dp-glow {
    position: absolute; inset: 4% -2% -4%; z-index: 0; pointer-events: none; border-radius: 50%;
    background: center / cover no-repeat; filter: blur(46px) saturate(1.4); opacity: calc(0.16 + var(--near) * 0.3);
    transform: translateZ(0); will-change: opacity;
  }
  .dp-pic {
    position: relative; z-index: 1; aspect-ratio: var(--ratio); overflow: hidden; border-radius: 2px; background: #050505;
    box-shadow: 0 0 0 1px rgba(255, 245, 235, 0.07), 0 34px 70px -34px rgba(0, 0, 0, 0.95);
    touch-action: pan-y; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
  }
  .dp-img, .dp-img img, .dp-gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dp-img img { object-fit: cover; }
  .dp-gl { opacity: 0; transition: opacity 360ms linear; pointer-events: none; }
  /* live: the picture sits a little larger than its window, so looking around never shows an edge */
  :global(html.js) .dp.is-live .dp-img img { transform: translate3d(calc(var(--lx) * -1.6%), calc(var(--ly) * -1.2%), 0) scale(1.06); }
  :global(html.js) .dp.is-gl .dp-gl { opacity: 1; }
  /* the glass in front: a soft band of reflected light that slides against the look */
  .dp-glass { position: absolute; inset: -30%; z-index: 2; pointer-events: none; mix-blend-mode: screen; opacity: 0.9;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 250, 244, 0.06) 46%, rgba(255, 250, 244, 0.11) 50%, rgba(255, 250, 244, 0.04) 54%, transparent 62%);
    transform: translate3d(calc(var(--lx) * 9%), calc(var(--ly) * 6%), 0); }
  /* where focus was pulled: a thin ring that closes in, the way a camera shows it */
  .dp-ring { position: absolute; z-index: 3; left: 0; top: 0; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 50%; pointer-events: none; opacity: 0;
    border: 1px solid color-mix(in srgb, var(--about) 85%, white); box-shadow: 0 0 10px color-mix(in srgb, var(--about) 50%, transparent); }
  .dp-ring.is-on { animation: dp-ring 900ms var(--ease-out) both; }
  @keyframes dp-ring { 0% { opacity: 0; scale: 1.7; } 25% { opacity: 1; } 55% { scale: 1; opacity: 1; } 100% { scale: 1; opacity: 0; } }
  .dp-hit { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: crosshair; touch-action: pan-y; -webkit-tap-highlight-color: transparent; }
  .dp-hit:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  /* the label, as a museum hangs one: title, place, what it is */
  .dp-label { position: relative; z-index: 1; margin: 22px 0 0; display: grid; gap: 3px; padding-left: 14px; border-left: 1px solid color-mix(in srgb, var(--tone) 55%, var(--rule)); max-width: 300px; }
  .dp-title { font: italic 400 17px/1.35 var(--f-read); color: var(--ink); text-wrap: pretty; }
  .dp-place { margin-top: 4px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-2); }
  .dp-tech { font: 400 12px/1.45 var(--f-ui); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .dp-hint { margin-top: 8px; font: 400 12px/1.4 var(--f-ui); color: var(--ink-3); }
  .h-touch { display: none; }
  @media not ((hover: hover) and (pointer: fine)) { .h-fine { display: none; } .h-touch { display: inline; } }
  :global(html:not(.js)) .dp-hint { display: none; }
  @media (prefers-reduced-motion: reduce) { .dp-ring.is-on { animation: none; } }
</style>
