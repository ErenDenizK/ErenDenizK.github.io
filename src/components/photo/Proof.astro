---
/* Concept 2, "Proof" (docs/research/2026-10-photo-presentation.md §3.2): a strip of medium-format slide
   film on a light table, the way a photographer chooses a frame. The strip runs across the margin; the
   chosen frame (the photograph) sits in the middle, its bracketed neighbours (a stop under, a stop over)
   fade out at either side, the film's edge print glows where the table's light comes through, and a
   grease-pencil mark goes round the pick. A loupe lies on the strip: with a mouse it follows the
   pointer over the frame; on a phone it is dragged by a finger (only the loupe takes the touch, the
   page still scrolls everywhere else). A tap on the frame enlarges it: it flies out of the strip to the
   middle of a darkened window, lit by its own colour, with its place and note under it.

   scripts/photos/proof.ts drives it. The loupe and the enlarged view use the whole photograph (never
   drawn larger than its pixels). Still twins: reduced motion or ?still keeps the loupe where it lies
   and opens the enlarged view with a crossfade; without JavaScript the strip stands with its caption. */
import Icon from '../Icon.astro';
import type { PhotoProps } from './types';
import { splitPlace, dims } from './types';
type Props = PhotoProps;
const p = Astro.props;
const [first, rest] = splitPlace(p.place);
const ratio = `${p.width} / ${p.height}`;
const no = 4 + p.index * 5;
const big = p.full ?? null;
const bigW = big?.width ?? p.width, bigH = big?.height ?? p.height;
/* the grease-pencil mark: a hand-drawn box that does not quite close (the frame's box is 0..100) */
const mark = 'M 3 -1.5 C 30 -3.5, 72 -2.2, 101.5 -0.6 C 103.4 30, 102.6 72, 101 101.8 C 70 103.6, 30 102.4, -1.4 101.2 C -3 70, -2.4 30, -0.8 1.6 C 1 -0.6, 6 -2.5, 12 -2.6';
---
<figure class="pf" data-proof style={`--ratio: ${ratio}; --tone: ${p.tone}; --small: url("${p.small}")`}>
  <div class="pf-table">
    <div class="pf-strip">
      <span class="pf-edge pf-edge--top" aria-hidden="true"><span>EDK 120</span><span class="pf-n">{no - 1}</span><span class="pf-n pf-n--pick">{no}</span><span class="pf-n">{no + 1}</span><span>EDK 120</span></span>
      <span class="pf-frame pf-frame--under" aria-hidden="true"></span>
      <span class="pf-frame pf-frame--pick">
        <picture class="pf-pic">
          <source type="image/avif" srcset={p.avif} sizes={p.sizes} />
          <img src={p.src} srcset={p.srcset} sizes={p.sizes} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" draggable="false" />
        </picture>
        <svg class="pf-mark" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={mark} pathLength="1" /></svg>
        <button class="pf-open" type="button" aria-haspopup="dialog" aria-label={`Enlarge the photograph: ${p.place}`}></button>
      </span>
      <span class="pf-frame pf-frame--over" aria-hidden="true"></span>
      <span class="pf-edge pf-edge--bottom" aria-hidden="true"><span class="pf-notch"></span><span>{no - 1}A</span><span>{no}A</span><span>{no + 1}A</span><span class="pf-notch"></span></span>
    </div>
    <span class="pf-loupe" aria-hidden="true">
      <span class="pf-caustic"></span>
      <span class="pf-lens">
        {big ? (
          <picture class="pf-mag"><source type="image/avif" srcset={big.avif} /><img src={big.webp} alt="" width={bigW} height={bigH} loading="lazy" decoding="async" draggable="false" /></picture>
        ) : (
          <picture class="pf-mag"><source type="image/avif" srcset={p.avif} sizes="1080px" /><img src={p.src} srcset={p.srcset} sizes="1080px" alt="" width={p.width} height={p.height} loading="lazy" decoding="async" draggable="false" /></picture>
        )}
      </span>
      <span class="pf-rim"></span>
    </span>
  </div>
  <figcaption class="pf-cap">
    <span class="pf-place"><span class="pf-no">{no}</span>{p.place}</span>
    <span class="pf-note">{p.note}</span>
    {p.hint && <span class="pf-hint" aria-hidden="true"><span class="h-fine">Move over the frame to look through the loupe; click to enlarge</span><span class="h-touch">Drag the loupe; tap the frame to enlarge</span></span>}
  </figcaption>
  <dialog class="pf-dlg" aria-label={p.place}>
    <div class="pf-dlg-in">
      <picture class="pf-dlg-pic">
        {big ? <source type="image/avif" srcset={big.avif} /> : <source type="image/avif" srcset={p.avif} sizes="1080px" />}
        <img src={big ? big.webp : p.src} alt={p.alt} width={bigW} height={bigH} decoding="async" loading="lazy" draggable="false" />
      </picture>
      <div class="pf-dlg-cap">
        <p class="pf-dlg-place">{first}{rest && <span>{rest}</span>}</p>
        <p class="pf-dlg-note">{p.note}</p>
        <p class="pf-dlg-meta"><span>Frame {no}</span><span>{dims(p.width, p.height)}</span></p>
      </div>
    </div>
    <button class="pf-close" type="button" aria-label="Close"><Icon name="close" size={20} /></button>
  </dialog>
</figure>

<style>
  /* The strip is as tall as the frame plus its edges; the frame is the margin's width, and the
     neighbours spill a little past it on either side, fading out (never past the window's edge). */
  .pf { --gap: 8px; --peek: clamp(4px, calc(var(--gut) - 14px), 44px); position: relative; margin: 0; width: 100%; max-width: 340px; container-type: inline-size; }
  .pf-table { position: relative; padding: 0; }
  /* the light table: a warm glow under the strip, softest at its ends */
  .pf-table::before {
    content: ""; position: absolute; z-index: 0; inset: -9% calc(-1 * var(--peek) - 6%) -9%; pointer-events: none; border-radius: 40px;
    background: radial-gradient(60% 52% at 50% 50%, rgba(255, 243, 228, 0.13), rgba(255, 236, 214, 0.04) 60%, transparent 78%);
  }
  .pf-strip {
    --edge: 6.5cqi;
    position: relative; z-index: 1; display: grid; grid-template-columns: var(--peek) minmax(0, 1fr) var(--peek); column-gap: var(--gap);
    grid-template-rows: var(--edge) auto var(--edge);
    margin: 0 calc(-1 * var(--peek) - var(--gap)); padding: 0;
    background: #050404;
    -webkit-mask: linear-gradient(90deg, transparent, #000 calc(var(--peek) + var(--gap)), #000 calc(100% - var(--peek) - var(--gap)), transparent);
    mask: linear-gradient(90deg, transparent, #000 calc(var(--peek) + var(--gap)), #000 calc(100% - var(--peek) - var(--gap)), transparent);
    box-shadow: 0 0 0 1px rgba(255, 240, 220, 0.05);
    rotate: -0.6deg;
  }
  .pf-frame { position: relative; grid-row: 2; aspect-ratio: var(--ratio); overflow: hidden; background: #000 var(--small) center / cover no-repeat; }
  /* bracketed: a stop under on the left, a stop over on the right; only their inner edges show */
  .pf-frame--under { grid-column: 1; filter: brightness(0.32) contrast(1.1) saturate(0.9); background-position: right center; aspect-ratio: auto; }
  .pf-frame--over { grid-column: 3; filter: brightness(1.75) contrast(0.7) saturate(0.7); background-position: left center; aspect-ratio: auto; }
  .pf-frame--pick { grid-column: 2; background: #000; overflow: visible; }
  .pf-pic, .pf-pic img { display: block; width: 100%; height: 100%; }
  .pf-pic img { object-fit: cover; }
  /* the edge print: light where the table shines through the film */
  .pf-edge {
    grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-around; padding: 0 calc(var(--peek) * 0.2);
    font: 600 max(7px, 2.2cqi)/1 var(--f-ui); letter-spacing: 0.14em; color: rgba(255, 214, 150, 0.62);
    text-shadow: 0 0 6px rgba(255, 196, 120, 0.45); white-space: nowrap; overflow: hidden;
  }
  .pf-edge--top { grid-row: 1; }
  .pf-edge--bottom { grid-row: 3; color: rgba(255, 214, 150, 0.4); }
  .pf-n { font-variant-numeric: tabular-nums; }
  .pf-n--pick { color: rgba(255, 232, 196, 0.95); }
  .pf-notch { width: 1.6cqi; height: 1.6cqi; border-radius: 50%; background: rgba(255, 240, 220, 0.55); box-shadow: 0 0 6px rgba(255, 236, 214, 0.6); }

  /* the pick: a grease-pencil box in the About gold, drawn when the strip comes into view */
  .pf-mark { position: absolute; inset: -5cqi -4.2cqi; width: calc(100% + 8.4cqi); height: calc(100% + 10cqi); rotate: 0.9deg; overflow: visible; pointer-events: none; z-index: 2; }
  .pf-mark path { fill: none; stroke: color-mix(in srgb, var(--about) 82%, #d94a2b); stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round; opacity: 0.88; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(html.js) .pf.is-live .pf-mark path { stroke-dashoffset: 1; transition: stroke-dashoffset 1100ms cubic-bezier(0.6, 0.05, 0.25, 1) 200ms; }
  :global(html.js) .pf.is-live.is-seen .pf-mark path { stroke-dashoffset: 0; }

  .pf-open { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .pf-open:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; }

  /* the loupe: a glass in a dark ring, lying on the strip; its lens shows the frame under it, larger */
  .pf-loupe {
    --d: clamp(108px, 42cqi, 148px);
    position: absolute; z-index: 4; left: 0; top: 0; width: var(--d); height: var(--d); border-radius: 50%;
    touch-action: none; cursor: grab; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; will-change: transform;
    display: none;
  }
  :global(html.js) .pf.is-live .pf-loupe { display: block; }
  .pf.is-follow .pf-loupe { pointer-events: none; cursor: none; }
  .pf.is-follow .pf-open { cursor: none; }
  .pf-lens { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: #070605; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6), inset 0 0 14px 2px rgba(0, 0, 0, 0.4); }
  .pf-mag { position: absolute; left: 0; top: 0; display: block; transform-origin: 0 0; will-change: transform; }
  .pf-mag img { display: block; width: 100%; height: 100%; filter: brightness(1.1) contrast(1.04) saturate(1.05); }
  .pf-lens::after { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background: radial-gradient(120% 90% at 30% 18%, rgba(255, 255, 255, 0.22), transparent 38%), radial-gradient(circle, transparent 62%, rgba(0, 0, 0, 0.42));
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.05), inset 0 0 0 4px rgba(150, 190, 255, 0.05), inset 0 0 0 5px rgba(255, 170, 110, 0.05); }
  .pf-rim { position: absolute; inset: -6px; border-radius: 50%; pointer-events: none;
    background: conic-gradient(from 200deg, #3a3631, #8a837a 10%, #2a2723 26%, #4f4a44 50%, #24211e 68%, #77706778 86%, #3a3631);
    -webkit-mask: radial-gradient(circle closest-side, transparent calc(100% - 6.5px), #000 calc(100% - 6px)); mask: radial-gradient(circle closest-side, transparent calc(100% - 6.5px), #000 calc(100% - 6px));
    box-shadow: 0 16px 28px -10px rgba(0, 0, 0, 0.8), 0 2px 5px rgba(0, 0, 0, 0.55); transition: box-shadow 260ms var(--ease-out); }
  /* a fine bright bevel on the ring's inner edge, where it meets the glass */
  .pf-rim::after { content: ""; position: absolute; inset: 5.5px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(255, 248, 238, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
  .pf.is-held .pf-rim { box-shadow: 0 26px 40px -10px rgba(0, 0, 0, 0.8), 0 4px 8px rgba(0, 0, 0, 0.5); }
  /* light gathered by the lens onto the table, a little off its centre */
  .pf-caustic { position: absolute; inset: -16%; border-radius: 50%; pointer-events: none; translate: 6% 10%; mix-blend-mode: screen;
    background: radial-gradient(circle, transparent 54%, rgba(255, 230, 190, 0.16) 58%, transparent 66%); }

  .pf-cap { margin-top: 26px; display: grid; gap: 4px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); }
  .pf-place { color: var(--ink-2); display: flex; gap: 10px; align-items: baseline; }
  .pf-no { font: 600 11px/1 var(--f-ui); letter-spacing: 0.12em; color: color-mix(in srgb, var(--about) 82%, #d94a2b); font-variant-numeric: tabular-nums; }
  .pf-note { display: none; }
  .h-touch { display: none; }
  @media not ((hover: hover) and (pointer: fine)) { .h-fine { display: none; } .h-touch { display: inline; } }
  :global(html:not(.js)) .pf-note { display: block; font: italic 400 17px/1.45 var(--f-read); color: var(--read); }
  :global(html:not(.js)) .pf-hint { display: none; }

  /* the enlarged view: the window goes dark, lit by the photograph's own colour */
  .pf-dlg { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--ink); overflow: hidden; }
  .pf-dlg::backdrop { background: rgba(4, 4, 5, 0); transition: background 420ms var(--ease-out); }
  .pf-dlg.is-open::backdrop { background: rgba(4, 4, 5, 0.94); }
  .pf-dlg::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 600ms var(--ease-out);
    background: radial-gradient(50% 60% at 50% 46%, color-mix(in srgb, var(--tone) 22%, transparent), transparent 70%); }
  .pf-dlg.is-open::before { opacity: 1; }
  .pf-dlg-in { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 22px; padding: 56px var(--gut) 28px; cursor: zoom-out; }
  .pf-dlg-pic { display: block; width: var(--w, 300px); aspect-ratio: var(--ratio); box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 245, 235, 0.06); transform-origin: 0 0; }
  .pf-dlg-pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pf-dlg-cap { width: var(--w, 300px); display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 24px; row-gap: 4px; opacity: 0; translate: 0 8px; transition: opacity 400ms var(--ease-out), translate 500ms var(--ease-out); }
  .pf-dlg.is-open .pf-dlg-cap { opacity: 1; translate: 0 0; transition-delay: 260ms; }
  .pf-dlg-place { font: 400 24px/1.15 var(--f-display); color: var(--ink); }
  .pf-dlg-place span { margin-left: 10px; font: 400 var(--t-meta)/1 var(--f-ui); color: var(--ink-3); letter-spacing: 0.02em; }
  .pf-dlg-note { grid-column: 1; font: italic 400 17px/1.4 var(--f-read); color: var(--read); }
  .pf-dlg-meta { grid-column: 2; grid-row: 1 / span 2; align-self: end; display: grid; justify-items: end; gap: 2px; font: 400 var(--t-meta)/1.3 var(--f-ui); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .pf-close { position: absolute; top: 14px; right: 14px; z-index: 2; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.06); color: var(--ink); cursor: pointer; opacity: 0; transition: opacity 300ms linear, background var(--d-2); }
  .pf-close:hover { background: rgba(255, 255, 255, 0.12); }
  .pf-close:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pf-dlg.is-open .pf-close { opacity: 1; }
  @media (max-width: 599.98px) {
    .pf-dlg-cap { grid-template-columns: minmax(0, 1fr); }
    .pf-dlg-meta { grid-column: 1; grid-row: auto; justify-items: start; display: flex; gap: 14px; margin-top: 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-dlg::backdrop, .pf-dlg::before, .pf-dlg-cap { transition-duration: 180ms; transition-delay: 0ms !important; translate: none; }
  }
</style>
