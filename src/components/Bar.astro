---
import Icon from './Icon.astro';
import { url } from '../lib/site';
interface Props { current: 'home' | 'work' | 'record' | 'about' | null; github: string; mark: string }
const { current, github, mark } = Astro.props;
const tabs = [['home', 'Home', ''], ['work', 'Work', 'work/'], ['record', 'Record', 'record/'], ['about', 'About', 'about/']] as const;
---
<header class="bar" id="bar">
  <a class="mark" href={url()} aria-label={`${mark}, home`}>{mark}<i class="dot" aria-hidden="true"></i></a>
  <nav class="tabs" aria-label="Primary">
    {tabs.map(([key, label, path]) => (
      <a href={url(path)} data-tab={key} aria-current={current === key ? 'page' : undefined}>
        {current === key && <span class="ind" aria-hidden="true"></span>}{label}
      </a>
    ))}
  </nav>
  <div class="bar-end">
    <p class="clock" data-clock><span class="vh">Local time in </span>Istanbul <time></time></p>
    {/* the time in Istanbul, written before first paint (scripts/clock.ts keeps it ticking; same format) */}
    <script is:inline>(function(){try{var t=document.currentScript.previousElementSibling.querySelector('time'),s=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZone:'Europe/Istanbul'}).format(new Date());t.textContent=s;t.dateTime=s;}catch(e){}})();</script>
    <a href={github} rel="me"><Icon name="github" />GitHub</a>
  </div>
</header>
