---
/* A postcard (brief §7, 2026-10-09: "postcards (hover, flip)"; ADR-0008, amendment of 2026-10-11 "postcards
   through the page"). The owner (2026-10-11): "postcards should not be gathered in one place: spread
   them through the page; design the back more elegantly; switching and turning by buttons is bad:
   more interactivity by tapping and clicking". So each postcard stands on its own beside the chapter it
   belongs to, and is handled directly (scripts/postcard.ts): a tap or click turns it over, a mouse can
   pick it up and toss it a little (it springs back to where it lay), and a sheen follows the pointer.
   The face is the button: Enter or Space turns it, and focus follows to the other side.

   Front: the photograph, nearly full bleed, on a hairline of the same card stock as the back.
   Back: a divided back, as real postcards have had since 1907: the message on the left in a written
   italic, the address side on the right with a perforated stamp cut from the same photograph, a postmark
   ringing the place (and the date, only when it is known) and the place written out on ruled lines. A
   credit runs up the dividing line. Warm, laid card stock made in CSS; the About gold only in the
   postmark's ink.

   Still twins: reduced motion or ?still turns it with a crossfade; without JavaScript the front stands
   with its place and note under it (the back is not shown).

   <Postcard src={webp} avif={avifSrcset} srcset={webpSrcset} width={1500} height={2000}
             alt="..." note="..." place="YTÜ, Istanbul" rest={-2} /> */
import { getSite, dayMonYear } from '../lib/site';

interface Props {
  src: string;
  srcset?: string;
  avif?: string;
  sizes?: string;
  width: number;
  height: number;
  alt: string;
  note: string;
  /** "Bostancı, Istanbul": each comma-separated part is one written line of the address */
  place: string;
  /** left out when the date is not known: the postmark and the address then carry the place alone */
  date?: Date | string;
  /** signature under the note; the owner's first name by default */
  from?: string;
  /** ink of the postmark; the About gold by default */
  accent?: string;
  /** the angle it lies at on the page, in degrees */
  rest?: number;
  /** show the "tap / click to turn it over" line under this one */
  hint?: boolean;
  class?: string;
}
const site = await getSite();
const t = site.about.postcard;
const { src, srcset, avif, sizes = '(min-width: 900px) 340px, 86vw', width, height, alt, note, place, date, from = site.firstName, accent, rest = 0, hint = false, class: cls } = Astro.props;
const when = date === undefined ? '' : typeof date === 'string' ? date : dayMonYear(date);
const lines = [...place.split(',').map((s) => s.trim()).filter(Boolean), ...(when ? [when] : [])];
while (lines.length < 4) lines.push('');
/* a stable id for the postmark's text path (same input, same markup) */
let h = 0;
for (const ch of `${src}|${place}|${when}|${note}`) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const pid = `pc-ring-${h.toString(36)}`;
/* the postmark's ring: place and date repeated until they go round once */
const unit = (when ? `${place} · ${when} · ` : `${place} · `).toUpperCase();
const ring = unit.repeat(Math.max(1, Math.ceil(34 / unit.length)));
const style = [`--pc-ratio: ${width} / ${height}`, `--pc-rest: ${rest}deg`, accent ? `--pc-ink: ${accent}` : ''].filter(Boolean).join('; ');
const name = `${t.of} ${place}`;
---
<figure class:list={['pc', cls]} data-postcard style={style}>
  <div class="pc-stage">
    <div class="pc-card" data-card-body>
      <div class="pc-face pc-front" data-face>
        <button class="pc-turn" type="button" data-turn aria-label={`${name}. ${t.turn}`}></button>
        <picture class="pc-photo">
          {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
          <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={width} height={height} loading="lazy" decoding="async" draggable="false" />
        </picture>
        <span class="pc-sheen" aria-hidden="true"></span>
      </div>
      <div class="pc-face pc-back" data-face>
        <button class="pc-turn" type="button" data-turn aria-label={`${name}, the back. ${t.back}`}></button>
        <p class="pc-head" aria-hidden="true">{t.head}</p>
        <div class="pc-msg">
          <p class="pc-note">{note}</p>
          <p class="pc-from">{from}</p>
        </div>
        <p class="pc-credit" aria-hidden="true">{t.credit} {site.name}</p>
        <div class="pc-addr-side">
          <div class="pc-stamp" aria-hidden="true">
            <span class="pc-stamp-img" style={`background-image: url("${src}")`}></span>
            <span class="pc-stamp-mark">{site.mark}</span>
          </div>
          <svg class="pc-postmark" viewBox="0 0 150 80" aria-hidden="true" focusable="false">
            <defs><path id={pid} d="M 40 40 m -27 0 a 27 27 0 1 1 54 0 a 27 27 0 1 1 -54 0" /></defs>
            <circle cx="40" cy="40" r="34" />
            <circle cx="40" cy="40" r="20.5" />
            <text><textPath href={`#${pid}`} startOffset="0" textLength="168" lengthAdjust="spacing">{ring}</textPath></text>
            <path d="M 34 37 h 12 M 34 43 h 12" />
            <path d="M 78 26 c 9 -5 15 5 24 0 s 15 5 24 0 s 15 5 22 1" />
            <path d="M 80 38 c 9 -5 15 5 24 0 s 15 5 24 0 s 15 5 22 1" />
            <path d="M 78 50 c 9 -5 15 5 24 0 s 15 5 24 0 s 15 5 22 1" />
          </svg>
          <ul class="pc-addr">
            {lines.map((l) => <li>{l}</li>)}
          </ul>
        </div>
        <span class="pc-sheen" aria-hidden="true"></span>
      </div>
    </div>
  </div>
  <figcaption class="pc-cap">
    <span class="pc-place">{place}</span>
    <span class="pc-cap-note">{note}</span>
    {hint && <span class="pc-hint" aria-hidden="true"><span class="h-fine">{t.hint.fine}</span><span class="h-touch">{t.hint.touch}</span></span>}
  </figcaption>
</figure>

<script>
  import { initPostcards } from '../scripts/postcard';
  initPostcards();
</script>

<style>
  /* Sizes are fractions of the card's width (container units on .pc-stage). */
  .pc {
    --pc-ink: var(--about);
    --paper: #e9e2d4;
    --paper-ink: #3a322a;
    --hand: #23304a;   /* blue-black, the colour of a fountain pen's ink */
    --lift: 0;
    position: relative; margin: 0; width: 100%;
  }
  .pc-stage { position: relative; container-type: inline-size; perspective: 1500px; rotate: var(--pc-rest); user-select: none; -webkit-user-select: none; }
  .pc-card { position: relative; display: grid; transform-style: preserve-3d; --gx: 50%; --gy: 30%; --sheen: 0; }
  .pc-face {
    grid-area: 1 / 1; position: relative; aspect-ratio: var(--pc-ratio, 3 / 4);
    border-radius: 1.2cqi; overflow: hidden; background: var(--paper);
    box-shadow:
      0 calc(1.2cqi + var(--lift) * 5cqi) calc(3cqi + var(--lift) * 8cqi) calc(-1.2cqi - var(--lift) * 1cqi) rgba(0, 0, 0, calc(0.62 + var(--lift) * 0.12)),
      0 0.3cqi 0.8cqi rgba(0, 0, 0, 0.35);
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  /* the back starts hidden; the script (or the crossfade) shows it once the card is turned */
  .pc-back { transform: rotateY(180deg); opacity: 0; }
  .is-flipped .pc-back { opacity: 1; }
  .pc-face[inert] { pointer-events: none; }

  .pc-turn { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; padding: 0; border: 0; border-radius: inherit; background: transparent; cursor: pointer; touch-action: manipulation; }
  .pc-turn:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  :global(.fine) .pc.is-live .pc-turn { cursor: grab; }
  :global(.fine) .pc.is-held .pc-turn { cursor: grabbing; }

  /* front: the photograph on a hairline of card stock */
  .pc-photo { position: absolute; inset: 1.1cqi; display: block; }
  .pc-photo img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0.5cqi; }

  /* a sheen that follows the pointer: a soft light where it is and a faint band across the card */
  .pc-sheen {
    position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: var(--sheen); mix-blend-mode: soft-light;
    background:
      radial-gradient(circle at var(--gx) var(--gy), rgba(255, 250, 240, 0.75), rgba(255, 250, 240, 0.12) 32%, transparent 58%),
      linear-gradient(calc(110deg + (var(--gx) - 50%) * 0.4), transparent 30%, rgba(255, 252, 245, 0.22) 46%, transparent 62%);
  }
  .pc-front .pc-sheen { mix-blend-mode: screen; opacity: calc(var(--sheen) * 0.55); }

  /* ---- back: laid card stock, lit from the upper left, a little darker toward its edges ---- */
  .pc-back {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr);
    column-gap: 7cqi; padding: 6.5cqi 6cqi 7cqi 6.5cqi; color: var(--paper-ink);
    background:
      radial-gradient(130% 90% at 12% 0%, rgba(255, 253, 248, 0.5), transparent 60%),
      radial-gradient(150% 120% at 50% 45%, transparent 55%, rgba(110, 86, 52, 0.16)),
      repeating-linear-gradient(0deg, rgba(92, 72, 44, 0.022) 0 1px, transparent 1px 3px),
      var(--paper);
  }
  .pc-back::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.22; mix-blend-mode: multiply; background: url("../assets/photos/grain.png") 0 0 / 110px repeat; }
  /* the dividing line, with the credit running up it */
  .pc-back::before { content: ""; position: absolute; left: 50%; top: 21%; bottom: 7%; width: 1px; background: linear-gradient(rgba(58, 50, 42, 0.32), rgba(58, 50, 42, 0.32)) 0 0 / 1px 100% no-repeat; }
  .pc-credit {
    position: absolute; left: 50%; bottom: 9%; translate: -50% 0; writing-mode: vertical-rl; rotate: 180deg;
    padding: 2cqw 0; background: var(--paper); z-index: 0;
    font: 500 max(6.5px, 1.55cqw)/1 var(--f-ui); letter-spacing: 0.18em; text-transform: uppercase; color: rgba(58, 50, 42, 0.73); white-space: nowrap;  /* 4.7:1 on the paper (npm run palette); 0.55 was 2.98:1 */
  }
  .pc-head {
    grid-column: 1; grid-row: 1; align-self: start;
    font: 500 max(8px, 2.3cqi)/1 var(--f-ui); letter-spacing: 0.42em; text-transform: uppercase; color: rgba(58, 50, 42, 0.72);
    padding-bottom: 2.2cqi; border-bottom: 1px solid rgba(58, 50, 42, 0.32); margin-top: 1cqi;
  }
  .pc-msg { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; gap: 5cqi; padding-top: 11cqi; }
  /* the note in a written italic (the system's calligraphic italic where there is one), slightly off level */
  .pc-note {
    font: italic 400 max(13px, 5.6cqi)/1.4 "Palatino Linotype", Palatino, "Book Antiqua", "URW Palladio L", P052, Georgia, var(--f-read);
    color: var(--hand); text-wrap: pretty; rotate: -1.2deg; transform-origin: 0 0; overflow-wrap: anywhere;
  }
  .pc-from { align-self: flex-end; margin-right: 2cqi; font: italic 400 max(13px, 5.6cqi)/1 "Palatino Linotype", Palatino, "Book Antiqua", "URW Palladio L", P052, Georgia, var(--f-read); color: var(--hand); rotate: -3deg; }
  .pc-from::before { content: ""; display: inline-block; width: 4cqi; height: 1px; margin-right: 1.4cqi; vertical-align: 0.3em; background: currentColor; opacity: 0.7; }

  .pc-addr-side { grid-column: 2; grid-row: 1 / span 2; position: relative; display: flex; flex-direction: column; min-height: 0; }
  /* the stamp: cut from the same photograph, perforated, on a white margin with a fine frame */
  .pc-stamp {
    --r: 0.7cqi;
    align-self: flex-end; width: 19cqi; aspect-ratio: 5 / 6; padding: var(--r); margin-top: 0.5cqi; background: #faf7f0;
    -webkit-mask: radial-gradient(var(--r) at var(--r) var(--r), #0000 97%, #000) calc(-1 * var(--r)) calc(-1 * var(--r)) / calc(2 * var(--r)) calc(2 * var(--r)) round, linear-gradient(#000 0 0) content-box;
    mask: radial-gradient(var(--r) at var(--r) var(--r), #0000 97%, #000) calc(-1 * var(--r)) calc(-1 * var(--r)) / calc(2 * var(--r)) calc(2 * var(--r)) round, linear-gradient(#000 0 0) content-box;
    display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 0.6cqi;
    rotate: 2deg; filter: drop-shadow(0 0.2cqi 0.3cqi rgba(60, 40, 20, 0.25));
  }
  .pc-stamp-img { display: block; margin: 1.1cqi 1.1cqi 0; background-size: cover; background-position: 50% 45%; box-shadow: 0 0 0 0.25cqi #faf7f0, 0 0 0 calc(0.25cqi + 1px) rgba(58, 50, 42, 0.4); filter: saturate(0.85) contrast(1.04); }
  .pc-stamp-mark { padding-bottom: 0.9cqi; font: 500 max(6px, 1.9cqi)/1 var(--f-display); letter-spacing: 0.04em; color: rgba(58, 50, 42, 0.8); text-align: center; }
  .pc-postmark {
    position: absolute; top: 12cqi; right: 6cqi; width: 40cqi; overflow: visible; rotate: -10deg; pointer-events: none;
    fill: none; stroke: color-mix(in srgb, var(--pc-ink) 52%, #4a3420); stroke-width: 1.05; opacity: 0.78; mix-blend-mode: multiply;
  }
  .pc-postmark text { fill: color-mix(in srgb, var(--pc-ink) 52%, #4a3420); stroke: none; font: 600 6.2px/1 var(--f-ui); letter-spacing: 0.06em; }
  /* the address side: ruled lines, the place written on them */
  .pc-addr { margin: auto 0 0; padding: 0; list-style: none; }
  .pc-addr li {
    height: 9cqi; display: flex; align-items: flex-end; padding: 0 0 0.9cqi 1cqi; border-bottom: 1px solid rgba(58, 50, 42, 0.34);
    font: italic 400 max(12px, 4.6cqi)/1 "Palatino Linotype", Palatino, "Book Antiqua", "URW Palladio L", P052, Georgia, var(--f-read); color: var(--hand);
    white-space: nowrap; overflow: hidden;
  }
  .pc-addr li:nth-child(2) { padding-left: 4cqi; }

  /* the caption under the card: the place, and on the first one how to use it */
  .pc-cap { margin-top: 16px; display: grid; gap: 4px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); }
  .pc-place { color: var(--ink-2); }
  .pc-cap-note { display: none; }
  .h-touch { display: none; }
  @media not ((hover: hover) and (pointer: fine)) { .h-fine { display: none; } .h-touch { display: inline; } }

  /* still (reduced motion or ?still): the turn is a crossfade */
  .pc.is-still .pc-face { backface-visibility: visible; transition: opacity 180ms linear; }
  .pc.is-still .pc-back { transform: none; }
  .pc.is-still.is-flipped .pc-front { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .pc-card { transform: none !important; }
    .pc-face { backface-visibility: visible; transition: opacity 180ms linear; }
    .pc-back { transform: none; }
    .is-flipped .pc-front { opacity: 0; }
  }

  /* without JavaScript: the front, with its place and note under it */
  :global(html:not(.js)) .pc-back { display: none; }
  :global(html:not(.js)) .pc-turn { display: none; }
  :global(html:not(.js)) .pc-cap-note { display: block; font: italic 400 17px/1.45 var(--f-read); color: var(--read); }
  :global(html:not(.js)) .pc-hint { display: none; }
</style>
