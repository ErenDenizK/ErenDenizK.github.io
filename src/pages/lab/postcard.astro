---
/* A hidden workbench for the Postcard component (ADR-0008): not linked from anywhere, noindex, and left
   out of the sitemap (astro.config.mjs). Photo entries in the record will use the component when the
   owner sends photographs for them. The notes below are placeholders for the demo, not claims. */
import Base from '../../layouts/Base.astro';
import Postcard from '../../components/Postcard.astro';
import gateA from '../../assets/photos/gate-card-960.avif?url';
import gateW from '../../assets/photos/gate-card-960.webp?url';
import lensA from '../../assets/photos/pc-park-through-lens-760.avif?url';
import lensW from '../../assets/photos/pc-park-through-lens-760.webp?url';
---
<Base title="Postcard" tab={null} description="A workbench for the postcard component." noindex>
  <div class="inner lab">
    <header class="vhead">
      <p class="meta">Lab · not linked from the site</p>
      <h1 class="vtitle">Postcard</h1>
    </header>
    <div class="lab-row">
      <Postcard src={gateW} avif={`${gateA} 960w`} width={960} height={960} alt="A selfie at the YTU gate on a rainy day." note="Sample note: a line or two about the photograph, written on the back." place="Istanbul" date={new Date('2026-10-09')} />
      <Postcard src={lensW} avif={`${lensA} 760w`} width={760} height={1013} alt="The university's inner courtyard seen through a tinted lens." note="Sample note for a portrait photograph." place="YTU" date="Oct 2026" accent="var(--log)" />
    </div>
  </div>
</Base>
<style>
  .lab { padding: 0 var(--gut) 120px; }
  .lab-row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 64px; align-items: start; }
  @media (max-width: 899.98px) { .lab-row { grid-template-columns: 1fr; gap: 48px; } }
</style>
