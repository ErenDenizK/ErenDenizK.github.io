---
/* Home, direction B: the living editorial index (docs/research/2026-10-home-b.md). A lab page, unlinked and
   noindex, so the owner can compare it with the live Home (direction A); everything here would move to
   index.astro unchanged if B were chosen.
   Typography and life are the hero. The name is set monumentally in the display face and composes
   itself on load (CSS only: each letter settles on the object spring, the initials e, d, k light in
   turn and the dot after the name lights last, echoing the mark). Around it the page is an index of
   the maker that is alive: Istanbul's sky follows the sun, the latest record entry says how long ago
   it was written, and a light follows the pointer (or the finger, or drifts on its own) and colours
   the letters it passes. The dot is the one signature control: it changes the light of the whole
   site (the mark's dot and the tab light follow, --accent). Then the products as plates with their
   real screens and glass objects, the record as a year strip, and a sign-off.
   Still twins: without JavaScript every element is in its final place (the composition is CSS) and
   the sky is a neutral dusk; reduced motion and ?still skip the composition and the light stands still.
   Kept from the Home before (tests rest on them): the edk stage (slot "home"), the lead project's
   object in slot "showcase", one `a.p-open[data-p]` per project (ADR-0007 item 4), no rail sections. */
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import Thumb from '../../components/Thumb.astro';
import Foot from '../../components/Foot.astro';
import Wordmark from '../../components/Wordmark.astro';
import { Picture } from 'astro:assets';
import '../../styles/home-b.css';
import { getWorld, reelSteps, type Shot } from '../../lib/world';
import { getSite, getProjects, getLog, url, projectPath, entryPath, entryTitle, dayMon, dayMonYear, iso, isPlaceholder, leadProject, statusLine, projectColor, entryProjects, entryColors, yearStrip, entryYear, rowShape } from '../../lib/site';

const site = await getSite();
const log = await getLog();
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const lead = leadProject(projects, log);
/* the lead first, then the rest in their order */
const ordered = [lead, ...projects.filter((p) => p !== lead)];
const H = site.homeB;
const k = site.kicker;
const ix = H.index;

/* ---- the name, split into letters at build: each word an unbreakable box, each letter a span with its
   index (the stagger), the first letter of each word an initial (e, d, k) ---- */
type Ch = { c: string; i: number; ini: boolean };
let n = 0;
const lines = site.nameLines.map((line) => line.split(' ').map((w) => [...w].map((c, j) => ({ c, i: n++, ini: j === 0 }) as Ch)));
const letters = n;

/* ---- each product's screens on its plate, from its reel (content is data): a phone-first product shows
   its phone screens fanned, a wide one its first two wide screens, one behind the other ---- */
type Plate = { phones: Shot[]; wides: Shot[] };
const plates = new Map<string, Plate>();
for (const p of ordered) {
  const steps = reelSteps(p.id, await getWorld(p.id), p.data);
  const phones = steps.map((s) => s.phone).filter((s): s is Shot => !!s).slice(0, 3);
  const wides = phones.length ? [] : steps.filter((s) => !s.clip).map((s) => s.main).slice(0, 2);
  plates.set(p.id, { phones, wides });
}
const host = (p: (typeof projects)[number]) => p.data.links.find((l) => l.kind === 'live')?.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const pvars = (p: (typeof projects)[number]) => {
  const a = p.data.accent;
  return [`--p: ${a.color}`, `--pg: ${a.glow ?? a.color}`, a.p2 && `--p2: ${a.p2}`, a.p3 && `--p3: ${a.p3}`].filter(Boolean).join('; ');
};

/* ---- the record: the latest entry, the newest few, and the year as a strip ---- */
const latest = log[0];
const recent = log.slice(0, 4);
const year = latest ? entryYear(latest) : String(new Date().getUTCFullYear());
const months = yearStrip(year, log, projects);
const first = log.length ? log[log.length - 1] : null;
const excerpt = (e: (typeof log)[number]) => {
  if (e.data.title) return e.data.title;
  const t = (e.body ?? '').replace(/\s+/g, ' ').trim();
  return t.length > 96 ? t.slice(0, t.lastIndexOf(' ', 92)) + '…' : t;
};
const latestProject = latest ? entryProjects(latest, projects)[0] : null;

/* the light's colours, in the dot's order: edk, each product, the record, about */
const lights = ['var(--edk)', ...ordered.map(projectColor), 'var(--log)', 'var(--about)'];
const two = (x: number) => String(x).padStart(2, '0');
---
<Base title="Home, direction B" tab={null} accent="var(--edk)" description="Direction B of Home: the living editorial index (a prototype)." noindex pageClass="page-homeb">
  <script is:inline>
    /* Before the hero paints: the composition plays once per visit (a second Home in the same tab
       arrives composed), and never with ?still. */
    (function () { var d = document.documentElement; try { if (/[?&]still/.test(location.search) || sessionStorage.getItem('edk-home-b')) d.classList.add('hb-seen'); sessionStorage.setItem('edk-home-b', '1'); } catch (e) {} })();
  </script>
  <div class="hb-ground" aria-hidden="true">
    <div class="hb-sky"></div>
    <div class="hb-field"></div>
  </div>

  <section class="hb-hero" aria-labelledby="h-home" data-lights={lights.join('|')} data-light-label={ix.light} data-light-hint={ix.lightHint} data-sky-words={JSON.stringify(H.sky)}>
    <div class="hb-top">
      <p class="meta hb-kicker">{k.study} · <span class="lg">{k.school}</span><abbr class="sm" title={k.school}>{k.schoolShort}</abbr> · {k.year}</p>
      <p class="meta hb-skyline" data-skyline>
        <span class="hb-arc" aria-hidden="true"><i class="hb-sun"></i></span>
        <span class="hb-sky-t"><b data-phase>{H.sky.place}</b><span data-sun></span></span>
      </p>
    </div>

    <div class="hb-stage">
      <h1 class="hb-name" id="h-home" style={`--n: ${letters}`}>
        <span class="vh">{site.name}</span>
        <span class="hb-sweep-g" aria-hidden="true"></span>
        <span class="hb-letters" aria-hidden="true">
          {lines.map((words, li) => (
            <span class={`hb-line hb-l${li + 1}`}>
              {words.map((w) => (
                <span class="hb-w">{w.map((ch) => <span class:list={['ch', { ini: ch.ini }]} style={`--i: ${ch.i}; --r: ${((ch.i * 37) % 11) - 5}`}>{ch.ini ? <><span class="uc">{ch.c}</span><b class="lc">{ch.c.toLocaleLowerCase('en')}</b></> : ch.c}</span>)}</span>
              ))}
              {li === lines.length - 1 && <span class="hb-dot"><i></i></span>}
            </span>
          ))}
        </span>
        <span class="hb-lens" aria-hidden="true"></span>
        <span class="hb-sweep" aria-hidden="true"></span>
      </h1>
      <Media obj="edk" slot="home" stage priority class="hb-obj" sizes="(min-width: 900px) 440px, 58vw" />
    </div>

    <div class="hb-row">
      <div class="hb-vision">
        <p class="hb-v" data-draft={H.vision.draft ? '' : undefined}>{H.vision.text}</p>
        <div class="links">
          <a class="btn" href={url('work/')}>See the work <Icon name="arrow-right" weight="medium" /></a>
          <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
          {!isPlaceholder(site.links.linkedin) && <a class="qlink" href={site.links.linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        </div>
      </div>
      <div class="hb-now">
        <p class="meta hb-now-k"><span class="hb-pulse" aria-hidden="true"></span>{site.now.label}</p>
        <p class="hb-now-t">{site.now.text}</p>
        {latest && (
          <a class="hb-latest" href={url(entryPath(latest))} style={`--c: ${entryColors(latest, projects)[0]}`}>
            <span class="meta hb-latest-k">{ix.latest} · <time datetime={iso(latest.data.date)} data-ago>{dayMon(latest.data.date)}</time>{latestProject && <> · {latestProject.data.title}</>}</span>
            <span class="hb-latest-t">{excerpt(latest)}</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="hb-show" aria-labelledby="h-work" data-sheet-host data-acts={ordered.length} style={`--acts: ${ordered.length}`}>
    <div class="hb-show-stage">
      <div class="hb-show-light" aria-hidden="true"></div>
      <header class="hb-show-head">
        <h2 class="meta" id="h-work"><span class="hb-pulse" aria-hidden="true"></span>{ix.now}</h2>
        <ol class="hb-index">
          {ordered.map((p, i) => (
            <li style={pvars(p)} class:list={{ on: i === 0 }}>
              <a class="p-open" href={url(projectPath(p))} data-p={p.id} data-title={p.data.title}>
                <span class="hb-ix-n">{two(i + 1)}</span><span class="hb-ix-t">{p.data.title}</span><span class="hb-ix-bar" aria-hidden="true"><i></i></span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more" href={url('work/')}>{H.showcase.all} <Icon name="arrow-right" /></a>
      </header>
      {ordered.map((p, i) => {
        const d = p.data;
        const pl = plates.get(p.id)!;
        const isLead = p === lead;
        const kind = pl.phones.length ? 'phones' : pl.wides.length ? 'wide' : 'object';
        return (
          <article class:list={['hb-act', `hb-${kind}`, { 'is-on': i === 0, 'is-lead': isLead }]} data-act={i} data-plate={p.id} data-light={projectColor(p)} style={`${pvars(p)}; --wl: ${(d.wordmark?.text ?? d.title).length + (d.wordmark?.dot ? 1 : 0)}`} aria-labelledby={`hb-t-${p.id}`}>
            <div class="hb-act-text">
              <p class="meta hb-pk"><span>{two(i + 1)} / {two(ordered.length)}</span>{isLead && <span class="hb-lead-k"><Icon name="dot" />{H.showcase.kicker}</span>}<span>{statusLine(p)}{d.statusNote && ` · ${d.statusNote}`}</span></p>
              <h3 class="hb-pt" id={`hb-t-${p.id}`}><a class="p-open hb-plink" href={url(projectPath(p))} data-p={p.id} data-title={d.title} data-ptitle={`hb-wm-${p.id}`}><Wordmark project={p} id={`hb-wm-${p.id}`} /></a></h3>
              <p class="hb-pitch">{d.summary}</p>
              {!!d.what.numbers?.length && (
                <dl class="hb-nums">{d.what.numbers.map((x) => <div><dt class="meta">{x.label}</dt><dd>{x.value}</dd></div>)}</dl>
              )}
              <a class="btn tint hb-cta" href={url(projectPath(p))} tabindex="-1" aria-hidden="true">{H.showcase.cta} <Icon name="arrow-right" weight="medium" /></a>
            </div>
            <div class="hb-pic" data-tilt>
              {kind === 'wide' && (
                <div class="hb-screens">
                  {pl.wides.map((s, j) => (
                    <figure class={`hb-web hb-web-${j}`}>
                      <div class="hb-web-bar" aria-hidden="true"><span class="hb-dots"><i></i><i></i><i></i></span>{j === 0 && host(p) && <span class="hb-url">{host(p)}</span>}</div>
                      <Picture src={s.img} alt={j === 0 ? s.alt : ''} widths={[720, 1080, 1440, 2048].filter((w) => w <= s.img.width)} sizes="(min-width: 900px) 66vw, 120vw" formats={['avif', 'webp']} quality={62} loading="lazy" decoding="async" />
                    </figure>
                  ))}
                </div>
              )}
              {kind === 'phones' && (
                <div class="hb-fan">
                  {pl.phones.map((s, j) => (
                    <figure class="hb-phone" style={`--j: ${j - (pl.phones.length - 1) / 2}; --a: ${Math.abs(j - (pl.phones.length - 1) / 2)}`}>
                      <Picture src={s.img} alt={s.alt} widths={[390, 600].filter((w) => w <= s.img.width)} sizes="(min-width: 900px) 220px, 36vw" formats={['avif', 'webp']} quality={70} loading="lazy" decoding="async" />
                    </figure>
                  ))}
                </div>
              )}
              {isLead
                ? <Media obj={d.object} slot="showcase" class="hb-pobj" light={d.accent.glow ?? d.accent.color} sizes="(min-width: 900px) 340px, 50vw" />
                : <span class="hb-thumb" aria-hidden="true"><Thumb obj={d.object} size={kind === 'object' ? 560 : 180} class="hb-th" /></span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="hb-record" aria-labelledby="h-record">
    <header class="hb-head">
      <h2 id="h-record">{ix.record}</h2>
      <p class="hb-dek">{ix.recordDek}</p>
      <a class="more" href={url('record/')}>{ix.open} <Icon name="arrow-right" /></a>
    </header>
    {log.length > 0 ? (
      <div class="hb-rec">
        <div class="hb-year">
          <p class="hb-count"><b>{log.length}</b> <span class="meta">{ix.entries}{first && <> · {ix.since} {dayMonYear(first.data.date)}</>}</span></p>
          <div class="hb-strip" role="group" aria-label={`${year}, month by month`}>
            {months.map((m) => {
              const body = (<><span class="hb-ticks">{m.ticks.slice(0, 8).map((t) => <i class={`t-${t.shape}`} style={`--c: ${t.color}`} />)}</span><span class="hb-m">{m.label}</span></>);
              return m.first
                ? <a class="hb-mo on" href={url('record/') + '#' + m.first} aria-label={`${m.long} ${year}: ${m.ticks.length} ${m.ticks.length === 1 ? 'entry' : 'entries'}`}>{body}</a>
                : <span class="hb-mo" aria-hidden="true">{body}</span>;
            })}
          </div>
        </div>
        <ol class="hb-list">
          {recent.map((e) => (
            <li style={`--c: ${entryColors(e, projects)[0]}`}>
              <a href={url(entryPath(e))}>
                <span class="meta hb-ld"><time datetime={iso(e.data.date)}>{dayMon(e.data.date)}</time></span>
                <span class="hb-lt">{rowShape(e) === 'release' ? `${entryProjects(e, projects)[0]?.data.title ?? ''} ${e.data.version}` : excerpt(e)}</span>
                <span class="meta hb-lm">{entryProjects(e, projects).map((x) => x.data.title).join(' · ') || entryTitle(e).split(',')[0]}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <p class="log-empty-line">{site.log.empty} <a href={url('record/')}>{ix.record}</a></p>
    )}
  </section>

  <section class="hb-sign" aria-label={ix.elsewhere}>
    <p class="hb-mark" aria-hidden="true">{site.mark}<i></i></p>
    <div class="hb-sign-t">
      <p class="meta">{ix.elsewhere}</p>
      <p class="hb-else">
        <a href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
        {!isPlaceholder(site.links.linkedin) && <a href={site.links.linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        <a href={url('about/')}>About <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>
  <div class="inner"><Foot /></div>
</Base>
<script>import '../../scripts/home-b';</script>
