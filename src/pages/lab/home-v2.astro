---
/* Home prototype V2 "Strips" (Phase 2 Home plan, section 3, V2; it learns from Emil Kowalski's labelled
   sections and Louis Paquet's label column). A hidden workbench: noindex, not linked from anywhere, and
   left out of the sitemap (astro.config.mjs filters /lab/). The live Home (src/pages/index.astro) is not
   changed. Every fact comes from content/ (site.json, the projects, the record); a line whose wording or
   label is the planner's draft carries data-draft and an HTML comment that says "DRAFT".

   Layout: one column of at most 680 px on the content edge (E0). From 768 px every strip is a row: a
   152 px label column, a 24 px gap and the content. Below 768 px the label sits above its content, so a
   phone never sets text beside anything. Gaps between strips: 64 px, and 96 px from 1180 px
   (charter section 3.3). Sizes: the name 26/31/33 px at 390/1180/1440 (ADR-0015 step t-3, under the
   provisional Home cap of 34/45/48), wordmarks 22/25/26 (t-2), body 16/17, labels 13.

   Arrival (plan V2 table): six steps, 70 ms apart, 400 ms each, rising at most 12 px; the first row's
   screen scales from 0.985 over 480 ms; the rest arrive with the last step; settled by 830 ms. The
   classes are set before first paint by the inline script below; CSS runs the steps by itself, so text
   is in the HTML and readable from the first frame. Without JavaScript, with ?still and under reduced
   motion nothing is hidden and nothing moves.

   Isolation rule (media research section 3.1): an element that fades or moves forms a group, and a
   ground-subtracted object (plus-lighter) inside such a group would show its black square. So only
   text, real screens and Eat Map's tile (which paints its own dark ground) are animated; the edk mark
   fades on its own image, and the live object fades on its own .m-stage.

   Lab switches (the panel after the foot writes them; each also works typed into the address):
   ?obj=none|mark|small, ?t=charter|anthony, ?reveal=scroll, ?draft=1, ?samples=0, ?align=center, ?still. */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Thumb from '../../components/Thumb.astro';
import Icon from '../../components/Icon.astro';
import Foot from '../../components/Foot.astro';
import Wordmark from '../../components/Wordmark.astro';
import { getWorld, shot, type Shot } from '../../lib/world';
import { getSite, getProjects, getLog, url, projectPath, entryPath, entryTitle, dayMonYear, iso, isPlaceholder, statusLine, inkVars, type LogEntry } from '../../lib/site';
import '../../styles/work.css';

const site = await getSite();
const k = site.kicker;
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const log = await getLog();
const recent = log.slice(0, 3);
const onlySamples = recent.length > 0 && log.every((e) => e.data.sample);
/* the second sentence of Today: the owner's own line on About ("Where I study") */
const prep = site.about.chapters.find((c: { id: string }) => c.id === 'study')?.text?.[1] as string | undefined;
const about = site.about.card.back;

/* one small real screen per product: the capture the row shows (plan V2; Eat Map has none yet) */
/* Recto shows its Library, not the white sample page: on the dark Home a white screen is the brightest
   thing in the first view (owner, 2026-10-15 night: white tires the eyes) */
const PICK: Record<string, string> = { recto: 'library', 'english-prep': 'home' };
const rows = await Promise.all(projects.map(async (p) => {
  const w = await getWorld(p.id);
  const id = PICK[p.id];
  const s: Shot | null = w && id ? shot(p.id, w, { id }) : null;
  const a = p.data.accent;
  return { p, s, vars: `--p: ${a.color}; --pg: ${a.glow ?? a.color}${inkVars(p)}` };
}));
/* 176 px at 2x on desktop, two thirds of the column on tablets and phones (up to 3x) */
const SHOT_W = [360, 480, 720];
const SHOT_SIZES = '(min-width: 1180px) 176px, (min-width: 768px) 336px, 67vw';

/** An untitled note shows its first line, cut to one line by CSS; never an invented title (plan strip 5). */
function recTitle(e: LogEntry): string {
  if (e.data.title) return e.data.title;
  const line = (e.body ?? '').split('\n').map((l) => l.trim()).find((l) => l && !l.startsWith('import ') && !l.startsWith('<'));
  if (!line) return entryTitle(e);
  return line.replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`#>]/g, '').trim() || entryTitle(e);
}

const OBJS = [['none', 'None'], ['mark', 'edk mark'], ['small', 'edk, live']] as const;
const TIMES = [['charter', 'Charter, 70 / 400 ms'], ['anthony', 'Anthony, 90 / 1000 ms']] as const;
---
<Base tab="home" title="Home V2" description="A workbench for the Home prototype V2, Strips." noindex>
  <script is:inline>
    /* Before first paint: the lab switches, and the arrival (never with ?still or reduced motion) */
    (function () {
      try {
        var d = document.documentElement, q = new URLSearchParams(location.search);
        var o = q.get('obj'); d.dataset.hv2Obj = /^(none|mark|small)$/.test(o) ? o : 'none';
        d.dataset.hv2T = q.get('t') === 'anthony' ? 'anthony' : 'charter';
        if (q.get('reveal') === 'scroll') d.dataset.hv2Reveal = 'scroll';
        if (q.get('draft') === '1') d.dataset.hv2Draft = '';
        if (q.get('samples') === '0') d.dataset.hv2Samples = '0';
        if (q.get('align') === 'center') d.dataset.hv2Align = 'center';
        if (!q.has('still') && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('hv2-in');
      } catch (e) {}
    })();
  </script>
  <div class="inner hv2" id="hv2">
    <div class="hv2-aura" aria-hidden="true"></div>
    <div class="hv2-col">

      <div class="strip s-intro" data-rail-sec="Eren Deniz">
        <div class="s-label s-obj">
          <span class="hv2-obj hv2-obj-mark"><Thumb obj="edk" size={96} class="hv2-mark" /></span>
          <span class="hv2-obj hv2-obj-small"><Media obj="edk" slot="home-v2" class="hv2-live" sizes="(min-width: 768px) 152px, 96px" /></span>
        </div>
        <div class="s-body">
          <h1 class="hv2-name" id="h-home" data-a style="--a: 0; --rise: 12px">{site.name}</h1>
          <p class="hv2-role" data-a style="--a: 0; --rise: 12px">{k.study} · <span class="lg">{k.school}</span><abbr class="sm" title={k.school}>{k.schoolShort}</abbr> · {k.year}</p>
        </div>
      </div>

      <section class="strip" aria-labelledby="h-today" data-rail-sec="Today">
        <!-- DRAFT: the label "Today" (plan V2) -->
        <h2 class="s-label" id="h-today" data-a data-a-k="fade" data-draft style="--a: 1">Today</h2>
        <div class="s-body" data-a style="--a: 2">
          <p class="hv2-lede">{site.lede}</p>
          {prep && <p class="hv2-sub">{prep}</p>}
        </div>
      </section>

      <section class="strip s-work" aria-labelledby="h-work" data-rail-sec="Work">
        <h2 class="s-label" id="h-work" data-a data-a-k="fade" style="--a: 1">Work</h2>
        <div class="s-body">
          <ul class="w-rows">
            {rows.map(({ p, s, vars }, i) => (
              <li>
                <a class="row p-open" href={url(projectPath(p))} data-p={p.id} data-title={p.data.title} style={vars}>
                  <span class="row-light" aria-hidden="true"></span>
                  {s ? (
                    <span class="row-shot fr-web" data-a data-a-k={i === 0 ? 'shot' : undefined} style={`--a: ${i === 0 ? 4 : 5}`}>
                      <span class="fr-bar" aria-hidden="true"><span class="fr-dots"><i></i><i></i><i></i></span></span>
                      <span class="fr-view">
                        <Picture src={s.img} alt="" widths={SHOT_W.filter((x) => x <= s.img.width)} sizes={SHOT_SIZES} formats={['avif', 'webp']} quality={62}
                          loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                      </span>
                    </span>
                  ) : (
                    /* no screen exists: the product's object in a dark tile of the same box, never a placeholder */
                    <span class="row-shot row-tile" data-a style={`--a: ${i === 0 ? 4 : 5}`}>
                      <Thumb obj={p.data.object} size={110} class="row-obj" />
                    </span>
                  )}
                  <span class="row-text" data-a style={`--a: ${i === 0 ? 3 : 5}`}>
                    <span class="row-name"><Wordmark project={p} /></span>
                    <span class="row-sum">{p.data.summary}</span>
                    <span class="row-meta"><Icon name="dot" />{statusLine(p)}{p.data.statusNote && ` · ${p.data.statusNote}`}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="hv2-more" data-a style="--a: 5"><a class="btn" href={url('work/')}>{site.home.showcase.all} <Icon name="arrow-right" weight="medium" /></a></div>
        </div>
      </section>

      <section class="strip" aria-labelledby="h-now" data-rail-sec="Now">
        <h2 class="s-label" id="h-now" data-a data-a-k="fade" style="--a: 5">{site.now.label}</h2>
        <div class="s-body" data-a style="--a: 5"><p class="hv2-text">{site.now.text}</p></div>
      </section>

      {recent.length > 0 && (
        <section class="strip s-record" aria-labelledby="h-rec" data-rail-sec="Record" data-only-samples={onlySamples ? '' : undefined}>
          <h2 class="s-label" id="h-rec" data-a data-a-k="fade" style="--a: 5">Record</h2>
          <div class="s-body" data-a style="--a: 5">
            <ol class="rec-rows">
              {recent.map((e) => (
                <li><a href={url(entryPath(e))}><span class="rec-t">{recTitle(e)}</span><time class="rec-d" datetime={iso(e.data.date)}>{dayMonYear(e.data.date)}</time></a></li>
              ))}
            </ol>
            <a class="qlink hv2-to" href={url('record/')}>{site.log.title.charAt(0).toUpperCase() + site.log.title.slice(1)} <Icon name="arrow-right" /></a>
          </div>
        </section>
      )}

      <section class="strip" aria-labelledby="h-about" data-rail-sec="About">
        <h2 class="s-label" id="h-about" data-a data-a-k="fade" style="--a: 5">About</h2>
        <div class="s-body" data-a style="--a: 5">
          <p class="hv2-text">{about}</p>
          <!-- DRAFT: the link label "About me" (plan strip 6) -->
          <a class="qlink hv2-to" href={url('about/')} data-draft>About me <Icon name="arrow-right" /></a>
        </div>
      </section>

      <section class="strip" aria-labelledby="h-else" data-rail-sec="Elsewhere">
        <!-- DRAFT: the label "Elsewhere" (plan V2) -->
        <h2 class="s-label" id="h-else" data-a data-a-k="fade" data-draft style="--a: 5">Elsewhere</h2>
        <div class="s-body hv2-links" data-a style="--a: 5">
          <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
          {!isPlaceholder(site.links.linkedin) && <a class="qlink" href={site.links.linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        </div>
      </section>
    </div>
    <Foot />

    <aside class="hv2-lab" aria-labelledby="h-lab">
      <h2 class="meta" id="h-lab">Lab · not part of the page</h2>
      <div class="lab-g"><span class="meta">Object</span>{OBJS.map(([v, l]) => <a data-k="obj" data-v={v} href={`?obj=${v}`}>{l}</a>)}</div>
      <div class="lab-g"><span class="meta">Timing</span>{TIMES.map(([v, l]) => <a data-k="t" data-v={v} href={`?t=${v}`}>{l}</a>)}</div>
      <div class="lab-g"><span class="meta">Below the fold</span><a data-k="reveal" data-v="" href="?">With the last step</a><a data-k="reveal" data-v="scroll" href="?reveal=scroll">Reveal once in view</a></div>
      <div class="lab-g"><span class="meta">Draft lines</span><a data-k="draft" data-v="" href="?">Plain</a><a data-k="draft" data-v="1" href="?draft=1">Outlined</a></div>
      <div class="lab-g"><span class="meta">Record</span><a data-k="samples" data-v="" href="?">Samples shown</a><a data-k="samples" data-v="0" href="?samples=0">As with no real entry</a></div>
      <div class="lab-g"><span class="meta">Column</span><a data-k="align" data-v="" href="?">On the bar's edge</a><a data-k="align" data-v="center" href="?align=center">Centred</a></div>
      <div class="lab-g"><span class="meta">Motion</span><a data-k="still" data-v="" href="?">Arrival</a><a data-k="still" data-v="1" href="?still">Still (the reduced-motion twin)</a><button type="button" class="lab-replay" hidden>Replay the arrival</button></div>
    </aside>
  </div>
</Base>

<script>
  /* Lab only: the panel's links keep the other switches; the arrival can be replayed; with ?reveal=scroll
     the strips below the fold arrive once as they come into view (plan V2, to be tried on the iPhone). */
  const d = document.documentElement;
  const q = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLAnchorElement>('.hv2-lab a[data-k]').forEach((a) => {
    const p = new URLSearchParams(q);
    const { k, v } = a.dataset as { k: string; v: string };
    if (v) p.set(k, k === 'still' ? '' : v); else p.delete(k);
    const s = p.toString().replace(/still=(&|$)/, 'still$1');
    a.href = location.pathname + (s ? '?' + s : '');
    const cur = k === 'still' ? (q.has('still') ? '1' : '') : (q.get(k) ?? '');
    const def = k === 'obj' ? 'none' : k === 't' ? 'charter' : '';
    if (cur === v || (!q.has(k) && v === def)) a.setAttribute('aria-current', 'true');
  });
  const replay = document.querySelector<HTMLButtonElement>('.lab-replay');
  if (replay && d.classList.contains('hv2-in')) {
    replay.hidden = false;
    replay.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      d.classList.remove('hv2-in');
      void d.offsetWidth;
      d.classList.add('hv2-in');
    });
  }
  if (d.classList.contains('hv2-in') && d.dataset.hv2Reveal === 'scroll' && 'IntersectionObserver' in window) {
    const below = [...document.querySelectorAll<HTMLElement>('.hv2 [data-a]')].filter((el) => el.getBoundingClientRect().top > innerHeight);
    const io = new IntersectionObserver((entries) => {
      const seen = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement)
        .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
      seen.forEach((el, i) => { io.unobserve(el); el.style.setProperty('--a', String(i)); el.classList.remove('hv2-wait'); });
    }, { rootMargin: '0px 0px -8% 0px' });
    below.forEach((el) => { el.classList.add('hv2-wait'); io.observe(el); });
  }
</script>

<style>
  /* the two display steps this page uses (ADR-0015 t-3 and t-2, linear from 360 to 1440 px) */
  .hv2 {
    --hv2-t3: clamp(26px, calc(23.667px + 0.648vw), 33px);
    --hv2-t2: clamp(22px, calc(20.667px + 0.37vw), 26px);
    --hv2-gap: 64px;
    --hv2-col: 680px;
    position: relative;
  }
  @media (min-width: 1180px) { .hv2 { --hv2-gap: 96px; } }
  @media (min-width: 768px) and (max-width: 1179.98px) { .hv2 { --hv2-col: 640px; } }

  /* the page's light: one edk pool behind the intro, at the base glow (charter section 4) */
  .hv2-aura {
    position: absolute; left: -12%; top: calc(-1 * var(--bar-h) - 120px); width: min(1100px, 150vw); aspect-ratio: 1.35; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--edk) var(--glow-base), transparent), color-mix(in srgb, var(--edk) 4%, transparent) 55%, transparent 100%);
  }
  .hv2-col { position: relative; max-width: var(--hv2-col); padding-top: 48px; }
  :global(html[data-hv2-align="center"]) .hv2-col { margin-inline: auto; }
  :global(html[data-hv2-align="center"]) .hv2-aura { left: 50%; translate: -50% 0; }

  /* strips: the label above its content on phones, a 152 px label column from 768 px */
  .strip { display: block; }
  .strip + .strip { margin-top: var(--hv2-gap); }
  .s-label { display: block; margin: 0 0 12px; font: 500 var(--t-meta)/var(--lh-meta) var(--f-ui); letter-spacing: 0.005em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) {
    .strip { display: grid; grid-template-columns: 152px minmax(0, 1fr); column-gap: 24px; align-items: baseline; }
    .s-label { margin: 0; }
  }

  /* intro */
  .hv2-name { font: 400 var(--hv2-t3)/1.16 var(--f-display); letter-spacing: -0.015em; color: var(--ink); margin-left: -0.02em; }
  .hv2-role { margin-top: 10px; font: 500 var(--t-meta)/var(--lh-meta) var(--f-ui); letter-spacing: 0.005em; color: var(--ink-3); }
  .s-intro .s-obj { margin: 0; }
  .hv2-obj { display: none; }
  /* from 768 px the object hangs in the label column and never makes the intro taller */
  @media (min-width: 768px) {
    .s-intro .s-obj { align-self: stretch; position: relative; }
    .hv2-obj { position: absolute; left: 0; top: 0; }
    :global(html[data-hv2-obj="mark"]) .hv2-obj-mark { display: block; }
  }
  :global(html[data-hv2-obj="small"]) .hv2-obj-small { display: block; }
  .hv2-obj-mark :global(.hv2-mark-pic) { display: contents; }
  .hv2-obj-mark :global(.hv2-mark) { display: block; width: 76px; height: 76px; margin: -8px 0 0 -12px; }
  @media (min-width: 900px) { .hv2-obj-mark :global(.hv2-mark) { width: 96px; height: 96px; margin: -18px 0 0 -16px; } }
  .hv2-obj-small { width: 96px; margin: -30px 0 -14px -10px; }
  @media (min-width: 768px) { .hv2-obj-small { width: 152px; margin: -46px 0 0 -30px; } }

  /* Today, Now, About */
  .hv2-lede { max-width: 30em; color: var(--ink); text-wrap: pretty; }
  .hv2-sub, .hv2-text { max-width: 34em; color: var(--ink-2); text-wrap: pretty; }
  .hv2-sub { margin-top: 12px; }
  .hv2-to { margin-top: 8px; }
  .hv2-links { display: flex; flex-wrap: wrap; gap: 0 28px; }
  .s-label + .hv2-links { margin-top: -12px; }
  @media (min-width: 768px) { .s-label + .hv2-links { margin-top: 0; align-self: center; } }

  /* Work: three rows, each a small real screen and its text; the product's light only under the row in
     hover, focus or press (one at a time) */
  .w-rows { display: grid; gap: 40px; }
  .row { position: relative; display: grid; gap: 16px; text-decoration: none; color: inherit; border-radius: 12px; }
  .row > :not(.row-light) { position: relative; }
  .row-light { position: absolute; inset: -40px -64px; border-radius: 50%; pointer-events: none; opacity: 0;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--pg) var(--glow-base), transparent), color-mix(in srgb, var(--pg) 3%, transparent) 60%, transparent);
    transition: opacity 200ms var(--ease-out); }
  .row:hover .row-light, .row:focus-visible .row-light, .row:active .row-light { opacity: 1; transition-duration: var(--d-1); }
  .row-shot { display: block; width: 66.667%; }
  @media (min-width: 768px) { .row-shot { width: min(336px, 66.667%); } }
  .row-text { display: grid; gap: 6px; align-content: start; }
  .row-name { font-size: var(--hv2-t2); line-height: 1.22; }
  .row .row-name :global(.wm) { color: var(--ink); transition: color var(--d-1); }
  .row:hover .row-name :global(.wm), .row:focus-visible .row-name :global(.wm) { color: var(--p-ink, var(--wm-c)); }
  .row-sum { color: var(--ink-2); max-width: 30em; text-wrap: pretty; }
  .row-meta { display: inline-flex; align-items: center; gap: 8px; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); letter-spacing: 0.005em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .row-meta :global(.icon) { color: var(--p); }
  @media (min-width: 1180px) {
    .row { grid-template-columns: 176px minmax(0, 1fr); gap: 24px; align-items: start; }
    .row-shot { width: 176px; }
    .w-rows { gap: 32px; }
  }

  /* the small browser frame: ADR-0015 item 5 at this size needs a lighter bar (20 px, dots only; the
     address does not fit at 176 px) and no product light at rest (one accent per viewport) */
  .hv2 .row-shot.fr-web { border-radius: 8px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 1px 0 0 rgba(255, 255, 255, 0.06) inset, 0 24px 48px -24px rgba(0, 0, 0, 0.9); }
  .hv2 .row-shot .fr-bar { height: 20px; padding: 0 8px; }
  .hv2 .row-shot .fr-dots { gap: 4px; }
  .hv2 .row-shot .fr-dots i { width: 6px; height: 6px; }
  .hv2 .row-shot .fr-view { display: block; aspect-ratio: 16 / 10; }
  .hv2 .row-shot .fr-view :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Eat Map: its object in a dark tile the size of a framed screen (the bar's 20 px plus 16:10) */
  .row-tile { position: relative; display: grid; place-items: center; border-radius: 8px; overflow: hidden;
    background: var(--ground-deep); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.07); }
  .row-tile::before { content: ""; display: block; grid-area: 1 / 1; width: 100%; padding-top: calc(62.5% + 20px); }
  .row-tile :global(.row-obj-pic) { display: contents; }
  .row-tile :global(.row-obj) { grid-area: 1 / 1; width: 64%; height: auto; aspect-ratio: 1; max-height: 92%; object-fit: contain;
    -webkit-mask-image: radial-gradient(closest-side, #000 55%, rgba(0, 0, 0, 0.6) 76%, transparent); mask-image: radial-gradient(closest-side, #000 55%, rgba(0, 0, 0, 0.6) 76%, transparent); }
  .hv2-more { margin-top: 40px; }

  /* Record: the newest three, dated */
  .rec-rows { border-top: 1px solid var(--rule-2); }
  .rec-rows li { border-bottom: 1px solid var(--rule-2); }
  .rec-rows a { display: flex; align-items: baseline; gap: 16px; min-height: 48px; padding: 12px 0; text-decoration: none; }
  .rec-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .rec-rows a:hover .rec-t { text-decoration: underline; text-decoration-color: var(--ink-4); text-underline-offset: 0.22em; }
  .rec-d { flex: none; font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--ink-3); font-variant-numeric: tabular-nums; }
