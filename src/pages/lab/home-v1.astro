---
/* Home prototype V1 "Index" (Phase 2 Home plan, section 3, V1): a hidden workbench, not linked from
   anywhere, noindex, and out of the sitemap (astro.config.mjs filters /lab/). The live Home
   (src/pages/index.astro) is not changed.

   What it is: Anthony Fu's labelled proof rows with project chips and Paco Coursey's small name and
   "Now" strip, in one column of at most 680 px on the bar's edge (E0). Strips: intro, proof rows,
   Work as three text-only rows, Now, the Record, About and links, the foot. The gap between strips is
   64 px below 900 px and 96 px from 900 px (charter §3.3).

   Sizes (charter §3.1, Home cap 34/45/48 provisional): the name is ADR-0015 step t-4 (text at 1ad060e),
   30 px at 360 to 42 px at 1440. Body 16/17 (one switch at 900 px), labels 13, wordmarks t-2 (22-26).
   Colours are the Graphite tokens only. The page light is one edk pool behind the intro at the base
   glow; a product's own light shows only around its row on hover, focus or press, one at a time.

   Arrival (plan V1 table; charter §5): six steps in reading order, 70 ms apart, 400 ms each, rising
   12 px (steps 0-1) or 8 px (steps 2-5). The animations are CSS with fill-mode backwards: nothing is
   hidden by a script, the text is in the HTML, and if the script that adds .arrive fails, every word
   simply shows. Reduced motion and ?still: no animation at all. The "anthony" preset runs the same
   steps 90 ms apart, 1000 ms each.

   Lab switches (query, read before first paint by the inline script below; the panel at the lower
   left writes them):
     ?obj=none|mark|small   none: the bar's mark is the only signature; mark (default): a tiny edk
                            poster, 76/96 px, still; small: the edk object stage at the charter's
                            Home object size (160/200/240/280), with its own idle loop, beside the
                            column from 900 px. With small, the page light stays still.
     ?timing=anthony        the Anthony Fu preset
     ?it=1                  the lede's first sentence in Newsreader's real italic (Paco style)
     ?draft=1               outlines every DRAFT string (labels and wording from the plan)
     ?samples=0             hides the Record strip, as the live build with SAMPLES=0 does
     ?still                 the reduced-motion twin (the site's own switch)
     ?panel=0               hides the lab panel (for screenshots)
     ?aura=live|lit|rich    the page light (src/styles/lab-aura.css): live is today's single pool, lit
                            (default) a visible edk pool right of the name and each product's light at its
                            row, rich the same, stronger. The pools sit right of the text column (left of
                            it for English Prep with the centred column), never at full strength behind text.
     ?col=left|centre       the text column on the bar's edge (E0), or centred in the page (default)
   Without JavaScript the page shows obj=mark, aura=lit and the centred column, fully visible, with no
   arrival; the panel's Aura and Column links then work by their #aura-* and #col-* targets. */
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Thumb from '../../components/Thumb.astro';
import Icon from '../../components/Icon.astro';
import Foot from '../../components/Foot.astro';
import Wordmark from '../../components/Wordmark.astro';
import '../../styles/lab-aura.css';
import { getSite, getProjects, getLog, url, projectPath, entryPath, dayMonYear, iso, isPlaceholder } from '../../lib/site';

const site = await getSite();
const log = await getLog();
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const k = site.kicker;
const study = site.about.chapters.find((c) => c.id === 'study');
const prep = study?.facts?.find((f) => f[0] === 'Prep year');
const byHand = site.about.chapters.find((c) => c.id === 'work')?.tracks?.lanes[0];
const pVars = (p: (typeof projects)[number]) => {
  const a = p.data.accent;
  return [`--p: ${a.color}`, `--pg: ${a.glow ?? a.color}`, a.p3 && `--p3: ${a.p3}`].filter(Boolean).join('; ');
};
/* the plan's meta line: status and version (and Eat Map's note); the start month stays on Work */
const meta = (p: (typeof projects)[number]) => [p.data.status, !isPlaceholder(p.data.version) && p.data.version, p.data.statusNote].filter(Boolean).join(' · ');
/* an untitled note shows its own first line, cut at one line by CSS; never an invented title (plan strip 5) */
const firstLine = (body = '') => body.split('\n').map((s) => s.trim()).find(Boolean)?.replace(/[*_`#>[\]]/g, '') ?? '';
const recent = log.slice(0, 3);
const ledeSplit = site.lede.indexOf('. ');
const lede1 = ledeSplit > 0 ? site.lede.slice(0, ledeSplit + 1) : site.lede;
const lede2 = ledeSplit > 0 ? site.lede.slice(ledeSplit + 1) : '';
const linkedin = isPlaceholder(site.links.linkedin) ? null : (site.links.linkedin as string);
---
<Base title="Home V1" tab="home" description="A workbench for the Home prototype V1, Index." noindex>
  <div class="inner v1 ha-root" id="v1" data-obj="mark" data-aura="lit" data-col="centre">
    {/* targets for the panel's links without JavaScript (lab-aura.css) */}
    <i class="ha-ta" id="aura-live" hidden></i><i class="ha-ta" id="aura-lit" hidden></i><i class="ha-ta" id="aura-rich" hidden></i>
    <i class="ha-tc" id="col-left" hidden></i><i class="ha-tc" id="col-centre" hidden></i>
    <div class="ha-edk" aria-hidden="true"></div>
    <script is:inline>
      /* before first paint: the lab switches (see the frontmatter) and the arrival class */
      (function () {
        var v = document.getElementById('v1'), d = v.dataset, q;
        try { q = new URLSearchParams(location.search); } catch (e) { return; }
        var o = q.get('obj');
        if (o && /^(none|mark|small)$/.test(o)) d.obj = o;
        if (q.get('timing') === 'anthony') d.timing = 'anthony';
        if (q.get('it') === '1') d.it = '1';
        if (q.get('draft') === '1') d.draft = '1';
        if (q.get('samples') === '0') d.samples = '0';
        if (q.get('panel') === '0') d.panel = '0';
        var a = q.get('aura'), c = q.get('col');
        if (a && /^(live|lit|rich)$/.test(a)) d.aura = a;
        if (c && /^(left|centre)$/.test(c)) d.col = c;
        var still = q.has('still') || matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!still) v.classList.add('arrive');
        if (!still && d.obj !== 'small') v.classList.add('breathe', 'ha-breathe');
      })();
    </script>

    <header class="v1-intro">
      <div class="v1-pool ha-old" aria-hidden="true"></div>
      <div class="v1-opt v1-mark" data-opt="mark" aria-hidden="true"><Thumb obj="edk" size={96} class="v1-mk" /></div>
      <div class="v1-id">
        <h1 id="h-home" data-step="0">{site.name}</h1>
        <p class="v1-lede" data-step="1"><span class="v1-l1">{lede1}</span>{lede2}</p>
      </div>
      <div class="v1-opt v1-small" data-opt="small"><Media obj="edk" slot="home" stage sizes="(min-width: 1300px) 280px, (min-width: 900px) 240px, (min-width: 600px) 200px, 160px" /></div>
    </header>
    <script is:inline>
      /* only the chosen object stays in the page, so the media script never wakes a hidden stage */
      (function () {
        var v = document.getElementById('v1');
        v.querySelectorAll('.v1-opt').forEach(function (el) { if (el.dataset.opt !== v.dataset.obj) el.remove(); });
      })();
    </script>

    <!-- DRAFT (plan strip 2): the row labels "Studying at" and "Building", and the wording of the
         "Studying at" row. The facts come from content/site.json (kicker, about facts and tracks). -->
    <dl class="v1-proof" aria-label="Today">
      <div class="v1-row" data-step="2">
        <dt data-draft>Studying at</dt>
        <dd data-draft>{k.study} at {k.school}, {k.year.toLowerCase()}</dd>
      </div>
      <div class="v1-row" data-step="3">
        <dt data-draft>Building</dt>
        <dd class="v1-chips">
          {projects.map((p) => (
            <a class="v1-chip p-open" href={url(projectPath(p))} data-p={p.id} data-title={p.data.title} style={pVars(p)}><Wordmark project={p} /></a>
          ))}
        </dd>
      </div>
      {byHand && (
        <div class="v1-row" data-step="4">
          <dt>{byHand.label}</dt>
          <dd>{byHand.items.map((it, i) => <>{i > 0 && <span class="v1-sep" aria-hidden="true"> · </span>}{i > 0 && <span class="vh">, </span>}{it}</>)}</dd>
        </div>
      )}
      {prep && (
        <div class="v1-row" data-step="4">
          <dt>{prep[0]}</dt>
          <dd>{prep[1]}</dd>
        </div>
      )}
    </dl>

    <section class="v1-strip v1-work" aria-labelledby="h-work" data-step="5">
      <h2 class="v1-label" id="h-work">{site.home.showcase.title}</h2>
      <ul class="v1-list">
        {projects.map((p) => (
          <li class="ha-row" style={pVars(p)}>
            <span class="ha-p" aria-hidden="true"></span>
            <a class="v1-proj p-open" href={url(projectPath(p))} data-p={p.id} data-title={p.data.title} style={pVars(p)}>
              <span class="v1-phead">
                <span class="v1-wm"><Wordmark project={p} /></span>
                <span class="meta v1-pm"><Icon name="dot" />{meta(p)}</span>
              </span>
              <span class="v1-sum">{p.data.summary}</span>
              <Icon name="arrow-right" size={20} />
            </a>
          </li>
        ))}
      </ul>
      <div class="v1-more"><a class="btn" href={url('work/')}>{site.home.showcase.all} <Icon name="arrow-right" weight="medium" /></a></div>
    </section>

    <section class="v1-strip v1-now" aria-labelledby="h-now">
      <h2 class="v1-label" id="h-now">{site.now.label}</h2>
      <p>{site.now.text}</p>
    </section>

    {recent.length > 0 && (
      <section class="v1-strip v1-rec" aria-labelledby="h-rec" data-v1-rec>
        <h2 class="v1-label" id="h-rec">Latest in the record</h2>
        <ul class="v1-list v1-entries">
          {recent.map((e) => (
            <li><a class="v1-entry" href={url(entryPath(e))}>
              <span class="v1-et">{e.data.title ?? firstLine(e.body)}</span>
              <time class="meta" datetime={iso(e.data.date)}>{dayMonYear(e.data.date)}</time>
            </a></li>
          ))}
        </ul>
        <div class="v1-links"><a class="qlink" href={url('record/')}>{site.log.title} <Icon name="arrow-right" /></a></div>
      </section>
    )}

    <!-- DRAFT (plan strip 6): the link label "About me". The line above it is the ID card's back
         (content/site.json about.card.back). -->
    <section class="v1-strip v1-about" aria-labelledby="h-about">
      <h2 class="v1-label" id="h-about">About</h2>
      <p>{site.about.card.back}</p>
      <div class="v1-links">
        <a class="qlink" href={url('about/')} data-draft>About me <Icon name="arrow-right" /></a>
        <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
        {linkedin && <a class="qlink" href={linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
      </div>
    </section>

    <Foot />
  </div>

  <details class="v1-lab" slot="after" id="v1-lab">
    <summary>Lab</summary>
    <div class="v1-lab-body">
      <p class="meta">Home V1, Index. Not linked from the site.</p>
      <dl>
        <div><dt class="meta">Aura</dt><dd data-k="aura" data-def="lit"><a href="?aura=live#aura-live" data-v="live">Live</a><a href="?aura=lit#aura-lit" data-v="lit">Lit</a><a href="?aura=rich#aura-rich" data-v="rich">Rich</a></dd></div>
        <div><dt class="meta">Column</dt><dd data-k="col" data-def="centre"><a href="?col=left#col-left" data-v="left">Left</a><a href="?col=centre#col-centre" data-v="centre">Centre</a></dd></div>
        <div><dt class="meta">Object</dt><dd data-k="obj" data-def="mark"><a href="?obj=none" data-v="none">None</a><a href="?obj=mark" data-v="mark">edk mark</a><a href="?obj=small" data-v="small">Small edk</a></dd></div>
        <div><dt class="meta">Timing</dt><dd data-k="timing" data-def="charter"><a href="?" data-v="charter">Charter</a><a href="?timing=anthony" data-v="anthony">Anthony</a></dd></div>
        <div><dt class="meta">Italic</dt><dd data-k="it" data-def="0"><a href="?" data-v="0">Off</a><a href="?it=1" data-v="1">Lede</a></dd></div>
        <div><dt class="meta">Draft</dt><dd data-k="draft" data-def="0"><a href="?" data-v="0">Hidden</a><a href="?draft=1" data-v="1">Outlined</a></dd></div>
        <div><dt class="meta">Samples</dt><dd data-k="samples" data-def="1"><a href="?" data-v="1">On</a><a href="?samples=0" data-v="0">Off</a></dd></div>
        <div><dt class="meta">Motion</dt><dd data-k="still" data-def="0"><a href="?" data-v="0">Full</a><a href="?still" data-v="1">Reduced</a></dd></div>
      </dl>
      <button type="button" class="v1-replay" id="v1-replay">Replay the arrival</button>
    </div>
  </details>
  <script is:inline slot="after">
    /* the panel's links keep the other switches; the current value of each is marked */
    (function () {
      var q = new URLSearchParams(location.search), lab = document.getElementById('v1-lab'), v = document.getElementById('v1');
      lab.querySelectorAll('dd[data-k]').forEach(function (dd) {
        var k = dd.dataset.k, cur = k === 'still' ? (q.has('still') ? '1' : '0') : (q.get(k) || dd.dataset.def);
        dd.querySelectorAll('a').forEach(function (a) {
          var n = new URLSearchParams(location.search);
          n.delete(k);
          if (a.dataset.v !== dd.dataset.def) n.set(k, k === 'still' ? '' : a.dataset.v);
          var s = n.toString().replace(/(^|&)still=(?=&|$)/, '$1still');
          a.href = location.pathname + (s ? '?' + s : '');
          if (a.dataset.v === cur) a.setAttribute('aria-current', 'true');
        });
      });
      document.getElementById('v1-replay').addEventListener('click', function () {
        if (!v.classList.contains('arrive')) return;
        v.classList.remove('arrive'); void v.offsetWidth; v.classList.add('arrive');
      });
      /* the light loop pauses while the tab is hidden (charter §5) */
      document.addEventListener('visibilitychange', function () { v.classList.toggle('paused', document.hidden); v.classList.toggle('ha-paused', document.hidden); });
    })();
  </script>
</Base>

<style is:global>
  /* ---- tokens of this prototype: ADR-0015 steps (text at 1ad060e) resolved for Home ---- */
  .v1 {
    --t-4: clamp(30px, calc(26px + 1.111vw), 42px);   /* the name: 30 at 360, 42 at 1440 */
    --t-2: clamp(22px, calc(20.667px + 0.37vw), 26px); /* wordmarks in the Work rows */
    --v1-body: 16px;
    --v1-strip: 64px;
    --v1-col: 680px;
    --v1-gap: 70ms;
    --v1-dur: 400ms;
    position: relative;
    font-size: var(--v1-body);
  }
  .v1[data-timing="anthony"] { --v1-gap: 90ms; --v1-dur: 1000ms; }
  @media (min-width: 900px) { .v1 { --v1-body: 17px; --v1-strip: 96px; } }
  .v1 > :not(.foot, .ha-edk) { max-width: var(--v1-col); }

  /* ---- intro: the name, one sentence; the page light behind it ---- */
  .v1 .v1-intro { position: relative; padding-top: 24px; }
  @media (min-width: 600px) { .v1 .v1-intro { padding-top: 48px; } }
  .v1 .v1-pool {
    position: absolute; z-index: 0; pointer-events: none;
    left: -22%; top: calc(-1 * var(--bar-h) - 160px); width: min(1100px, 150vw); aspect-ratio: 1.35;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--edk) var(--glow-base), transparent), color-mix(in srgb, var(--edk) 4%, transparent) 55%, transparent 100%);
  }
  @media (max-width: 599.98px) { .v1 .v1-pool { left: -45%; top: calc(-1 * var(--bar-h) - 40px); width: 190vw; } }

  /* ---- the column (?col): on the bar's edge (--ha-c 0) or centred in the page (--ha-c 1) ---- */
  .v1[data-col="left"]:not(:has(> .ha-tc:target)), .v1:has(> #col-left:target) { --ha-c: 0; }
  .v1[data-col="centre"]:not(:has(> .ha-tc:target)), .v1:has(> #col-centre:target) { --ha-c: 1; }
  .v1 { --ha-cl: max(0px, calc((100% - var(--v1-col)) / 2 * var(--ha-c, 0))); }
  .v1 > :is(.v1-intro, .v1-proof, .v1-strip) { margin-left: var(--ha-cl); }

  /* ---- the page light at lit and rich (lab-aura.css): the edk pool beside the name, right of the
     column, in the half the column leaves empty; each product's pool right of its row (English Prep's
     on the left when the column is centred, so the light alternates). Phones: the edk pool in the band
     beside the mark, above the name, and the product pools at the right edge. ---- */
  .v1 { --ha-ex: calc(var(--ha-cl) + min(100%, var(--v1-col)) + 150px); --ha-ey: 64px; --ha-ew: 1180px; --ha-eh: 860px; }
  .v1 .ha-p { --ha-px: calc(100% + 130px); --ha-pw: 700px; --ha-ph: 440px; }
  /* the small edk brings its own glow beside the name, so the pool moves further out */
  @media (min-width: 900px) { .v1[data-obj="small"] { --ha-ex: calc(var(--ha-cl) + min(100%, var(--v1-col)) + 300px); } }
  @media (min-width: 1180px) {
    .v1 .v1-list > .ha-row:nth-child(2) > .ha-p { --ha-px: calc((100% + 130px) * (1 - var(--ha-c, 0)) - 220px * var(--ha-c, 0)); }
  }
  @media (max-width: 899.98px) { .v1 { --ha-ew: 920px; --ha-eh: 720px; } .v1 .ha-p { --ha-px: calc(100% + 40px); --ha-pw: 520px; --ha-ph: 360px; } }
  @media (max-width: 599.98px) {
    /* a wide, flat pool in the band beside the mark, above the name; without the mark the name is at the
       top, so the pool rises behind the bar */
    .v1 { --ha-ex: 66%; --ha-ey: 52px; --ha-ew: 680px; --ha-eh: 300px; }
    .v1:not([data-obj="mark"]) { --ha-ey: -24px; }
    .v1 .ha-p { --ha-px: calc(100% + 10px); --ha-pw: 380px; --ha-ph: 300px; }
  }
  .v1 .v1-id, .v1 .v1-opt { position: relative; }
  .v1 h1 { font: 400 var(--t-4)/1.06 var(--f-display); letter-spacing: -0.02em; margin-left: -0.02em; text-wrap: balance; }
  .v1 .v1-lede { margin-top: 16px; max-width: 30em; color: var(--ink-2); font-size: var(--v1-body); line-height: 1.55; text-wrap: pretty; }
  .v1[data-it="1"] .v1-l1 { font: italic 400 1.12em/1 var(--f-display); color: var(--ink); letter-spacing: -0.005em; }

  /* the tiny edk: above the name on phones (never beside text below 600 px), beside it from 600 px */
  .v1 .v1-mark { width: 76px; height: 76px; margin: 0 0 12px -10px; }
  .v1 .v1-mk-pic { display: contents; }
  .v1 .v1-mk { display: block; width: 100%; height: 100%; object-fit: cover;
    /* the letters span about 70 % of the square: the mask starts past them, so the e and the k are not dimmed */
    -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent); mask-image: radial-gradient(closest-side, #000 74%, transparent); }
  @media (min-width: 600px) {
    .v1[data-obj="mark"] .v1-intro { display: grid; grid-template-columns: minmax(0, 1fr) 96px; column-gap: 32px; align-items: start; }
    .v1[data-obj="mark"] .v1-id { grid-column: 1; grid-row: 1; }
    .v1 .v1-mark { grid-column: 2; grid-row: 1; width: 96px; height: 96px; margin: -22px -12px 0 0; }
  }

  /* the small edk: under the intro below 900 px, beside the column from 900 px (outside the 680 px text) */
  /* the stage is square and the letters sit in its middle third, so negative margins keep the empty part
     of the box out of the layout (no transform: it would group the additive media) */
  .v1 .v1-small { width: 160px; margin: -12px 0 -48px -14px; }
  @media (min-width: 600px) { .v1 .v1-small { width: 200px; margin-bottom: -60px; } }
  @media (min-width: 900px) {
    .v1 { --v1-obj: clamp(240px, 20vw, 280px); }
    .v1[data-obj="small"] > .v1-intro { max-width: none; display: grid; grid-template-columns: minmax(0, var(--v1-col)) var(--v1-obj); column-gap: 48px; align-items: start; }
    .v1[data-obj="small"] .v1-id { grid-column: 1; grid-row: 1; }
    /* the letters' middle on the middle of the name and the sentence (about 84 px down) */
    .v1 .v1-small { grid-column: 2; grid-row: 1; width: 100%; margin: calc(84px - var(--v1-obj) / 2) 0 calc(-1 * var(--v1-obj) / 2); }
  }
  /* a centred column leaves room beside it for the small edk only from 1360 px; below that it sits under
     the intro, as it does under 900 px */
  @media (min-width: 900px) and (max-width: 1359.98px) {
    .v1[data-obj="small"][data-col="centre"]:not(:has(> .ha-tc:target)) > .v1-intro, .v1[data-obj="small"]:has(> #col-centre:target) > .v1-intro { display: block; max-width: var(--v1-col); }
    .v1[data-obj="small"][data-col="centre"]:not(:has(> .ha-tc:target)) .v1-small, .v1[data-obj="small"]:has(> #col-centre:target) .v1-small { width: 200px; margin: -12px 0 -60px -14px; }
  }

  /* ---- proof rows: a label and one line each ---- */
  .v1 .v1-proof { position: relative; margin-top: 40px; display: grid; gap: 14px; }
  .v1 .v1-row { display: grid; gap: 2px; }
  .v1 .v1-row dt { font: 500 var(--t-meta)/var(--lh-meta) var(--f-ui); letter-spacing: 0.005em; color: var(--ink-3); }
  .v1 .v1-row dd { margin: 0; color: var(--ink); line-height: 1.5; max-width: 34em; text-wrap: pretty; }
  @media (min-width: 600px) {
    .v1 .v1-row { grid-template-columns: 112px minmax(0, 1fr); column-gap: 20px; align-items: baseline; }
    .v1 .v1-row dt { padding-top: 1px; }
  }
  .v1 .v1-sep { color: var(--ink-4); }
  .v1 .v1-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .v1 .v1-chip {
    position: relative; display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 8px;
    background: var(--raised); box-shadow: inset 0 0 0 1px var(--rule); text-decoration: none; font-size: var(--t-ui);
    transition: background-color var(--d-1) var(--ease-out), box-shadow var(--d-1) var(--ease-out);
  }
