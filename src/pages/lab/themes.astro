---
/* A hidden workbench for the theme candidates (Phase 1 "Foundations", colour system): not linked from
   anywhere, noindex, and left out of the sitemap (astro.config.mjs filters /lab/). It shows short
   excerpts of the real pages with the real components, objects, screens and photo: a Home strip with
   the edk object, a Work chapter with its emblem and framed screen, the About opening with the ID card,
   a Record entry in the reading style, and the chrome (buttons, the tab pill, the clock, the rail).
   The switcher changes the candidate on this page only (#lab-t data-t; tokens in styles/lab-themes.css,
   measured by npm run palette:lab). Live pages and live tokens are untouched.
   Objects are drawn additively over a dark ground (ADR-0006), so on a light candidate they sit on dark
   islands; they are never shown on paper as if they worked there (scratchpad report objects-light.md).
   Without JavaScript the page shows candidate A; ?t=b (or c, d, d-ink, d-umber, d-moss) picks another. */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Thumb from '../../components/Thumb.astro';
import Icon from '../../components/Icon.astro';
import Wordmark from '../../components/Wordmark.astro';
import Reel from '../../components/Reel.astro';
import IdCard from '../../components/IdCard.astro';
import { getWorld, reelSteps } from '../../lib/world';
import { getSite, getProjects, url, statusLine, dayMonYear, iso, releaseName, releaseItems, entryProjects } from '../../lib/site';
import '../../styles/work.css';
import '../../styles/lab-themes.css';

const site = await getSite();
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const recto = projects.find((p) => p.id === 'recto')!;
const others = projects.filter((p) => p !== recto);
const R = recto.data;
const light = (p: typeof recto) => p.data.accent.glow ?? p.data.accent.color;
const rVars = `--p: ${R.accent.color}; --pg: ${light(recto)}`;
const steps = reelSteps(recto.id, await getWorld(recto.id), R).slice(0, 1);
const host = R.links.find((l) => l.kind === 'live')?.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const facts: [string, string][] = ([
  ['Status', [R.status, R.statusNote].filter(Boolean).join(', ')],
  ['Runs on', R.runsOn],
] as [string, string | undefined][]).filter((f): f is [string, string] => !!f[1]);
const k = site.kicker;
const a = site.about;
const aTitle = a.title.endsWith('.') ? a.title.slice(0, -1) : a.title;

/* the Record excerpts: the sample entry and the sample release (they exist to judge the reading page) */
const log = await getCollection('log');
const entry = log.find((e) => e.id.endsWith('sample-entry-two-tracks'));
const release = log.find((e) => e.id.endsWith('sample-release-recto'));
const Body = entry ? (await render(entry)).Content : null;
const entryPjs = entry ? entryProjects(entry, projects) : [];

const CANDIDATES = [
  ['a', 'A', 'Graphite'],
  ['b', 'B', 'Paper'],
  ['c', 'C', 'Hybrid'],
  ['d', 'D', 'Moods'],
] as const;
const SWATCHES = ['--ground', '--raised', '--ink', '--read', '--ink-2', '--ink-3', '--ink-4', '--edk-ink', '--recto-ink', '--prep-ink', '--eat-ink', '--log-ink', '--about-ink'];
const pinks: Record<string, string> = { recto: 'lab-recto', 'english-prep': 'lab-prep', 'eat-map': 'lab-eat' };
---
<Base title="Themes" tab={null} description="A workbench for the theme candidates." noindex accent="var(--lab-accent)">
  <div class="inner lab-themes">
    <header class="lab-head" data-rail-sec="Themes">
      <p class="meta">Lab · not linked from the site</p>
      <h1 class="vtitle" id="h-lab">Themes</h1>
      <p class="vdek">Four colour candidates, shown on short excerpts of the real pages. Every text and mark colour here is measured with WCAG 2 and APCA (npm run palette:lab). Objects stay on a dark ground in every candidate.</p>
      <div id="lab-t" class="lab-switch" data-t="a" role="group" aria-label="Theme candidate">
        {CANDIDATES.map(([id, letter, name]) => (
          <button type="button" data-set={id} aria-pressed={id === 'a' ? 'true' : 'false'}><b>{letter}</b>{name}</button>
        ))}
        <button type="button" class="lab-mood" data-mood aria-live="polite">Mood: Graphite. Next: Ink blue</button>
      </div>
      <script is:inline>
        /* before first paint: the candidate named in the address (?t=), so a link shows it directly */
        (function () {
          try {
            var t = new URLSearchParams(location.search).get('t');
            if (t && /^(a|b|c|d|d-ink|d-umber|d-moss)$/.test(t)) document.getElementById('lab-t').dataset.t = t;
          } catch (e) {}
        })();
      </script>
      <noscript><p class="meta lab-note">Without JavaScript this page shows candidate A.</p></noscript>
      <ul class="lab-sw" aria-label="Tokens of the current candidate">
        {SWATCHES.map((s) => <li><i style={`--c: var(${s})`}></i><span><span class="meta">{s}</span><code data-token={s}></code></span></li>)}
      </ul>
    </header>

    {/* ---- Home: the opening strip with the edk object ---- */}
    <section class="lab-band" aria-labelledby="h-l-home" data-rail-sec="Home" data-rail-accent="var(--edk-ink)">
      <h2 class="meta lab-label" id="h-l-home">Home</h2>
      <div class="hero lab-hero">
        <div>
          <p class="meta">{k.study} · <span class="lg">{k.school}</span><abbr class="sm" title={k.school}>{k.schoolShort}</abbr> · {k.year}</p>
          <p class="lab-name">{site.nameLines.map((l) => <span>{l}</span>)}</p>
          <p class="lede">{site.lede}</p>
          <div class="links">
            <a class="btn" href={url('work/')}>See the work <Icon name="arrow-right" weight="medium" /></a>
            <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
          </div>
        </div>
        <div class="lab-island lab-hero-obj"><Media obj="edk" slot="home" sizes="(min-width: 900px) 440px, 64vw" /></div>
      </div>
      <div class="now-grid lab-now">
        <div><span class="meta">{site.now.label}</span><p>{site.now.text}</p></div>
        <div>
          <span class="meta">{site.home.showcase.also}</span>
          <ul class="lab-also">
            {others.map((p) => (
              <li class={pinks[p.id]} style={`--p: ${light(p)}`}>
                <span class="lab-island lab-thumb"><Thumb obj={p.data.object} size={96} class="also-thumb" /></span>
                <span><span class="lab-also-name"><Wordmark project={p} /></span><span class="meta">{statusLine(p)}</span><span class="lab-also-sum">{p.data.summary}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ---- Work: one chapter, its emblem object and its framed screen ---- */}
    <section class="lab-band" aria-labelledby="h-l-work" data-rail-sec="Work" data-rail-accent="var(--recto-ink)">
      <h2 class="meta lab-label" id="h-l-work">Work</h2>
      <article class:list={['w-proj', 'lab-work', 'lab-recto', steps.length ? 'has-reel' : 'no-reel']} style={rVars} aria-labelledby="w-title-lab">
        <div class="w-stage">
          <div class="w-light" aria-hidden="true"></div>
          <div class="w-text">
            <div class="w-head">
              <span class="lab-island lab-tile"><Media obj={R.object} slot="work" class="w-obj w-emblem" light={light(recto)} sizes="148px" /></span>
              <p class="meta w-index"><span class="w-n">01</span><span class="w-of"> of 03</span></p>
            </div>
            <h3 class="w-title" id="w-title-lab" style={`--chars: ${(R.wordmark?.text ?? R.title).length}`}><Wordmark project={recto} /></h3>
            <p class="w-sum">{R.summary}</p>
            {R.what.text && <p class="w-what">{R.what.text}</p>}
            <dl class="w-facts">
              {facts.map(([key, v]) => <div class:list={[`f-${key.split(' ')[0].toLowerCase()}`]}><dt class="meta">{key}</dt><dd>{key === 'Status' && <Icon name="dot" />}{v}</dd></div>)}
            </dl>
            <div class="links w-links">
              <a class="btn tint" href={url(`work/${recto.id}/`)}>{site.work.cta}<span class="vh"> at {R.title}</span> <Icon name="arrow-right" weight="medium" /></a>
              {host && <a class="qlink" href={`https://${host}`}>{host} <Icon name="arrow-up-right" /></a>}
            </div>
          </div>
          <div class="w-media">
            {steps.length > 0
              ? <Reel steps={steps} host={host} title={R.title} />
              : <span class="lab-island"><Media obj={R.object} slot="work" class="w-obj w-hero" light={light(recto)} /></span>}
          </div>
        </div>
      </article>
    </section>

    {/* ---- About: the opening and the ID card (a reading surface in C) ---- */}
    <section class="lab-band lab-paper" aria-labelledby="h-l-about" data-rail-sec="About" data-rail-accent="var(--about-ink)">
      <h2 class="meta lab-label" id="h-l-about">About</h2>
      <div class="lab-about">
        <div class="lab-ab-intro">
          <p class="meta">{a.kicker}</p>
          <p class="lab-ab-title">{aTitle}<span class="lab-ab-dot">.</span></p>
          <p class="lede">{a.opening}</p>
          <p class="lab-ab-now"><span class="lab-now-dot" aria-hidden="true"></span><span class="lab-now-label">{site.now.label}</span><span class="lab-now-text">{site.now.text}</span></p>
        </div>
        <div class="lab-badge"><IdCard /></div>
      </div>
    </section>

    {/* ---- Record: an entry in the reading style, and a release row (a reading surface in C) ---- */}
    {entry && Body && (
      <section class="lab-band lab-paper" aria-labelledby="h-l-rec" data-rail-sec="Record" data-rail-accent="var(--log-ink)">
        <h2 class="meta lab-label" id="h-l-rec">Record</h2>
        <div class="lab-rec">
          <div class="lab-rec-head">
            <p class="meta"><time datetime={iso(entry.data.date)}>{dayMonYear(entry.data.date)}</time>{entryPjs.map((p) => <><span class="sep"> · </span><a class:list={['pj', pinks[p.id]]} href={url(`work/${p.id}/`)} style={`--p: ${light(p)}`}>{p.data.title}</a></>)}<span class="sep"> · </span>Sample</p>
            <p class="lab-post-title">{entry.data.title}</p>
            {entry.data.dek && <p class="post-dek lede">{entry.data.dek}</p>}
          </div>
          <div class="read lab-read">
            <Body />
            <p>A link in the reading text looks like <a href={url('record/')}>the record's index</a>, and a word set <strong>in bold</strong> takes the primary ink.</p>
            {entry.data.next && <p class="post-next lab-recto"><b>Next.</b> {entry.data.next}</p>}
          </div>
          {release && (
            <div class="lab-release lab-recto" style={`--p: ${R.accent.color}`}>
              <p class="meta"><time datetime={iso(release.data.date)}>{dayMonYear(release.data.date)}</time><span class="sep"> · </span>Release</p>
              <p class="r-name">{releaseName(release, projects)}</p>
              {release.data.title && <p class="r-title">{release.data.title}</p>}
              <ul class="r-items">{releaseItems(release.body).map((t) => <li>{t}</li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}

    {/* ---- Chrome: the buttons, the lit tab, the clock; the rail is the real one at the right edge ---- */}
    <section class="lab-band" aria-labelledby="h-l-chrome" data-rail-sec="Chrome">
      <h2 class="meta lab-label" id="h-l-chrome">Chrome</h2>
      <div class="lab-chrome">
        <div>
          <p class="meta lab-sub">Buttons</p>
          <div class="links lab-btns">
            <a class="btn" href={url()}>See the work <Icon name="arrow-right" weight="medium" /></a>
            {projects.map((p) => <a class:list={['btn', 'tint', pinks[p.id]]} href={url(`work/${p.id}/`)} style={`--p: ${p.data.accent.color}`}>{p.data.title} <Icon name="arrow-right" weight="medium" /></a>)}
            <a class="qlink" href={site.links.github}>GitHub <Icon name="arrow-up-right" /></a>
          </div>
        </div>
        <div>
          <p class="meta lab-sub">The tab pill, Home lit (a specimen; the real bar is above)</p>
          <div class="lab-pill" aria-hidden="true">
            <div class="tabs">
              <a tabindex="-1" aria-current="page"><span class="ind"></span>Home</a><a tabindex="-1">Work</a><a tabindex="-1">Record</a><a tabindex="-1">About</a>
            </div>
          </div>
        </div>
        <div>
          <p class="meta lab-sub">The clock (a specimen; on wide windows the bar shows the live one)</p>
          <p class="clock lab-clock" aria-hidden="true">Istanbul <time>14:05</time></p>
        </div>
        <div>
          <p class="meta lab-sub">The rail</p>
          <p class="lab-rail-note">The beads at the right edge are the page's real rail: one per section, lit in the section's ink as you pass it.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  /* The switcher: one candidate at a time, on this page only. D's button cycles its four moods. The
     address keeps the choice (?t=), so a screenshot or a link can name it. */
  const box = document.getElementById('lab-t') as HTMLElement;
  const MOODS = [['d', 'Graphite'], ['d-ink', 'Ink blue'], ['d-umber', 'Umber'], ['d-moss', 'Moss']];
  const meta = document.querySelector('meta[name="theme-color"]');
  function show(t: string) {
    box.dataset.t = t;
    const fam = t.startsWith('d') ? 'd' : t;
    box.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === fam)));
    const i = MOODS.findIndex(([id]) => id === t);
    const mood = box.querySelector<HTMLButtonElement>('[data-mood]')!;
    if (i >= 0) mood.textContent = `Mood: ${MOODS[i][1]}. Next: ${MOODS[(i + 1) % MOODS.length][1]}`;
    const cs = getComputedStyle(document.documentElement);
    meta?.setAttribute('content', cs.getPropertyValue('--ground').trim());
    document.querySelectorAll<HTMLElement>('[data-token]').forEach((c) => { c.textContent = cs.getPropertyValue(c.dataset.token!).trim(); });
    try { const u = new URL(location.href); u.searchParams.set('t', t); history.replaceState(history.state, '', u); } catch {}
  }
  box.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.set) show(b.dataset.set);
    else if (b.hasAttribute('data-mood')) {
      const i = MOODS.findIndex(([id]) => id === box.dataset.t);
      show(MOODS[(i + 1) % MOODS.length][0]);
    }
  });
  show(box.dataset.t || 'a');
</script>
