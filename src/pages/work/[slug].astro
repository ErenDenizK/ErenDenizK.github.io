---
/* A project's own page, /work/<slug>/ (ADR-0019; phase3 design-spec.md 3.3.4, "URLs"): the canonical
   address of each project since the new Home became the site root (2026-10-17, review row S38). On Home a
   project opens as a layer over the page and the address bar shows this URL; a direct visit, a reload or a
   shared link gets the complete presentation here, without JavaScript, with Close as a link to
   Home's #<slug>. The same frozen addresses the four-page site used, so old links still land on the
   project. */
import LabShell from '../../one/work/lab/LabShell.astro';
import Presentation from '../../one/work/Presentation.astro';
import '../../one/work/work.css';
import { models } from '../../one/work/data';
import { getProjects, getSite, url } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  const list = await models(projects, url());
  return list.map((m) => {
    const p = projects.find((x) => x.id === m.slug)!;
    return { params: { slug: m.slug }, props: { m, next: list.find((x) => x.slug === m.next?.slug), summary: p.data.summary, og: p.data.og } };
  });
}
const { m, next, summary, og } = Astro.props;
const site = await getSite();
---
<LabShell title={`${m.title} · ${site.name}`} card={m.title} description={summary} og={og ?? 'home'} ogAlt={`${m.title}: ${summary}`} noindex={false}>
  <Presentation m={m} next={next} mode="page" />
</LabShell>
<script>
  import { initStatic } from '../../one/work/scripts/work';
  import { initGlass } from '../../one/scripts/glass';
  initStatic();
  initGlass();
</script>
