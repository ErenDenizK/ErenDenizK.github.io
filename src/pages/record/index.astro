---
/* The record (docs/design/log.md, amended 2026-10-09 after the readability research §8): a short
   header, then one coloured timeline: each year's strip and its rows on a date spine, the mark of each
   row in its project's colour. No controls until about forty entries, then one row of project links.
   How it is written and the feed sit at the foot. With no entries the same frame shows, empty and
   honest: the year's strip with nothing on it, and what each mark on the spine will mean. */
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Foot from '../../components/Foot.astro';
import LogList from '../../components/LogList.astro';
import YearStrip from '../../components/YearStrip.astro';
import { getSite, getLog, getProjects, url, monYear, entriesFor, projectColor, PROJECT_LINKS_FROM } from '../../lib/site';
const site = await getSite();
const entries = await getLog();
const projects = await getProjects();
const first = entries.length ? entries[entries.length - 1].data.date : null;
const count = entries.length
  ? `${entries.length} ${entries.length === 1 ? 'entry' : 'entries'} since ${monYear(first!)}`
  : 'No entries yet';
const linked = entries.length >= PROJECT_LINKS_FROM ? projects.filter((p) => entriesFor(p, entries).length > 0) : [];
const thisYear = String(new Date().getUTCFullYear());
---
<Base title="The record" tab="record" description={site.log.dek} og="home">
  <div class="inner rec">
    <header class="rec-head">
      <div class="rec-text">
        <h1 class="rec-title" id="h-log">{site.log.title}</h1>
        <p class="rec-dek">{site.log.dek}</p>
        <p class="meta" id="log-count">{count}</p>
      </div>
      <Media obj="recorder" slot="record" stage class="rec-media" sizes="(min-width: 900px) 320px, 176px" priority />
    </header>

    {linked.length > 0 && (
      <nav class="rec-projects" id="rec-projects" aria-label="Show one project">
        {linked.map((p) => <a href={`?project=${p.id}`} data-p={p.id} style={`--p: ${projectColor(p)}`}>{p.data.title}</a>)}
        <a href={url('record/')} data-p="">Everything</a>
      </nav>
    )}

    {entries.length ? <LogList entries={entries} projects={projects} /> : (
      <section class="ygroup log-empty" aria-labelledby="h-empty">
        <div class="y-head">
          <div class="y-label"><h2 id="h-empty">{thisYear}</h2></div>
          <YearStrip year={thisYear} entries={[]} projects={projects} />
        </div>
        <div class="entries spine empty-spine">
          <p class="empty-lead">{site.log.empty}</p>
          <ul class="kinds" aria-label="What the marks will mean">
            <li class="entry s-note"><span class="e-mark" aria-hidden="true"></span><span class="e-date meta">Note</span><p>One to three sentences from the week, read here in full.</p></li>
            <li class="entry s-entry"><span class="e-mark" aria-hidden="true"></span><span class="e-date meta">Entry</span><p>A few paragraphs with a title: what I did, why, what comes next.</p></li>
            <li class="entry s-release"><span class="e-mark" aria-hidden="true"></span><span class="e-date meta">Release</span><p>A version shipped, set in its project's colour.</p></li>
            <li class="entry s-essay"><span class="e-mark" aria-hidden="true"></span><span class="e-date meta">Essay</span><p>A longer piece with figures, on a page of its own.</p></li>
          </ul>
          <p class="empty-colours meta">Each mark takes the colour of its project:{projects.map((p, i) => <>{i > 0 && ','} <span class="pj" style={`--p: ${projectColor(p)}`}>{p.data.title}</span></>)}; blue when it is about none.</p>
        </div>
      </section>
    )}

    <aside class="rec-foot" aria-label="About the record">
      <p class="meta">{site.log.writingNote}</p>
      <p class="meta"><a href={url('about/#colophon')}>How this is written</a><span class="sep">·</span><a href={url('record/feed.xml')}>Atom feed</a></p>
    </aside>
    <Foot />
  </div>
</Base>
