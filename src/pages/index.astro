---
/* Home is the showcase, Work is the catalog (owner, 2026-10-09: no duplication). After the hero, the
   project that leads (leadProject: `featured`, else the latest record activity) is shown object
   first, with its pitch, status and one way in; the others follow as a quiet "also building" strip.
   Every project link opens the focus view (ADR-0007 item 4).
   Hierarchy (brief §7, "Home hierarchy"; docs/research/2026-10-wordmarks.md §3, variant A): the hero
   is the person, the showcase is the work. A "Work" threshold in the maker's voice, then the lead
   project on a plate of its own with its light kept inside, its object smaller than edk, and every
   product named by its wordmark in its own face. */
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import Thumb from '../components/Thumb.astro';
import Foot from '../components/Foot.astro';
import Wordmark from '../components/Wordmark.astro';
import '../styles/showcase.css';
import { getSite, getProjects, getLog, url, projectPath, entryPath, entryTitle, dayMonYear, isPlaceholder, leadProject, statusLine } from '../lib/site';
const site = await getSite();
const log = await getLog();
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const lead = leadProject(projects, log);
const others = projects.filter((p) => p !== lead);
const latest = log[0];
const k = site.kicker;
const sc = site.home.showcase;
const L = lead.data;
const la = L.accent;
const leadVars = [`--p: ${la.color}`, `--pg: ${la.glow ?? la.color}`, la.p2 && `--p2: ${la.p2}`, la.p3 && `--p3: ${la.p3}`].filter(Boolean).join('; ');
---
<Base tab="home" og="home" ogAlt={`${site.name}, with the edk glass object.`} type="profile">
  <div class="inner">
    <div class="hero">
      <div>
        <p class="meta">{k.study} · <span class="lg">{k.school}</span><abbr class="sm" title={k.school}>{k.schoolShort}</abbr> · {k.year}</p>
        <h1 id="h-home">{site.nameLines.map((l) => <span>{l}</span>)}</h1>
        <p class="lede">{site.lede}</p>
        <div class="links">
          <a class="btn" href={url('work/')}>See the work <Icon name="arrow-right" weight="medium" /></a>
          <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
          {!isPlaceholder(site.links.linkedin) && <a class="qlink" href={site.links.linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        </div>
      </div>
      <Media obj="edk" slot="home" stage priority />
    </div>

    <section class="showcase" aria-labelledby="h-show" data-lead={lead.id} style={leadVars}>
      <div class="sc-head"><h2 id="h-show">{sc.title}</h2><a class="more" href={url('work/')}>{sc.all} <Icon name="arrow-right" /></a></div>
      <div class="sc-plate">
        <div class="sc-light" aria-hidden="true"></div>
        <div class="sc-lead">
          <Media obj={L.object} slot="showcase" class="sc-obj" light={la.glow ?? la.color} sizes="(min-width: 900px) 400px, 46vw" />
          <div class="sc-text">
            <p class="meta sc-kicker"><Icon name="dot" />{sc.kicker}</p>
            <h3 class="sc-title"><Wordmark project={lead} id={`sc-title-${lead.id}`} /></h3>
            <p class="meta sc-status">{statusLine(lead)}{L.statusNote && ` · ${L.statusNote}`}</p>
            <p class="sc-pitch">{L.summary}</p>
            {L.what.text && <p class="sc-what">{L.what.text}</p>}
            {!!L.what.numbers?.length && (
              <dl class="sc-numbers">{L.what.numbers.map((n) => <div><dt class="meta">{n.label}</dt><dd>{n.value}</dd></div>)}</dl>
            )}
            <div class="links">
              <a class="btn tint p-open" href={url(projectPath(lead))} data-p={lead.id} data-title={L.title} data-ptitle={`sc-title-${lead.id}`}>{sc.cta} <Icon name="arrow-right" weight="medium" /></a>
            </div>
          </div>
        </div>
      </div>

      {others.length > 0 && (
        <div class="sc-also">
          <h3 class="meta sc-also-head" id="h-also">{sc.also}</h3>
          <ul class="also-list" aria-labelledby="h-also">
            {others.map((p) => (
              <li><a class="also p-open" href={url(projectPath(p))} data-p={p.id} data-title={p.data.title} style={`--p: ${p.data.accent.glow ?? p.data.accent.color}`}>
                <Thumb obj={p.data.object} size={96} class="also-thumb" />
                <span class="also-text">
                  <span class="also-name"><Wordmark project={p} /><Icon name="arrow-right" size={20} /></span>
                  <span class="meta">{statusLine(p)}</span>
                  <span class="also-sum">{p.data.summary}</span>
                </span>
              </a></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <div class="now-grid">
      <div>
        <span class="meta">{site.now.label}</span>
        <p>{site.now.text}</p>
      </div>
      <div>
        {latest ? (
          <>
            <span class="meta">Latest in the record · <time datetime={latest.data.date.toISOString().slice(0, 10)}>{dayMonYear(latest.data.date)}</time></span>
            <a class="latest" href={url(entryPath(latest))}><b>{entryTitle(latest)}</b>{latest.data.dek && <span>{latest.data.dek}</span>}</a>
          </>
        ) : (
          <>
            <span class="meta">Record</span>
            <p class="log-empty-line">{site.log.empty} <a href={url('record/')}>The record</a></p>
          </>
        )}
      </div>
    </div>
    <Foot />
  </div>
</Base>
