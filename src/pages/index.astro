---
/* Home, the first of the two pages (design spec; owner, 2026-10-15; promoted from /lab/one/ on 2026-10-17,
   review row S38, ADR-0019): the first screen (the brief on the Bostancı plate, S32), Work (each project
   opens as a layer over Home and has its own address, /work/<slug>/), the person's part, the Record strip
   and the footer. */
import One from '../layouts/One.astro';
import Brief from '../one/Brief.astro';
import Work from '../one/Work.astro';
import Rest from '../one/rest/Rest.astro';
import { getSite, getProjects, url } from '../lib/site';

const site = await getSite();
const projects = await getProjects();
---
<One description={site.description} tab="home" og="home" ogAlt={`${site.name}: the brief over the Bostancı photograph.`} type="profile">
  <Brief />
  <Work projects={projects} base={url()} />
  <Rest />
</One>
