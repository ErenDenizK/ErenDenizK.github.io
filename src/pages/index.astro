---
/* Home, direction A: the cinematic object stage (docs/research/2026-10-home-a.md; brief, Home, 2026-10-11:
   "a stunning opening page"; Home presents the brand, the identity and the vision).
   One composed first screen (the edk glass, the name, one vision line, Istanbul and its time), then a scroll
   story in chapters while the glass stays pinned: who, the two tracks, the three products (the glass changes
   into each product's own object, the light takes each product's colour, its real screen beside it), the
   record, and the way on to Work and About. The object turns with the reading position on its real 1° pose
   grid (ADR-0006; scripts/home.ts drives media.ts's pose), and a press plays its hop.
   Layering (media research §3.1): .ha-stage is one additive group (plus-lighter) pinned over the page; the
   big words (.ha-word, the name, the wordmarks) are painted under it, so the glass adds its light onto
   them; the reading text is painted over it, beside the object, never under it.
   Still twins: without JavaScript every chapter is there, the edk glass pinned (desktop) or in the first
   screen (phones), each product with its own poster beside its text; reduced motion keeps posters and swaps
   without movement. Content is data: site.json `home`, the projects and the record. */
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import Thumb from '../components/Thumb.astro';
import Foot from '../components/Foot.astro';
import Wordmark from '../components/Wordmark.astro';
import { Picture } from 'astro:assets';
import '../styles/home.css';
import { poster } from '../lib/media';
import { getWorld, reelSteps } from '../lib/world';
import { getSite, getProjects, getLog, url, projectPath, entryPath, entryTitle, dayMonYear, iso, isPlaceholder, leadProject, statusLine, entryColors, type Project } from '../lib/site';
const site = await getSite();
const log = await getLog();
const h = site.home;
const k = site.kicker;
const directed = (await getProjects()).filter((p) => p.data.group === 'directed');
/* the hand-picked lead first (featured), then the rest in their order */
const lead = leadProject(directed, log);
const products = [lead, ...directed.filter((p) => p !== lead)];
const latest = log.slice(0, 3);
const lanes = site.about.chapters.find((c) => c.tracks)?.tracks;
const light = (p: Project) => p.data.accent.glow ?? p.data.accent.color;
const vars = (p: Project) => {
  const a = p.data.accent;
  return [`--p: ${a.color}`, `--pg: ${light(p)}`, a.p2 && `--p2: ${a.p2}`, a.p3 && `--p3: ${a.p3}`].filter(Boolean).join('; ');
};
/* each product's one real screen: the first step of its Work reel (a phone-first product shows its phone screen) */
const screens = new Map(await Promise.all(products.map(async (p) => {
  const s = reelSteps(p.id, await getWorld(p.id), p.data)[0];
  const shot = s ? (s.phone ?? s.main) : null;
  return [p.id, shot] as const;
})));
const host = (p: Project) => p.data.links.find((l) => l.kind === 'live')?.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const live = (p: Project) => p.data.links.find((l) => l.kind === 'live');
/* the objects the stage can change into (media.ts show() reads this index) */
const objs = ['edk', ...products.map((p) => p.data.object)];
const index = Object.fromEntries(objs.map((o) => {
  const q = poster(o);
  return [o, { manifest: q.manifest, src: q.src, srcset: q.sources, shadow: q.shadow, light: q.light }];
}));
const EDK = 'var(--edk)';
const two = (n: number) => String(n).padStart(2, '0');
const total = products.length;
/* the frames fill their column (ADR-0015 item 5): the side column beside the glass (at most 400 px), one
   text column beside it from 900 px (the window less the glass's slot), the column on phones; a phone
   alone is the shared phone width */
const WEB_SIZES = '(min-width: 1240px) 400px, (min-width: 900px) calc(92vw - 472px), 92vw';
const PHONE_SIZES = '(min-width: 900px) 300px, min(62vw, 240px)';
const STAGE_SIZES = '(min-width: 1360px) and (min-height: 860px) and (max-resolution: 1.49dppx) 705px, (min-width: 1360px) and (min-height: 820px) 600px, (min-width: 900px) 500px, min(96vw, 400px)';
---
<Base tab="home" og="home" ogAlt={`${site.name}, with the edk glass object.`} type="profile" pageClass="page-home">
  <script type="application/json" id="media-index" set:html={JSON.stringify(index)} />
  {/* before the first screen paints: ?still and reduced motion get the still twin, with no entrance */}
  <script is:inline>(function(){var d=document.documentElement;if(/[?&]still/.test(location.search)||matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('ha-calm');})();</script>
  <div class="ha" data-ha>
    <div class="ha-veil" aria-hidden="true"></div>
    <div class="ha-stage" aria-hidden="true">
      <div class="ha-light"><i class="l1"></i><i class="l2"></i><i class="l3"></i></div>
      <div class="ha-obj">
        <Media obj="edk" slot="home" stage solo priority sizes={STAGE_SIZES} />
        <i class="ha-ring"></i>
      </div>
    </div>

    <header class="ha-hero" data-ch="hero" data-obj="edk" data-light={EDK} data-pose="0,0" data-rail-sec={site.firstName} data-rail-accent={EDK}>
      <p class="meta ha-meta ha-in" style="--i: 4">{k.study} · <span class="lg">{k.school}</span><abbr class="sm" title={k.school}>{k.schoolShort}</abbr> · {k.year}</p>
      <h1 id="h-home" class="ha-name">
        <span class="ha-word ha-n1"><span class="ha-in" style="--i: 0">{site.nameLines[0]}</span></span>
        <span class="ha-word ha-n2"><span class="ha-in" style="--i: 1">{site.nameLines[1]}</span></span>
      </h1>
      <p class="ha-vision ha-in" style="--i: 2" data-draft={h.visionDraft ? '' : undefined}>{h.vision}{h.visionDraft && <span class="sample">draft</span>}</p>
      <div class="ha-foot ha-in" style="--i: 5">
        <p class="ha-time" data-clock><span class="ha-city">Istanbul</span> <time></time></p>
        <script is:inline>(function(){try{var t=document.currentScript.previousElementSibling.querySelector('time'),s=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZone:'Europe/Istanbul'}).format(new Date());t.textContent=s;t.dateTime=s;}catch(e){}})();</script>
        <p class="meta ha-cue"><i aria-hidden="true"></i>{h.cue}</p>
        <div class="ha-go">
          <a class="btn" href={url('work/')}>See the work <Icon name="arrow-right" weight="medium" /></a>
          <a class="qlink" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" /></a>
          {!isPlaceholder(site.links.linkedin) && <a class="qlink" href={site.links.linkedin} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        </div>
      </div>
      <p class="meta ha-hint" hidden>{h.hint}</p>
    </header>

    <section class="ha-ch ha-who" data-ch="who" data-obj="edk" data-light={EDK} data-light2="var(--about)" data-pose="-1.1,0.2" data-rail-sec={h.who.label} data-rail-accent={EDK} aria-labelledby="h-who">
      <div class="ha-l ha-rv">
        <p class="ha-k"><span>01</span>{h.who.label}</p>
        <h2 class="ha-h" id="h-who">{h.who.title}</h2>
        {h.who.text.map((t) => <p class="ha-p">{t}</p>)}
      </div>
      <dl class="ha-r ha-facts ha-rv">
        {h.who.facts.map(([a, b]) => <div><dt class="meta">{a}</dt><dd>{b}</dd></div>)}
      </dl>
    </section>

    {lanes && (
      <section class="ha-ch ha-tracks" data-ch="tracks" data-obj="edk" data-light="var(--about)" data-light2={EDK} data-light3="var(--log)" data-pose="-1.43,0.1;0,0;1.43,0.1" data-rail-sec={h.tracks.label} data-rail-accent="var(--about)" aria-labelledby="h-tracks">
        <div class="ha-head ha-rv">
          <p class="ha-k"><span>02</span>{h.tracks.label}</p>
          <h2 class="ha-h" id="h-tracks">{h.tracks.title}</h2>
        </div>
        <p class="ha-word ha-tw1" aria-hidden="true">{lanes.lanes[0].label}</p>
        <div class="ha-l ha-lane ha-rv">
          <h3 class="ha-lh">{lanes.lanes[0].label}</h3>
          <ul>{lanes.lanes[0].items.map((x) => <li>{x}</li>)}</ul>
          <p class="ha-gives"><span class="meta">{lanes.teaches}</span>{lanes.lanes[0].gives}</p>
        </div>
        <p class="ha-word ha-tw2" aria-hidden="true">{lanes.lanes[1].label}</p>
        <div class="ha-r ha-lane ha-rv">
          <h3 class="ha-lh">{lanes.lanes[1].label}</h3>
          <ul>{lanes.lanes[1].items.map((x) => <li>{x}</li>)}</ul>
          <p class="ha-gives"><span class="meta">{lanes.teaches}</span>{lanes.lanes[1].gives}</p>
        </div>
        <p class="ha-meet ha-rv">{lanes.meet} {h.tracks.text}</p>
      </section>
    )}

    <section class="ha-ch ha-intro" data-ch="products" data-obj="edk" data-light="var(--accent-neutral)" data-light2={light(products[0])} data-light3={light(products[1] ?? products[0])} data-pose="0,-0.3" data-rail-sec={h.products.label} data-rail-accent="var(--accent-neutral)" aria-labelledby="h-products">
      <div class="ha-head ha-rv">
        <p class="ha-k"><span>03</span>{h.products.label}</p>
        <h2 class="ha-h" id="h-products">{h.products.title}</h2>
        <p class="ha-p">{h.products.text}</p>
      </div>
    </section>

    {products.map((p, i) => {
      const d = p.data;
      const shot = screens.get(p.id);
      const ln = live(p);
      return (
        <section class="ha-ch ha-prod" id={`home-${p.id}`} data-ch={p.id} data-obj={d.object} data-light={light(p)} data-light2={d.accent.p2 ?? light(p)} data-light3={d.accent.p3 ?? d.accent.color}
          data-pose={i % 2 ? '1,0.2' : '-1,0.2'} data-rail-sec={d.title} data-rail-accent={light(p)} style={vars(p)} aria-labelledby={`ha-t-${p.id}`}>
          <h3 class="ha-word ha-pname"><Wordmark project={p} id={`ha-t-${p.id}`} /></h3>
          <div class="ha-l ha-rv">
            <p class="ha-k"><span>{two(i + 1)} / {two(total)}</span>{statusLine(p)}{d.statusNote && ` · ${d.statusNote}`}</p>
            <p class="ha-pitch">{d.summary}</p>
            {d.what.text && <p class="ha-p">{d.what.text}</p>}
            {!!d.what.numbers?.length && (
              <dl class="ha-nums">{d.what.numbers.map((n) => <div><dt class="meta">{n.label}</dt><dd>{n.value}</dd></div>)}</dl>
            )}
            <div class="links">
              <a class="btn tint p-open" href={url(projectPath(p))} data-p={p.id} data-title={d.title} data-ptitle={`ha-t-${p.id}`}>{h.products.cta} <Icon name="arrow-right" weight="medium" /></a>
              {ln && <a class="qlink" href={ln.href}>{ln.label} <Icon name="arrow-up-right" /></a>}
            </div>
          </div>
          <div class:list={['ha-r', 'ha-shot', 'ha-rv', { 'is-phone': shot?.frame === 'phone', 'no-shot': !shot }]}>
            <Thumb obj={d.object} size={240} class="ha-still" />
            {shot && shot.frame === 'wide' && (
              <figure class="fr-web">
                <div class="fr-bar" aria-hidden="true"><span class="fr-dots"><i></i><i></i><i></i></span>{host(p) && <span class="fr-url">{host(p)}</span>}</div>
                <div class="fr-view" style={`aspect-ratio: ${shot.img.width} / ${shot.img.height}`}>
                  <Picture src={shot.img} alt={shot.alt} widths={[720, 1080, 1440, 2048].filter((w) => w <= shot.img.width)} sizes={WEB_SIZES} formats={['avif', 'webp']} quality={62} loading="lazy" decoding="async" />
                </div>
              </figure>
            )}
            {shot && shot.frame === 'phone' && (
              <figure class="fr-phone">
                <div class="fr-view" style={`aspect-ratio: ${shot.img.width} / ${shot.img.height}`}>
                  <Picture src={shot.img} alt={shot.alt} widths={[390, 600, 780].filter((w) => w <= shot.img.width)} sizes={PHONE_SIZES} formats={['avif', 'webp']} quality={70} loading="lazy" decoding="async" />
                </div>
              </figure>
            )}
          </div>
        </section>
      );
    })}

    <section class="ha-ch ha-record" data-ch="record" data-obj="edk" data-light="var(--log)" data-light2={EDK} data-pose="1.1,0.25" data-rail-sec={h.record.label} data-rail-accent="var(--log)" aria-labelledby="h-record">
      <div class="ha-l ha-rv">
        <p class="ha-k"><span>04</span>{h.record.label}</p>
        <h2 class="ha-h" id="h-record">{h.record.title}</h2>
        <p class="ha-p">{site.log.dek}</p>
        <a class="qlink ha-all" href={url('record/')}>{h.record.all} <Icon name="arrow-right" /></a>
      </div>
      <div class="ha-r ha-rv">
        {latest.length ? (
          <ol class="ha-entries">
            {latest.map((e) => {
              const c = entryColors(e, directed);
              return (
                <li style={`--c: ${c[0] ?? 'var(--log)'}`}>
                  <a href={url(entryPath(e))}>
                    <time class="meta" datetime={iso(e.data.date)}>{dayMonYear(e.data.date)}</time>
                    <b>{entryTitle(e)}</b>
                    {e.data.dek && <span>{e.data.dek}</span>}
                  </a>
                </li>
              );
            })}
          </ol>
        ) : <p class="ha-p">{site.log.empty}</p>}
      </div>
    </section>

    <section class="ha-ch ha-exit" data-ch="exit" data-obj="edk" data-light={EDK} data-light2="var(--about)" data-light3="var(--log)" data-pose="0,0" data-rail-sec={h.exit.label} data-rail-accent={EDK} aria-labelledby="h-exit">
      <h2 class="vh" id="h-exit">{h.exit.label}</h2>
      <a class="ha-l ha-door ha-rv" href={url('work/')}><span class="meta">{h.exit.work[0]}</span><b>{h.exit.work[1]}</b><Icon name="arrow-right" size={24} /></a>
      <a class="ha-r ha-door ha-rv" href={url('about/')}><span class="meta">{h.exit.about[0]}</span><b>{h.exit.about[1]}</b><Icon name="arrow-right" size={24} /></a>
      <p class="ha-now ha-rv"><span class="meta">{site.now.label}</span>{site.now.text}</p>
    </section>
  </div>
  <div class="inner"><Foot /></div>
  <script>import '../scripts/home';</script>
</Base>
