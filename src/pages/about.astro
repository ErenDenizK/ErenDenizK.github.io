---
/* About: an "about me" article (brief, About, 2026-10-10 evening: "who I am, where I study, how I work,
   what I do at school, my software side; more photos in the postcard style; the ID card keeps the
   current photo"), made livelier on 2026-10-11 ("soulless: plain text and three photos"; direction in
   docs/research/2026-10-about-and-postcards.md §3: a letter with postcards).
   The ID card opens the page beside the opening and a "now" line (desktop) or in the first screen
   (phones). The chapters follow in the Record's reading style (21 px Newsreader, about 70 characters a
   line) and are the rail's rungs (ADR-0013); each may carry one object of its own, so the page has a
   rhythm: a plate of facts in the margin, the pile of postcards as a wide band (PostcardPile), two
   tracks that meet, a pull quote, the products in their own wordmarks and colours, the year as a line.
   Every word and every photo comes from content/site.json (ADR-0002); the photo files and their tones
   are made by tools/photos/postcards.mjs at the sizes they are shown. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Foot from '../components/Foot.astro';
import IdCard from '../components/IdCard.astro';
import Postcard from '../components/Postcard.astro';
import PostcardPile from '../components/PostcardPile.astro';
import Wordmark from '../components/Wordmark.astro';
import { getSite, getProjects, isPlaceholder, projectPath, url } from '../lib/site';
import postcards from '../assets/photos/postcards.json';

const site = await getSite();
const a = site.about;
const projects = (await getProjects()).filter((p) => p.data.group === 'directed');
const li = isPlaceholder(site.links.linkedin) ? null : site.links.linkedin;
const ghHandle = new URL(site.links.github).pathname.replace(/^\/+|\/+$/g, '');
const links = [
  { name: 'GitHub', icon: 'github', href: site.links.github, note: `github.com/${ghHandle}` },
  ...(li ? [{ name: 'LinkedIn', icon: 'linkedin', href: li, note: '' }] : []),
];

/* the postcard files, by the photo's stem: pc-<stem>-<width>.<avif|webp> */
const files = import.meta.glob<string>('../assets/photos/pc-*.{avif,webp}', { eager: true, query: '?url', import: 'default' });
const manifest = postcards as Record<string, { width: number; height: number; widths: number[]; tone: string }>;
/* what each placement is drawn at (the styles below): sizes never promise less than the box */
const SIZES = {
  side: '(min-width: 1241px) 340px, (min-width: 900px) 300px, min(calc(100vw - 32px), 420px)',
  pile: '(min-width: 1241px) 360px, (min-width: 900px) 320px, min(68vw, 290px)',
};
function photo(stem: string, place: keyof typeof SIZES) {
  const m = manifest[stem];
  if (!m) throw new Error(`no postcard files for "${stem}": run npm run photos`);
  const set = (ext: string) => m.widths.map((w) => {
    const f = files[`../assets/photos/pc-${stem}-${w}.${ext}`];
    if (!f) throw new Error(`missing pc-${stem}-${w}.${ext}: run npm run photos`);
    return `${f} ${w}w`;
  }).join(', ');
  return {
    src: files[`../assets/photos/pc-${stem}-${m.widths[0]}.webp`],
    srcset: set('webp'), avif: set('avif'), sizes: SIZES[place],
    width: m.width, height: m.height, tone: m.tone,
  };
}
const num = (i: number) => String(i + 1).padStart(2, '0');
/* the title's closing full stop is lit, like the dot of the mark (brief, 2026-10-09: "the colour-changing
   dot in edk. felt alive") */
const title = a.title.endsWith('.') ? a.title.slice(0, -1) : a.title;
const dot = a.title.endsWith('.');
---
<Base title="About" tab="about" og="about" ogAlt={`${site.name} at the YTÜ gate.`} type="profile" pageClass="page-about">
  <div class="inner about">
    <header class="ab-open">
      <div class="ab-intro">
        <p class="meta">{a.kicker}</p>
        <h1 class="ab-title" id="h-about">{title}{dot && <span class="ab-dot">.</span>}</h1>
        <p class="lede">{a.opening}</p>
        <p class="ab-now"><span class="now-dot" aria-hidden="true"></span><span class="now-label">{site.now.label}</span><span class="now-text">{site.now.text}</span></p>
      </div>
      <div class="about-badge"><IdCard /></div>
    </header>

    <div class="ab-article">
      {a.chapters.map((c, i) => {
        const pics = c.photos ?? [];
        const pile = pics.length > 1;
        const head = <h2 class="ch-head" id={`h-${c.id}`}><span class="ch-n" aria-hidden="true">{num(i)}</span>{c.title}</h2>;
        const words = c.text.map((t) => <p>{t}</p>);
        if (pile) return (
          <section class="ch ch--band" id={c.id} aria-labelledby={`h-${c.id}`} data-rail-sec={c.title}>
            {head}
            <div class="ch-wide">
              <PostcardPile cards={pics.map((p) => ({ ...photo(p.photo, 'pile'), alt: p.alt, note: p.note, place: p.place, date: p.date }))}>
                <div class="ch-body">{words}</div>
              </PostcardPile>
            </div>
          </section>
        );
        return (
          <section class:list={['ch', (pics.length === 1 || c.facts) && 'has-side']} id={c.id} aria-labelledby={`h-${c.id}`} data-rail-sec={c.title}>
            {head}
            <div class="ch-body">
              {words}
              {c.list === 'products' && (
                <ul class="ab-list ab-products">
                  {projects.map((p) => (
                    <li style={`--pa: ${p.data.accent.color}`}><a href={url(projectPath(p))}><span class="pa-dot" aria-hidden="true"></span><Wordmark project={p} class="ab-wm" /><span class="ab-note">{p.data.summary}</span><span class="ab-status">{p.data.status}</span><Icon name="arrow-right" /></a></li>
                  ))}
                </ul>
              )}
              {c.list === 'links' && (
                <ul class="ab-list">
                  {links.map((l) => (
                    <li><a href={l.href} rel="me"><Icon name={l.icon} size={24} /><span class="ab-name">{l.name}</span><span class="ab-note">{l.note}</span><Icon name="arrow-up-right" /></a></li>
                  ))}
                </ul>
              )}
            </div>
            {c.tracks && (
              <figure class="tracks">
                <div class="tr-lanes">
                  {c.tracks.lanes.map((l, j) => (
                    <div class:list={['tr-lane', `tr-lane--${j}`]}>
                      <p class="tr-label">{l.label}</p>
                      <ul class="tr-items">{l.items.map((it) => <li>{it}</li>)}</ul>
                      <p class="tr-gives"><span class="meta">{c.tracks!.teaches}</span>{l.gives}</p>
                    </div>
                  ))}
                </div>
                <div class="tr-meet" aria-hidden="true"></div>
                <figcaption class="tr-end"><span class="tr-node" aria-hidden="true"></span>{c.tracks.meet}</figcaption>
              </figure>
            )}
            {c.quote && <blockquote class="ab-quote"><p>{c.quote}</p></blockquote>}
            {c.timeline && (
              <ol class="tl">
                {c.timeline.map((s) => (
                  <li class:list={['tl-step', `is-${s.state}`]} aria-current={s.state === 'now' ? 'step' : undefined}>
                    <span class="tl-dot" aria-hidden="true"></span>
                    <span class="tl-when">{s.when}</span>
                    <span class="tl-what">{s.what}</span>
                  </li>
                ))}
              </ol>
            )}
            {c.facts && (
              <aside class="ch-side">
                <dl class="facts">{c.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              </aside>
            )}
            {pics.length === 1 && !c.facts && (
              <aside class="ch-side">
                {pics.map((p) => <Postcard {...photo(p.photo, 'side')} alt={p.alt} note={p.note} place={p.place} date={p.date} />)}
              </aside>
            )}
          </section>
        );
      })}

      <section class="ab-colophon" id="colophon" aria-labelledby="h-colo">
        <h2 class="meta" id="h-colo">How this site is made</h2>
        <div class="ch-body">{a.colophon.map(([b, t]) => <p><b>{b}</b> {t}</p>)}</div>
      </section>
    </div>
    <Foot />
  </div>
</Base>

<style>
  /* One grid for the whole page, so the opening, the chapters and the margin objects share their edges.
     Wide (from 1241 px): chapter heads | the reading column | the margin for the card and the facts.
     900-1240 px: heads sit above their chapter; the margin stays. Phones: one column. */
  .about {
    --head: 200px; --text: 588px; --side: 340px; --gap: 56px;
    position: relative;
  }
  .about::before {   /* the About light: one gold pool behind the card */
    content: ""; position: absolute; z-index: 0; right: -6%; top: calc(-1 * var(--bar-h) - 10%); width: 72vmin; aspect-ratio: 1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--about) 10%, transparent), transparent);
  }
  .ab-open, .ch, .ab-colophon {
    position: relative; display: grid; column-gap: var(--gap);
    grid-template-columns: var(--head) minmax(0, var(--text)) var(--side);
  }

  /* ---- the opening: a warm introduction beside the card ---- */
  .ab-open {
    --cw: clamp(236px, min(22vw, calc((100svh - 300px) * 0.56)), 318px);
    --drop: clamp(36px, 6svh, 64px);
    min-height: calc(var(--drop) + var(--cw) * 1.6 + 72px);
    align-items: center; padding-bottom: 40px;
  }
  .ab-intro { grid-column: 1 / 3; grid-row: 1; max-width: 34rem; padding-bottom: 24px; }
  .ab-title { margin: 16px 0 0 -0.04em; font: 400 var(--t-name)/var(--lh-name) var(--f-display); letter-spacing: -0.03em; text-wrap: balance; }
  /* the lit full stop: About's gold, breathing slowly (still where motion is not welcome) */
  .ab-dot { color: var(--about); text-shadow: 0 0 0.32em color-mix(in srgb, var(--about) 55%, transparent); animation: ab-breathe 5.2s var(--ease-move) infinite alternate; }
  @keyframes ab-breathe { from { text-shadow: 0 0 0.18em color-mix(in srgb, var(--about) 30%, transparent); } to { text-shadow: 0 0 0.42em color-mix(in srgb, var(--about) 70%, transparent); } }
  .ab-intro .lede { margin-top: 30px; color: var(--ink-2); max-width: 30em; }
  .ab-now {
    margin-top: 34px; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; row-gap: 4px; align-items: baseline;
    max-width: 30rem; padding-top: 18px; border-top: 1px solid var(--rule);
  }
  .now-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--about); box-shadow: 0 0 10px color-mix(in srgb, var(--about) 70%, transparent); align-self: center; grid-row: 1; }
  .now-dot::after { content: ""; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--about); opacity: 0; animation: now-ring 2.8s var(--ease-out) infinite; }
  @keyframes now-ring { 0% { opacity: 0.6; transform: scale(0.5); } 70%, 100% { opacity: 0; transform: scale(1.5); } }
  .now-label { font: 400 var(--t-meta)/var(--lh-meta) var(--f-ui); color: var(--about); letter-spacing: 0.01em; }
  .now-text { grid-column: 2; font: 400 var(--t-ui)/var(--lh-ui) var(--f-ui); color: var(--ink); }
  /* the card's room to swing (card3d.ts reads this box): from just past the opening's words to the
     window's right edge, the card hanging in the middle of it (ADR-0008 item 3) */
  .about-badge {
    position: absolute; z-index: 1; top: 0; bottom: 0;
    left: calc(min(34rem, 100%) + 16px); right: calc((100% - 100vw) / 2);
    padding: var(--drop) var(--gut) 0 40px;
    display: flex; justify-content: center; align-items: flex-start; pointer-events: none;
  }
  .about-badge > :global(.idc) {
    pointer-events: auto; --w: var(--cw);
    --strap: calc(var(--bar-h) + var(--drop) + 56px);
  }

  /* ---- chapters ---- */
  .ch { margin-top: 112px; align-items: start; }
  .ab-article { position: relative; z-index: 1; }
  .ch-head { grid-column: 1; font: 400 var(--t-h3)/var(--lh-h3) var(--f-display); letter-spacing: -0.012em; padding-top: 3px; }
  .ch-n { display: block; margin-bottom: 10px; font: 400 var(--t-meta)/1 var(--f-ui); color: var(--about); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .ch-body { grid-column: 2; font: 430 21px/1.55 var(--f-read); color: var(--read); max-width: 28em; text-wrap: pretty; hanging-punctuation: first allow-end; }
  .ch-body > * + * { margin-top: 1em; }
  .ch-body b { font-weight: 500; color: var(--ink); }
  .ch-side { grid-column: 3; grid-row: 1 / span 4; }

  /* the facts plate: what the chapter says, as a label would */
  .facts { border-top: 1px solid color-mix(in srgb, var(--about) 45%, var(--rule)); padding-top: 4px; }
  .facts div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 12px 0 11px; border-bottom: 1px solid var(--rule); }
  .facts dt { font: 400 var(--t-meta)/1.5 var(--f-ui); color: var(--ink-3); }
  .facts dd { font: 400 17px/1.35 var(--f-display); color: var(--ink); }

  /* the band: the pile of postcards beside the chapter's words, across the reading column and the margin */
  .ch--band { margin-top: 128px; }
  .ch-wide { grid-column: 2 / 4; }

  /* two tracks that run side by side and meet (How I work) */
  .tracks { --tg: 48px; grid-column: 2 / 4; margin: 52px 0 0; max-width: calc(var(--text) + 120px); }
  .tr-lanes { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--tg); }
  .tr-lane { --lc: var(--ink-2); position: relative; padding: 2px 0 26px 28px; }
  .tr-lane--1 { --lc: var(--about); }
  .tr-lane::before { content: ""; position: absolute; left: 3.5px; top: 8px; bottom: 0; width: 1px; background: linear-gradient(var(--lc), color-mix(in srgb, var(--lc) 35%, transparent)); opacity: 0.6; }
  /* a light runs down each track, at its own pace */
  .tr-lane::after {
    content: ""; position: absolute; left: 0; top: 4px; width: 8px; height: 8px; border-radius: 50%;
    background: var(--lc); box-shadow: 0 0 12px var(--lc), 0 0 2px var(--lc);
    animation: tr-run 7s var(--ease-move) infinite;
  }
  .tr-lane--1::after { animation-duration: 5.6s; animation-delay: -2.4s; }
  @keyframes tr-run { 0% { top: 4px; opacity: 0; } 10% { opacity: 1; } 80% { opacity: 1; } 100% { top: calc(100% - 8px); opacity: 0; } }
  .tr-label { font: 400 25px/1.1 var(--f-display); color: var(--ink); }
  .tr-lane--1 .tr-label { color: color-mix(in srgb, var(--about) 75%, var(--ink)); }
  .tr-items { margin-top: 14px; display: grid; gap: 9px; font: 400 var(--t-body)/1.45 var(--f-ui); color: var(--ink-2); }
  .tr-items li { position: relative; }
  .tr-items li::before { content: ""; position: absolute; left: -26.5px; top: 0.62em; width: 4px; height: 4px; border-radius: 50%; background: color-mix(in srgb, var(--lc) 70%, transparent); }
  .tr-gives { margin-top: 18px; display: grid; gap: 4px; font: italic 400 19px/1.35 var(--f-read); color: var(--ink); }
  .tr-gives .meta { font-style: normal; }
  /* where they meet: a U from one track to the other, and one node under its middle */
  .tr-meet { margin-left: 3.5px; width: calc(50% + var(--tg) / 2); height: 34px; border: 1px solid var(--rule-2); border-top: 0; border-radius: 0 0 26px 26px; }
  .tr-end { position: relative; margin-top: 18px; padding-left: calc((50% + var(--tg) / 2) / 2 - 3px); display: flex; align-items: center; gap: 14px; font: 400 25px/1.2 var(--f-display); color: var(--ink); }
  .tr-end::before { content: ""; position: absolute; left: calc((50% + var(--tg) / 2) / 2 + 4px); top: -18px; height: 14px; width: 1px; background: var(--rule-2); }
  .tr-node { width: 14px; height: 14px; border-radius: 50%; margin-left: 0; background: radial-gradient(circle, var(--about) 0 3px, transparent 4px), color-mix(in srgb, var(--about) 16%, transparent); box-shadow: 0 0 18px color-mix(in srgb, var(--about) 45%, transparent); flex: none; }

  /* one pull quote, set large across the reading column */
  .ab-quote { grid-column: 2 / 4; margin: 64px 0 0; max-width: 760px; position: relative; padding-left: 28px; }
  .ab-quote::before { content: ""; position: absolute; left: 0; top: 0.3em; bottom: 0.3em; width: 2px; border-radius: 1px; background: linear-gradient(var(--about), color-mix(in srgb, var(--about) 0%, transparent)); }
  .ab-quote p { font: italic 400 clamp(28px, 2.6vw, 38px)/1.24 var(--f-display); letter-spacing: -0.012em; color: var(--ink); text-wrap: balance; }

  /* the year as a line: what happened, a lit now, a dashed next */
  .tl { grid-column: 2 / 4; margin-top: 44px; display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0 20px; max-width: calc(var(--text) + 200px); }
  .tl-step { position: relative; display: grid; align-content: start; gap: 6px; padding-top: 30px; }
  .tl-step::before { content: ""; position: absolute; left: 0; right: -20px; top: 5px; height: 1px; background: var(--rule-2); }
  .tl-step:last-child::before { right: 0; }
  .tl-step.is-now::before { background: linear-gradient(90deg, var(--about), var(--rule-2) 60%); }
  .tl-step.is-next::before { background: repeating-linear-gradient(90deg, var(--ink-4) 0 5px, transparent 5px 11px); }
  .tl-dot { position: absolute; left: 0; top: 1px; width: 9px; height: 9px; border-radius: 50%; background: var(--ink-3); }
  .is-now .tl-dot { background: var(--about); box-shadow: 0 0 12px color-mix(in srgb, var(--about) 70%, transparent); }
  .is-now .tl-dot::after { content: ""; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--about); opacity: 0; animation: now-ring 2.8s var(--ease-out) infinite; }
  .is-next .tl-dot { background: var(--ground); border: 1px dashed var(--ink-3); }
  .tl-when { font: 400 var(--t-meta)/1.3 var(--f-ui); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .is-now .tl-when { color: var(--about); }
  .tl-what { font: 400 17px/1.35 var(--f-display); color: var(--ink); text-wrap: pretty; }
  .is-next .tl-what { color: var(--ink-2); font-style: italic; }

  /* lists inside the reading column: a product or a profile per row */
  .ab-list { margin-top: 1.2em; border-top: 1px solid var(--rule); }
  .ab-list li { border-bottom: 1px solid var(--rule); }
  .ab-list a {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: 4px 18px;
    padding: 16px 2px 15px; min-height: 44px; text-decoration: none; color: var(--ink);
  }
  .ab-list a > :global(.icon:last-child) { align-self: center; color: var(--ink-3); transition: color var(--d-1), translate var(--d-2) var(--ease-out); }
  .ab-list a:hover > :global(.icon:last-child) { color: var(--ink); translate: 2px 0; }
  .ab-list :global(.ab-wm) { font-size: 22px; line-height: 1.1; min-width: 7.4em; }
  .ab-name { font: 400 22px/1.1 var(--f-display); }
  .ab-list a > :global(.icon:first-child) { align-self: center; color: var(--ink-2); }
  .ab-list a:has(> :global(.icon:first-child)) { grid-template-columns: auto auto minmax(0, 1fr) auto; }
  .ab-note { font: 400 var(--t-ui)/var(--lh-ui) var(--f-ui); color: var(--ink-2); }
  .ab-list a:hover .ab-note { color: var(--ink); }
  /* products: each in its own colour, a small light before its wordmark that wakes on hover */
  .ab-products a { grid-template-columns: 10px auto minmax(0, 1fr) auto; padding: 20px 2px 19px; }
  .ab-products a::before { content: ""; position: absolute; inset: 0 -14px; border-radius: 10px; background: radial-gradient(60% 140% at 0% 50%, color-mix(in srgb, var(--pa) 12%, transparent), transparent); opacity: 0; transition: opacity var(--d-3) var(--ease-out); pointer-events: none; }
  .ab-products a:hover::before { opacity: 1; }
  .pa-dot { align-self: center; width: 7px; height: 7px; border-radius: 50%; background: var(--pa); box-shadow: 0 0 10px color-mix(in srgb, var(--pa) 60%, transparent); }
  .ab-products .ab-note { grid-column: 3; }
  .ab-status { grid-column: 2 / 4; grid-row: 2; font: 400 var(--t-meta)/1.3 var(--f-ui); color: color-mix(in srgb, var(--pa) 60%, var(--ink-3)); }
  .ab-products a > :global(.icon:last-child) { grid-column: 4; grid-row: 1 / span 2; }

  /* the colophon: quiet, at the end (the Record links here: "How this is written") */
  .ab-colophon { margin-top: 128px; padding-top: 28px; border-top: 1px solid var(--rule); }
  .ab-colophon h2 { grid-column: 1; padding-top: 4px; }
  .ab-colophon .ch-body { font: 400 var(--t-body)/var(--lh-body) var(--f-ui); color: var(--ink-2); max-width: 36em; }

  @media (prefers-reduced-motion: reduce) {
    .ab-dot, .now-dot::after, .is-now .tl-dot::after, .tr-lane::after { animation: none; }
    .tr-lane::after { top: 4px; opacity: 1; }
  }

  @media (max-width: 1240px) {
    .about { --head: 0px; --side: 300px; --gap: 48px; }
    .ab-open, .ch, .ab-colophon { grid-template-columns: minmax(0, var(--text)) var(--side); }
    .ab-intro { grid-column: 1; }
    .ch-head { grid-column: 1; grid-row: 1; margin-bottom: 22px; }
    .ch-body { grid-column: 1; grid-row: 2; }
    .ch-side { grid-column: 2; grid-row: 1 / span 5; }
    .ch-wide, .tracks, .ab-quote, .tl { grid-column: 1 / 3; }
    .ab-colophon h2 { grid-row: 1; margin-bottom: 14px; }
    .ab-colophon .ch-body { grid-row: 2; }
  }
  @media (max-width: 899.98px) {
    .ab-open, .ch, .ab-colophon { display: block; }
    .ab-open { min-height: 0; padding-bottom: 8px; display: flex; flex-direction: column; }
    /* phones: the card first, in the first screen, then the words */
    .about-badge { position: relative; inset: auto; order: -1; align-self: stretch; margin: 0 calc(-1 * var(--gut)); padding: 64px var(--gut) 4px; overflow: hidden; }
    .about-badge > :global(.idc) { --w: min(62vw, 252px); --strap: 64px; }
    .ab-intro { padding: 12px 0 0; }
    .ab-title { font-size: clamp(46px, 14vw, 60px); }
    .ab-intro .lede { margin-top: 18px; font-size: 20px; }
    .ab-now { margin-top: 26px; }
    .ch, .ch--band { margin-top: 80px; }
    .ch-head { margin-bottom: 18px; }
