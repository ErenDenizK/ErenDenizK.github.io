---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Foot from '../components/Foot.astro';
import IdCard from '../components/IdCard.astro';
import { getSite, isPlaceholder } from '../lib/site';
import c750a from '../assets/photos/courtyard-750.avif?url';
import c1000a from '../assets/photos/courtyard-1000.avif?url';
import c1350a from '../assets/photos/courtyard-1350.avif?url';
import c750w from '../assets/photos/courtyard-750.webp?url';
import c1000w from '../assets/photos/courtyard-1000.webp?url';
import c1350w from '../assets/photos/courtyard-1350.webp?url';
const site = await getSite();
const a = site.about;
const li = site.links.linkedin;
---
<Base title="About" tab="about" og="about" ogAlt={`${site.name} at the YTÜ gate.`} type="profile" pageClass="page-about">
  <div class="about-hero">
    <figure class="courtyard">
      <picture>
        <source type="image/avif" srcset={`${c750a} 750w, ${c1000a} 1000w, ${c1350a} 1350w`} sizes="(min-width: 900px) 60vw, 100vw" />
        <img src={c1000w} srcset={`${c750w} 750w, ${c1000w} 1000w, ${c1350w} 1350w`} sizes="(min-width: 900px) 60vw, 100vw" alt={a.courtyard.alt} width="1000" height="1481" decoding="async" fetchpriority="high" data-budget="photo" />
      </picture>
      <figcaption class="meta">{a.courtyard.caption}</figcaption>
    </figure>
    <div class="inner">
      <div class="about-text">
        <p class="meta">{a.kicker}</p>
        <h1 class="vtitle" id="h-about">{a.title}</h1>
        {a.ledes.map((l) => <p class="lede">{l}</p>)}
        <div class="links">
          <a class="btn" href={site.links.github} rel="me">GitHub <Icon name="arrow-up-right" weight="medium" /></a>
          {!isPlaceholder(li) && <a class="qlink" href={li} rel="me">LinkedIn <Icon name="arrow-up-right" /></a>}
        </div>
      </div>
    </div>
    <div class="about-badge"><IdCard /></div>
  </div>

  <div class="about-wrap"><div class="inner">
    <div class="about-body">
      <dl class="facts">
        {a.facts.map(([k, v]) => <><dt class="meta">{k}</dt><dd>{v}</dd></>)}
        <dt class="meta">Elsewhere</dt>
        <dd><a href={site.links.github} rel="me">GitHub</a>{!isPlaceholder(li) && <> · <a href={li} rel="me">LinkedIn</a></>}</dd>
      </dl>
    </div>

    <section class="tracks" aria-labelledby="h-tracks">
      <div class="sec-head"><h2 id="h-tracks">{a.tracks.title}</h2></div>
      <div class="track-grid">
        {a.tracks.items.map((t) => (
          <div class="track">
            <span class="meta">{t.label}</span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <ul>{t.list.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="both lede">{a.tracks.both}</p>
    </section>

    <section class="colophon" id="colophon" aria-labelledby="h-colo">
      <div>
        <div class="sec-head"><h2 id="h-colo">How this site is made</h2></div>
        <div class="prose">{a.colophon.map(([b, t]) => <p><b>{b}</b> {t}</p>)}</div>
      </div>
      <div class="now-box">
        <div class="sec-head"><h2>Now</h2><span class="meta">{a.now.label}</span></div>
        <p>{a.now.text}</p>
      </div>
    </section>
    <Foot />
  </div></div>
</Base>

<style>
  /* The ID card hangs over the courtyard (brief §7: the courtyard carries About; the card is composed
     with it, ADR-0008). Wide screens: in the photo's half, clear of the text column, its lanyard running
     up under the bar. Phones: below the introduction, in the page's flow. */
  .about-badge { position: relative; z-index: 1; }
  @media (min-width: 900px) {
    .about-badge {
      position: absolute; top: 0; bottom: 0; right: 0; left: max(40%, calc(var(--gut) + 34rem + 40px));
      display: flex; justify-content: center; align-items: flex-start; padding-top: clamp(64px, 11svh, 120px);
      pointer-events: none;
    }
    .about-badge > :global(.idc) {
      pointer-events: auto;
      --w: clamp(236px, min(22vw, calc((100svh - 300px) * 0.56)), 318px);
      --strap: calc(var(--bar-h) + clamp(64px, 11svh, 120px) + 56px);
    }
  }
  @media (max-width: 899.98px) {
    .about-badge { display: flex; justify-content: center; padding: 104px var(--gut) 8px; overflow: hidden; }
    .about-badge > :global(.idc) { --w: min(74vw, 300px); --strap: 104px; }
  }
</style>
