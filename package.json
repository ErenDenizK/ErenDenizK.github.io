{
  "name": "erendenizk-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:test": "BASE_PATH=/Portfolio/ astro build && BASE_PATH=/Portfolio/ OUT_DIR=./dist-fixtures LOG_DIR=./tests/fixtures/log astro build",
    "test": "playwright test",
    "test:nav": "playwright test nav",
    "budget": "node tests/budget.mjs dist",
    "fonts": "python3 tools/fonts/subset.py",
    "photos": "node tools/photos/grade.mjs && node tools/photos/postcards.mjs",
    "worlds": "node tests/worlds.mjs",
    "clip": "node tools/captures/clip.mjs",
    "verify": "npm run worlds && npm run check && npm run build:test && npm run budget -- dist && npm test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.0",
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3"
  }
}
