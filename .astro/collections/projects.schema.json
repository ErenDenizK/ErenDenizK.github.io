{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "group": {
      "default": "directed",
      "type": "string",
      "enum": [
        "directed",
        "by-hand"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Live",
        "Public beta",
        "In development",
        "Paused",
        "Archived"
      ]
    },
    "statusNote": {
      "type": "string"
    },
    "teaserMeta": {
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "placeholder": {
              "type": "string"
            }
          },
          "required": [
            "placeholder"
          ]
        }
      ]
    },
    "role": {
      "type": "string"
    },
    "started": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        {
          "type": "object",
          "properties": {
            "placeholder": {
              "type": "string"
            }
          },
          "required": [
            "placeholder"
          ]
        }
      ]
    },
    "runsOn": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "accent": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "glow": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "p2": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "p3": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "required": [
        "color"
      ]
    },
    "object": {
      "type": "string"
    },
    "og": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "summaryPlaceholder": {
      "type": "string"
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "live",
              "code",
              "other"
            ]
          }
        },
        "required": [
          "label",
          "href",
          "kind"
        ]
      }
    },
    "linksNote": {
      "type": "string"
    },
    "what": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "why": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "how": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "learned": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "next": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "order",
    "status",
    "role",
    "started",
    "runsOn",
    "accent",
    "object",
    "summary",
    "what",
    "why",
    "how",
    "learned",
    "next"
  ]
}