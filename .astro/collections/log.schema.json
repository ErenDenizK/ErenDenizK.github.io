{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "note",
        "entry",
        "essay"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "dek": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "note"
        ]
      }
    },
    "corrections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "was": {
            "type": "string"
          },
          "now": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "was",
          "now"
        ]
      }
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*$"
    },
    "projects": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "figures": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lead": {
      "type": "string"
    },
    "help": {
      "default": "edit",
      "type": "string",
      "enum": [
        "edit",
        "more"
      ]
    },
    "helpNote": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "date",
    "category"
  ]
}